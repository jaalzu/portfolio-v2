---
interface Props {
  name: string;
  role: string;
  coverSrc: string;
  avatarSrc: string;
}

const { name, role, coverSrc, avatarSrc } = Astro.props;
---

<div class="banner">
  <div class="banner__cover">
    <img src={coverSrc} alt="" />
  </div>
  <div class="banner__identity">
    <img class="banner__avatar" src={avatarSrc} alt={`Foto de ${name}`} />
    <div class="banner__text">
      <p class="banner__name">{name}</p>
      <p class="banner__role">{role}</p>
    </div>
  </div>
</div>

<style>
  .banner {
    position: relative;
  }

  .banner__cover {
    height: 110px;
    border-radius: var(--radius-base) var(--radius-base) 0 0;
    overflow: hidden;
    background-color: var(--color-secondary-soft);
  }

  .banner__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .banner__identity {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: 0 var(--space-4);
    margin-top: -34px;
  }

  .banner__avatar {
    width: 76px;
    height: 76px;
    border-radius: var(--radius-full);
    border: 3px solid var(--color-bg);
    object-fit: cover;
    background-color: var(--color-surface);
  }

  .banner__text {
    padding-top: var(--space-6);
  }

  .banner__name {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-tight);
  }

  .banner__role {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--font-weight-light);
    color: var(--color-text-muted);
  }
</style>
