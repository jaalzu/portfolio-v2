---
interface Props {
  name: string;
  role: string;
  coverSrc: string;
  avatarSrc: string;
}

const { name, role, coverSrc, avatarSrc } = Astro.props;
---

<div class="banner">
  <div class="banner__cover">
    <img src={coverSrc} alt="" />
  </div>
  <div class="banner__identity">
    <img class="banner__avatar" src={avatarSrc} alt={`Foto de ${name}`} />
    <div class="banner__text">
      <p class="banner__name">{name}</p>
      <p class="banner__role">{role}</p>
    </div>
  </div>
</div>

<style>
  .banner {
    position: relative;
  }

  .banner__cover {
    height: 82px;
    border-radius: 1px;
    overflow: hidden;
  }

  .banner__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover ;
    object-position: center 59.5%;
  }

  .banner__identity {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: -25px;
  }

  .banner__avatar {
    width: 89px;
    height: 89px;
    border-radius: var(--radius-full);
    border: 2px solid var(--color-bg);
    object-fit: cover;
  }

  .banner__text {
    padding-top: var(--space-6);
  }

  .banner__name {
    margin: 0;
    font-size: var(--text-md);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-tight);
  }

.banner__role {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--font-weight-light);
    color: var(--color-text-muted);
    line-height: var(--leading-tight);
}
</style>
