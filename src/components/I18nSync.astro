<script>
  import { translations } from "../data/translations";
  import { resolveLang, applyLangToRoot } from "../lib/lang";

  function getPath(obj: unknown, path: string): unknown {
    return path.split(".").reduce<unknown>((acc, key) => {
      if (acc == null || typeof acc !== "object") return undefined;
      return (acc as Record<string, unknown>)[key];
    }, obj);
  }

  function applyLang(lang: "es" | "en") {
    const t = translations[lang] ?? translations.es;

    document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
      const key = el.getAttribute("data-i18n");
      if (!key) return;
      const value = getPath(t, key);
      if (typeof value === "string") el.textContent = value;
    });

    document.querySelectorAll<HTMLElement>("[data-i18n-html]").forEach((el) => {
      const key = el.getAttribute("data-i18n-html");
      if (!key) return;
      const value = getPath(t, key);
      if (typeof value === "string") el.innerHTML = value;
    });

    document.querySelectorAll<HTMLElement>("[data-i18n-attr]").forEach((el) => {
      const raw = el.getAttribute("data-i18n-attr");
      if (!raw) return;
      // Soporta múltiples pares "attr:key" separados por ";"
      // ej: "aria-label:aria.cv;href:cvHref"
      raw.split(";").forEach((pair) => {
        const [attrName, key] = pair.split(":").map((s) => s.trim());
        if (!attrName || !key) return;
        const value = getPath(t, key);
        if (typeof value === "string") el.setAttribute(attrName, value);
      });
    });
  }

  function syncFromStorage() {
    // Manual choice (localStorage) wins; otherwise follow browser.
    // Never persists detection — only the toggle button writes.
    const current = resolveLang();
    applyLangToRoot(current);
    applyLang(current);
  }

  // HTML renders in Spanish by default; the head inline script in
  // BaseLayout already set data-lang before paint when possible.
  syncFromStorage();

  document.addEventListener("langchange", (event) => {
    const lang = (event as CustomEvent<{ lang: "es" | "en" }>).detail.lang;
    applyLang(lang);
  });

  // Re-aplicar tras navegación con ClientRouter (view transitions)
  document.addEventListener("astro:page-load", syncFromStorage);
  document.addEventListener("astro:after-swap", syncFromStorage);
</script>
