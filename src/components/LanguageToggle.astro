---

<button
  id="lang-toggle"
  class="lang-toggle"
  type="button"
  aria-label="Switch language / Cambiar idioma"
>
  <span class="lang-toggle__option" data-lang-option="es">ESP</span>
  <span class="lang-toggle__sep">/</span>
  <span class="lang-toggle__option" data-lang-option="en">ENG</span>
</button>

<style>
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 32px;
    padding: 0 4px;
    border: none;
    background: transparent;
    cursor: pointer;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
  }

  .lang-toggle__sep {
    color: var(--color-text-muted);
    opacity: 0.6;
    transition: opacity var(--transition-fast);
  }

  .lang-toggle:hover .lang-toggle__sep {
    opacity: 1;
  }

  .lang-toggle__option {
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  /* Idioma activo resaltado */
  :global(html:not([data-lang="en"])) .lang-toggle__option[data-lang-option="es"],
  :global(html[data-lang="en"]) .lang-toggle__option[data-lang-option="en"] {
    color: var(--color-primary);
  }


</style>

<script>
  const toggle = document.getElementById("lang-toggle");
  const root = document.documentElement;

  toggle?.addEventListener("click", () => {
    const current = root.getAttribute("data-lang") ?? "es";
    const next = current === "es" ? "en" : "es";
    root.setAttribute("data-lang", next);
    localStorage.setItem("lang", next);
    document.dispatchEvent(new CustomEvent("langchange", { detail: { lang: next } }));
  });
</script>