---

<button
  id="lang-toggle"
  class="lang-toggle"
  type="button"
  aria-label="Switch language / Cambiar idioma"
>
  <svg
    class="lang-toggle__icon"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 256 256"
    aria-hidden="true"
  >
    <rect width="256" height="256" fill="none" stroke="none" />
    <polyline points="240 216 184 104 128 216" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16" />
    <line x1="144" y1="184" x2="224" y2="184" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16" />
    <line x1="96" y1="32" x2="96" y2="56" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16" />
    <line x1="32" y1="56" x2="160" y2="56" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16" />
    <path d="M128,56a96,96,0,0,1-96,96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16" />
    <path d="M69.47,88A96,96,0,0,0,160,152" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16" />
  </svg>
  <span class="lang-toggle__label" id="lang-toggle-label">EN</span>
</button>

<style>
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 32px;
    padding: 0 6px;
    border: none;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .lang-toggle:hover {
    color: var(--color-primary);
  }

  .lang-toggle__icon {
    width: 20px;
    height: 20px;
  }

  .lang-toggle__label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
  }
</style>

<script>
  const toggle = document.getElementById("lang-toggle");
  const label = document.getElementById("lang-toggle-label");
  const root = document.documentElement;

  function syncLabel() {
    const current = root.getAttribute("data-lang") ?? "es";
    // Muestra el idioma AL QUE se puede cambiar, no el actual
    if (label) label.textContent = current === "es" ? "EN" : "ES";
  }

  syncLabel();

  toggle?.addEventListener("click", () => {
    const current = root.getAttribute("data-lang") ?? "es";
    const next = current === "es" ? "en" : "es";
    root.setAttribute("data-lang", next);
    localStorage.setItem("lang", next);
    syncLabel();
  });
</script>