---
import Icon from "./Icon.astro";

interface Props {
  title?: string;
  marked?: boolean;
  class?: string;
  i18nKey?: string;
}

const { title, marked = false, class: className = "", i18nKey } = Astro.props;
---

<section class:list={["section", className]}>
  {
    title && (
     
      <h2 class="section__title">
        <span data-i18n={i18nKey}>{title}</span>
        {marked && <Icon name="dot" size={9} class="section__mark" />}
      </h2>
    )
  }
  <div class="section__content">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-12);
  }

  .section:first-child {
    padding-top: var(--space-4);
  }

  .section__content {
    display: flow-root;
  }

  .section__title {
    margin: 0 0 var(--space-8);
    font-size: var(--text-md);
    font-weight: var(--font-weight-medium);
    display: inline-flex;
    color: var(--color-surface);
    align-items: center;
  }

  :global(.section__mark) {
    align-self: flex-start;
    margin-left: 4px;
    color: var(--color-primary);
  }
</style>