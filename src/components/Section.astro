---
import Icon from "./Icon.astro";

interface Props {
  title?: string;
  marked?: boolean;
  class?: string;
}

const { title, marked = false, class: className = "" } = Astro.props;
---

<section class:list={["section", className]}>
  {
    title && (
      <h2 class="section__title">
        {title}
        {marked && <Icon name="dot" size={9} class="section__mark" />}
      </h2>
    )
  }
  <div class="section__content">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-12);
  }

  .section:first-child {
    padding-top: var(--space-6);
  }

  .section__content {
    display: flow-root;
  }

  .section__title {
    margin-bottom: 2rem;
    font-size: var(--text-md);
    font-weight: var(--font-weight-semibold);
    display: inline-flex;
    align-items: center;
  }

  :global(.section__mark) {
    align-self: flex-start;
    color: var(--color-primary);
  }
</style>