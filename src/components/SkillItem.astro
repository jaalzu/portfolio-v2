---
interface Props {
  iconSrc: string;
  title: string;
  subtitle: string;
  href?: string;
  variant?: "default" | "arrows";
}

const { iconSrc, title, subtitle, href = "/skills", variant = "default" } = Astro.props;
---

<div class="skill-frame">
  <a href={href} class:list={["skill", variant === "arrows" && "skill--arrows"]}>
    <img class="skill__icon" src={iconSrc} alt="" width="40" height="40" loading="lazy" />
    <div class="skill__text">
      <p class="skill__title">{title}</p>
      <p class="skill__subtitle">{subtitle}</p>
    </div>
    {variant === "arrows" ? (
      <span class="skill__arrows" aria-hidden="true">
        <img src="/skills/arrow.svg" alt="" width="16" height="16" class="skill__arrow" />
      </span>
    ) : (
      <span class="skill__arrow-wrap" aria-hidden="true">
        <img src="/skills/arrow.svg" alt="" width="16" height="16" class="skill__arrow" />
      </span>
    )}
  </a>
</div>

<style>
  .skill-frame {
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-base);
    padding: var(--card-inset);
    transition: border-color var(--transition-base);
  }

  .skill-frame:has(.skill:hover) {
    border-color: transparent;
  }

  .skill {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-inline: var(--space-1);
    padding-block: var(--space-6);
    border: 1px solid color-mix(in oklch, var(--color-border-soft) 100%, transparent);
    border-radius: var(--radius-inner);
    text-decoration: none;
    background: transparent;
    transition: border-color var(--transition-base), opacity var(--transition-base), transform var(--transition-base);
  }

  .skill:hover,
  .skill:focus-visible {
    border-color: transparent;
  }

  .skill__icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    object-fit: contain;
    filter: invert(1) brightness(0.95);
    opacity: 0.75;
  }

  .skill__text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 1;
    min-width: 0;
  }

  .skill__title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-tight);
    color: var(--color-surface);
  }

  .skill__subtitle {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  .skill__arrow-wrap {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 420ms cubic-bezier(0.22, 1, 0.36, 1), transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .skill__arrow {
    width: 17px;
    height: 17px;
    filter: invert(1) brightness(1);
  }

  .skill:hover .skill__arrow-wrap,
  .skill:focus-visible .skill__arrow-wrap {
    opacity: 1;
    transform: translateX(0);
  }

  .skill--arrows {
    border-color: transparent;
  }

  .skill--arrows:hover,
  .skill--arrows:focus-visible {
    border-color: transparent;
  }

</style>
