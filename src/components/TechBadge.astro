---
interface Props {
  name: string;
  icon?: string;
}

const { name, icon } = Astro.props;
const slug = icon ?? name.toLowerCase().replace(/\./g, "").replace(/\s+/g, "-");
---

<div class="tech" data-tooltip={name} tabindex="0">
  <img class="tech__icon" src={`/stack/${slug}.svg`} alt={name} loading="lazy" />
</div>

<style>
  .tech {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;

    gap: var(--space-2);
    --tooltip-gap: 12px;
  }

  .tech__icon {
    width: 36px;
    height: 36px;
  }
</style>