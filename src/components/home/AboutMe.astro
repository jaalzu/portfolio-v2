---
import Gallery from "./Gallery/Gallery.astro";
import { provinceImages } from "../../data/chaco";

export interface Props {
  texts: readonly string[];
  province?: { name: string; alt: string; captions?: readonly string[] };
}
const { texts, province } = Astro.props;
---

<div class="about">
  <p class="about__text">
    <span class="about__line" data-i18n="about.0">{texts[0]}</span>{province && (
      <Gallery
        label={province.name}
        images={[...provinceImages]}
        altBase={province.alt}
        captions={province.captions ? [...province.captions] : undefined}
      />
    )}.{" "}
    <span class="about__line" data-i18n="about.1">{texts[1]}</span>{texts[2] && (
      <><span class="about__line" data-i18n="about.2"> {texts[2]}</span></>
    )}{texts[3] && (
      <><span class="about__line" data-i18n="about.3"> {texts[3]}</span><a class="about__link" href="/ascii-gallery">ASCII art</a>.</>
    )}
  </p>
</div>

<style>

  
  .about__line{
    color: var(--color-text);
}
</style>