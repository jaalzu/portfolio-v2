---
import Gallery from "./Gallery/Gallery.astro";
import { provinceImages } from "../../data/chaco";

const copy = {
  es: {
    lead: "Nací y crecí en ",
    line: "Amo la música, los días grises y los viajes largos.",
    body: "Suelo tomar acción rápido sobre las ideas que se me pasan por la cabeza. Disfruto crear una interfaz nueva, hacerla más rápida, probar diferentes animaciones o pulir esos detalles que casi nadie nota pero todos sienten.",
    outro:
      'Hay tantas cosas por aprender, explorar y construir en la web, y eso es lo que la hace <span style="white-space:nowrap">tan <span class="enfasis-text enfasis-text--lg">emocionante</span>.</span>',
  },
  en: {
    lead: "Born and raised in ",
    line: " I love music, gray days and long trips.",
    body: "I tend to act quickly on the ideas that pop into my head. I enjoy creating a new interface, making it faster, trying out different animations, or polishing those details that almost nobody notices but everyone feels.",
    outro:
      'There are so many things to learn, explore and build on the web, and that\'s what makes it <span style="white-space:nowrap">so <span class="enfasis-text enfasis-text--lg">exciting</span>.</span>',
  },
} as const;
---

<div class="about">
  <p class="about__text about__text--lead">
    <span class="about__line lang-es">{copy.es.lead}</span>
    <span class="about__line lang-en">{copy.en.lead}</span>
    <Gallery images={[...provinceImages]} />.{" "}
    <span class="about__line lang-es">{copy.es.line}</span>
    <span class="about__line lang-en">{copy.en.line}</span>
  </p>
  <p class="about__text about__text--body">
    <span class="lang-es" set:html={copy.es.body} />
    <span class="lang-en" set:html={copy.en.body} />
  </p>
  <p class="about__text about__text--outro">
    <span class="lang-es" set:html={copy.es.outro} />
    <span class="lang-en" set:html={copy.en.outro} />
  </p>
</div>

<style>
  .about__line {
    color: inherit;
  }

  .about__text {
    max-inline-size: 60ch;
    color: var(--color-text);
  }

  .about__text--lead {
    color: var(--color-text);
    font-weight: 500;
  }

  .about__text--body {
    margin-top: var(--space-4);
    font-weight: 400;
    opacity: 0.9;
  }

  .about__text--outro {
    font-weight: 300;
    opacity: 0.7;
    margin-top: var(--space-4);
  }

  .about__text--extra {
    margin-top: var(--space-4);

    color: var(--color-text);
  }

  .about__link {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, currentColor 35%, transparent);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition-fast);
  }
  .about__link:hover,
  .about__link:focus-visible {
    text-decoration-color: currentColor;
  }
</style>
