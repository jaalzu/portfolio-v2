---
import Gallery from "./Gallery.astro";
import { provinceImages } from "../../data/chaco";

export interface Props {
  texts: readonly string[];
  province?: { name: string; alt: string };
}
const { texts, province } = Astro.props;
---

<div class="about">
  <p class="about__text">
    <span class="about__line" data-i18n="about.0">{texts[0]}</span>{province && (
      <Gallery
        label={province.name}
        images={[...provinceImages]}
        altBase={province.alt}
        captions={[
    "what a tasteful mate!",
    "really representative art",
    "it's not japan, it's chaco!"
  ]}
      />
    )}.{" "}
    <span class="about__line" data-i18n="about.1">{texts[1]}</span>{" "}
    <span class="about__line" data-i18n="about.2">{texts[2]}</span>{" "}
    <span class="about__line" data-i18n="about.3">{texts[3]}</span>
    <a class="about__link" href="/ascii-gallery">ASCII art</a>.
  </p>
</div>