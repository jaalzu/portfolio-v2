      =::@:                           #: #
      +@                             :+ =+
                                     #: #`;

const asciiHtml = ascii
  .split("\n")
  .map((row) => {
    let out = "";
    for (const ch of row) {
      out += ch === " " ? " " : `<span class="px">${ch}</span>`;
    }
    return out;
  })
  .join("\n");

const groundLine = `::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::`;
---

<footer class="site-footer">
  <div class="site-footer__ascii" aria-hidden="true">
    <pre class="site-footer__art" set:html={asciiHtml}></pre>
  </div>
  <div class="site-footer__ground" aria-hidden="true">
    {groundLine.repeat(8)}
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    max-width: 100vw;
    margin-top: var(--space-4);
    padding-bottom: var(--space-2);
    overflow: visible;
  }

  .site-footer__ascii {
    width: 100vw;
    max-width: 100vw;
    overflow: hidden;
    display: flex;
    justify-content: flex-start;
  }

  .site-footer__art {
    margin: 0;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(1.4px, 0.28vw, 3px);
    line-height: 1;
    color: var(--color-primary);
    white-space: pre;
    text-align: left;
    max-width: none;
    width: 100vw;
    padding-left: 20vw;
    overflow: hidden;
  }

  .site-footer__ground {
    display: block;
    width: 104vw;
    max-width: 104vw;
    margin-left: -2vw;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(1.4px, 0.28vw, 4px);
    line-height: 1;
    color: #fff;
    opacity: 1;
    white-space: nowrap;
    overflow: visible;
    text-align: left;
    letter-spacing: 0;
    margin-top: -1px;
    padding: 0;
  }

  @media (max-width: 768px) {
    .site-footer {
      margin-top: var(--space-2);
    }
    .site-footer__art {
      font-size: clamp(1px, 0.58vw, 2.2px);
      padding-left: 60vw;
    }
    .site-footer__ground {
      font-size: clamp(1px, 0.52vw, 2.2px);
    }
  }
</style>
