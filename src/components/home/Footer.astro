---

<footer class="site-footer">
  <div class="site-footer__ascii" aria-hidden="true">
    <pre class="site-footer__art">{asciiBody}</pre>
  </div>
  <div class="site-footer__ground" aria-hidden="true">{groundLine.repeat(6)}</div>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    margin-top: -380px;
    overflow: visible;
    overflow-x: visible;
  }

  .site-footer__ascii {
    width: 100%;
    overflow: visible;
    display: flex;
    justify-content: flex-start;
  }

  .site-footer__art {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(2.2px, 0.58vw, 5px);
    line-height: 1;
    color: color-mix(in oklch, var(--color-primary) 85%, white 15%);
    opacity: 1;
    white-space: pre;
    text-align: left;
    max-width: none;
    overflow: visible;
    transform: translateX(10%);
  }

  .site-footer__ground {
    width: 100%;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 6px;
    line-height: 1;
    color: var(--color-surface);
    opacity: 1;
    white-space: nowrap;
    overflow: hidden;
    text-align: center;
    letter-spacing: 0;
    padding-bottom: var(--space-2);
    display: block;
  }

  @media (max-width: 768px) {
    .site-footer__ascii {
      justify-content: center;
      overflow: hidden;
    }
    .site-footer__art {
      font-size: clamp(2.2px, 1.1vw, 3.5px);
      transform: none;
      opacity: 0.55;
      max-width: 100%;
      overflow: hidden;
    }
    .site-footer__ground {
      font-size: clamp(2.2px, 1.1vw, 3.5px);
    }
    .site-footer {
      overflow: hidden;
    }
  }

  .site-footer__content { display: none; }
</style>
