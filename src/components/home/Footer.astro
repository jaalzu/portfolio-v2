       .@  .   .%:    -     -   *=      :*:=                                      :=*#=..-#
       :=     +:=    +     :  :@.       -+-=                                           .+%+:
       +    .# .:   =       :%-         *:-:                                               +.
       %   :=  =   :     .*#:           #.=.
