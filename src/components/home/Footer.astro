/**
 * Build-time transform: every non-space char becomes an addressable span.
 * Spaces stay as raw text (cheaper, and there's nothing to paint there).
 * data-i is a flat index used as the localStorage key so we don't need x/y math.
 */
const asciiRows = asciiBody.split("\n");
let flatIndex = 0;
const asciiHtml = asciiRows
	.map((row) => {
		let out = "";
		for (const ch of row) {
			if (ch === " ") {
				out += " ";
			} else {
				out += `<span class="px" data-i="${flatIndex}">${ch}</span>`;
			}
			flatIndex++;
		}
		return out;
	})
	.join("\n");
