<script>
  const STORAGE_KEY = "footer-ascii-paint-v1";
  const ROW_LENGTH_KEY = "footer-ascii-row-length-v1";

  const canvas = document.getElementById("asciiCanvas");
  const toggle = document.getElementById("paintToggle");
  const panel = document.getElementById("paintPanel");
  const swatches = document.querySelectorAll(".swatch[data-color]");
  const customColorInput = document.getElementById(
    "customColor"
  ) as HTMLInputElement;
  const sizeButtons = document.querySelectorAll<HTMLButtonElement>(
    ".size-btn"
  );
  const eraserBtn = document.getElementById("eraserBtn") as HTMLButtonElement;
  const clearBtn = document.getElementById("clearBtn") as HTMLButtonElement;

  if (!canvas) {
    // Nothing to paint on this render, bail quietly.
    throw new Error("ascii canvas missing");
  }

  // ---- figure out row length so brush size can expand in 2D ----
  const rows = canvas.textContent?.split("\n") ?? [];
  const rowLength = rows[0]?.length || 1;

  let paintMode = false;
  let currentColor = "#ff5c5c";
  let brushRadius = 0; // 0 = single char, 1 = 3x3, 2 = 5x5
  let eraseMode = false;
  let isPointerDown = false;

  // ---- persistence ----
  function loadPaint() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const data: Record<string, string> = JSON.parse(raw);
      for (const [i, color] of Object.entries(data)) {
        const el = canvas!.querySelector<HTMLElement>(`[data-i="${i}"]`);
        if (el) el.style.setProperty("--c", color);
      }
    } catch {
      // corrupted storage, ignore
    }
  }

  function savePaintFor(i: string, color: string | null) {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      const data: Record<string, string> = raw ? JSON.parse(raw) : {};
      if (color === null) {
        delete data[i];
      } else {
        data[i] = color;
      }
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    } catch {
      // storage full or blocked, fail silently
    }
  }

  function clearAllPaint() {
    localStorage.removeItem(STORAGE_KEY);
    canvas!.querySelectorAll<HTMLElement>(".px").forEach((el) => {
      el.style.removeProperty("--c");
    });
  }

  // ---- painting ----
  function paintIndex(index: number) {
    const el = canvas!.querySelector<HTMLElement>(`[data-i="${index}"]`);
    if (!el) return;
    if (eraseMode) {
      el.style.removeProperty("--c");
      savePaintFor(String(index), null);
    } else {
      el.style.setProperty("--c", currentColor);
      savePaintFor(String(index), currentColor);
    }
  }

  function paintAround(index: number) {
    if (brushRadius === 0) {
      paintIndex(index);
      return;
    }
    const row = Math.floor(index / rowLength);
    const col = index % rowLength;
    for (let dr = -brushRadius; dr <= brushRadius; dr++) {
      for (let dc = -brushRadius; dc <= brushRadius; dc++) {
        const r = row + dr;
        const c = col + dc;
        if (c < 0 || c >= rowLength) continue;
        const idx = r * rowLength + c;
        if (idx < 0) continue;
        paintIndex(idx);
      }
    }
  }

  function handlePixelEvent(e: Event) {
    if (!paintMode) return;
    const target = e.target as HTMLElement;
    if (!target.classList.contains("px")) return;
    const i = target.dataset.i;
    if (i === undefined) return;
    paintAround(Number(i));
  }

  canvas.addEventListener("pointerdown", (e) => {
    if (!paintMode) return;
    isPointerDown = true;
    handlePixelEvent(e);
  });
  canvas.addEventListener("pointerover", (e) => {
    if (!isPointerDown) return;
    handlePixelEvent(e);
  });
  window.addEventListener("pointerup", () => {
    isPointerDown = false;
  });

  // ---- toolbar UI ----
  toggle?.addEventListener("click", () => {
    paintMode = !paintMode;
    toggle.setAttribute("aria-pressed", String(paintMode));
    toggle.classList.toggle("is-active", paintMode);
    if (panel) panel.hidden = !paintMode;
    canvas!.classList.toggle("is-paintable", paintMode);
  });

  swatches.forEach((btn) => {
    btn.addEventListener("click", () => {
      const color = (btn as HTMLElement).dataset.color;
      if (!color) return;
      currentColor = color;
      eraseMode = false;
      eraserBtn?.setAttribute("aria-pressed", "false");
      swatches.forEach((s) => s.classList.remove("is-selected"));
      btn.classList.add("is-selected");
    });
  });

  customColorInput?.addEventListener("input", () => {
    currentColor = customColorInput.value;
    eraseMode = false;
    eraserBtn?.setAttribute("aria-pressed", "false");
    swatches.forEach((s) => s.classList.remove("is-selected"));
  });

  sizeButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      brushRadius = Number(btn.dataset.size ?? 0);
      sizeButtons.forEach((b) => b.setAttribute("aria-pressed", "false"));
      btn.setAttribute("aria-pressed", "true");
    });
  });

  eraserBtn?.addEventListener("click", () => {
    eraseMode = !eraseMode;
    eraserBtn.setAttribute("aria-pressed", String(eraseMode));
  });

  clearBtn?.addEventListener("click", () => {
    if (confirm("¿Borrar todo lo pintado?")) {
      clearAllPaint();
    }
  });

  // prevent page scroll/selection while dragging to paint on touch devices
  canvas.addEventListener(
    "touchmove",
    (e) => {
      if (paintMode) e.preventDefault();
    },
    { passive: false }
  );

  loadPaint();
</script>

