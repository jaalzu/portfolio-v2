---
// Gallery.astro – Galería con lightbox, navegación y animaciones Motion
import { Image } from "astro:assets";

export interface Props {
  label: string;
  images: ImageMetadata[];
  altBase: string;
  captions?: string[];
}

const { label, images, altBase, captions } = Astro.props;
---

<span class="province" tabindex="0">
  {label}

  <span
    class="province__gallery"
    role="group"
    aria-label={`Fotos de ${label}`}
  >
    {images.map((img, i) => {
      const caption = captions?.[i] ?? `${altBase} ${i + 1}`;

      return (
        <span class="province__polaroid" data-index={i}>
          <Image
            class="province__photo"
            src={img}
            alt={`${altBase} ${i + 1}`}
            width={480}
            height={480}
            quality={100}
            loading="lazy"
            decoding="async"
            data-caption={caption}
          />

          <span class="province__caption" aria-hidden="true">
            {caption}
          </span>
        </span>
      );
    })}
  </span>
</span>

<style>
  @font-face {
    font-family: "Newsreader";
    src: url("/fonts/newsreader-italic.woff2") format("woff2");
    font-weight: 200 800;
    font-style: italic;
    font-display: swap;
  }

  .province {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: color-mix(in oklch, currentColor 35%, transparent);
    cursor: pointer;
    transition: text-decoration-color var(--transition-fast);
  }

  .province:hover,
  .province:focus-visible {
    text-decoration-color: currentColor;
  }

  .province:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .province__gallery {
    position: absolute;
    bottom: 50%;
    left: 70%;
    transform: translateX(-70%);
    display: flex;
    padding: var(--space-2) var(--space-2) var(--space-8);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 120ms ease-in, visibility 0s 120ms;
  }

  /* ============================================================
     REVELACIÓN DESKTOP
     ============================================================ */

  @media (hover: hover) and (pointer: fine) {
    .province:hover .province__gallery,
    .province:focus-visible .province__gallery,
    .province:focus-within .province__gallery {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition: opacity 100ms ease-in, visibility 0s 0s;
    }

    .province:not(:hover):not(:focus-visible):not(:focus-within)
      .province__gallery {
      transition: opacity 60ms ease-out, visibility 0s 60ms;
    }
  }

  /* Estado abierto controlado por JS */
  .province--gallery-open .province__gallery {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
    transition: none !important;
  }

  .province--lightbox-open .province__gallery {
  opacity: 0 !important;
  visibility: hidden !important;
  pointer-events: none !important;
  transition: none !important;
}

  /* ============================================================
     POLAROID
     ============================================================ */

  .province__polaroid {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    background: var(--color-text-heading);
    padding: var(--space-2) var(--space-2) var(--space-2);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
    flex-shrink: 0;
    margin-left: calc(var(--space-6) * -1.5);
    transition: transform var(--transition-fast);
    cursor: pointer;
  }

  .province__polaroid:first-child {
    margin-left: 0;
  }

  .province__photo {
    display: block;
    width: 125px;
    height: 125px;
    object-fit: cover;
    border-radius: 4px;
  }

  .province__caption {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 22px;
    max-width: 104px;
    overflow: hidden;
    white-space: nowrap;
    font-family: "Newsreader", serif;
    font-style: italic;
    font-weight: 300;
    font-size: 9.5px;
    letter-spacing: -0.2px;
    color: #2a2a2a;
    opacity: var(--opacity-medium);
    user-select: none;
    pointer-events: none;
  }

  .province__polaroid[data-index="0"] {
    transform: rotate(-8deg);
    z-index: 1;
  }

  .province__polaroid[data-index="1"] {
    transform: translateY(calc(var(--space-1) * -1));
    z-index: 2;
  }

  .province__polaroid[data-index="2"] {
    transform: rotate(8deg);
    z-index: 1;
  }

  .province__polaroid[data-index="0"]:hover {
    transform: rotate(-8deg) scale(1.08);
    z-index: 3;
  }

  .province__polaroid[data-index="1"]:hover {
    transform: translateY(calc(var(--space-1) * -1)) scale(1.08);
    z-index: 3;
  }

  .province__polaroid[data-index="2"]:hover {
    transform: rotate(8deg) scale(1.08);
    z-index: 3;
  }

  /* ============================================================
     MOBILE
     ============================================================ */

  @media (hover: none) {
    .province__gallery {
      position: fixed;
      left: 2%;
      top: 10%;
      bottom: auto;
      transform: none;
      translate: var(--gallery-x, 0px) var(--gallery-y, 0px);
    }

    .province__polaroid {
      margin-left: calc(var(--space-6) * -1.1);
    }

    .province__photo {
      width: 91px;
      height: 91px;
    }

    .province__caption {
      height: 18px;
      max-width: 79px;
      font-size: 7px;
    }

  
  }
</style>


<script>
  import { safeAnimate, springs } from '../../lib/motion-tokens';

  const supportsHover = window.matchMedia(
    '(hover: hover) and (pointer: fine)'
  ).matches;


 

  // ============================================================
  // POSICIONAMIENTO DE LA GALERÍA
  // ============================================================

  function positionGallery(trigger) {
    const gallery = trigger.querySelector('.province__gallery');

    if (!gallery) return;

    const rect = trigger.getBoundingClientRect();
    const galleryRect = gallery.getBoundingClientRect();

    const sideMargin = 8;
    const gap = 56;

    let x = rect.left + rect.width / 2 - galleryRect.width / 2;

    x = Math.max(
      sideMargin,
      Math.min(
        x,
        window.innerWidth - galleryRect.width - sideMargin
      )
    );

    let y = rect.top - galleryRect.height - gap;

    const maxY = window.innerHeight - galleryRect.height - sideMargin;

    y = Math.max(
      sideMargin,
      Math.min(y, maxY)
    );

    gallery.style.setProperty('--gallery-x', `${x}px`);
    gallery.style.setProperty('--gallery-y', `${y}px`);
  }

  const provinces = document.querySelectorAll('.province');

  // ============================================================
  // DESKTOP
  // ============================================================

  if (supportsHover) {
    provinces.forEach((el) => {
      el.addEventListener('focus', () => {
        positionGallery(el);
      });

      el.addEventListener('mouseenter', () => {
        positionGallery(el);
      });
    });
  }

  // ============================================================
  // MOBILE
  // ============================================================

  else {
    provinces.forEach((el) => {
      el.addEventListener(
        'touchend',
        (e) => {
          if (el.classList.contains('province--gallery-open')) {
            return;
          }

          e.preventDefault();

          provinces.forEach((p) => {
            if (p !== el) {
              p.classList.remove('province--gallery-open');
            }
          });

          positionGallery(el);

          el.classList.add('province--gallery-open');
        },
        { passive: false }
      );
    });

    // Tocar afuera cierra la galería
    document.addEventListener('touchstart', (e) => {
      provinces.forEach((el) => {
        if (
          el.classList.contains('province--gallery-open') &&
          !el.contains(e.target)
        ) {
          el.classList.remove('province--gallery-open');
        }
      });
    });
  }

  // ============================================================
  // RESIZE
  // ============================================================

  window.addEventListener('resize', () => {
    provinces.forEach((el) => {
      if (
        el.matches(':hover, :focus-within') ||
        el.classList.contains('province--gallery-open')
      ) {
        positionGallery(el);
      }
    });
  });

  // ============================================================
  // LIGHTBOX
  // ============================================================

  document.querySelectorAll('.province__photo').forEach((img) => {
    img.addEventListener('click', (e) => {
      e.stopPropagation();

      const gallery = img.closest('.province__gallery');

      if (!gallery) return;

      const allPhotos = gallery.querySelectorAll('.province__photo');

      const photoSrcs = Array.from(allPhotos).map((el) =>
        el.getAttribute('src')
      );

      const photoCaptions = Array.from(allPhotos).map(
        (el) =>
          el.getAttribute('data-caption') ||
          el.getAttribute('alt') ||
          ''
      );

      const currentIndex = photoSrcs.indexOf(
        img.getAttribute('src')
      );

      if (currentIndex === -1) return;

     const province = img.closest('.province');

if (province) {
  if (!supportsHover) {
    province.classList.add('province--gallery-open');
  } else {
    province.classList.add('province--lightbox-open');
  }
}

      // ========================================================
      // OVERLAY
      // ========================================================

      const overlay = document.createElement('div');

      overlay.style.cssText = `
        position: fixed;
        inset: 0;
        height: 100vh;
        height: 100dvh;
        background: oklch(0 0 0 / 0.55);
        backdrop-filter: blur(3px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--space-6);
        z-index: 9999999;
        cursor: default;
      `;

      // ========================================================
      // CARD
      // ========================================================

      const card = document.createElement('div');

      card.style.cssText = `
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        background: #fff;
        padding: var(--space-3) var(--space-3) var(--space-6);
        border-radius: var(--radius-base);
        box-shadow: var(--shadow-md);
        max-width: min(85vw, 420px);
        width: 100%;
        transform: scale(0.96);
        opacity: 0;
      `;

      // ========================================================
      // BIG IMAGE
      // ========================================================

      const bigImg = document.createElement('img');

      bigImg.src = photoSrcs[currentIndex];
      bigImg.alt = img.alt || 'Imagen ampliada';

      bigImg.style.cssText = `
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: var(--radius-inner);
        display: block;
        cursor: default;
      `;

      card.appendChild(bigImg);

      // ========================================================
      // CAPTION
      // ========================================================

      const captionEl = document.createElement('div');

      captionEl.style.cssText = `
        margin-top: var(--space-4);
        font-family: "Newsreader", serif;
        font-style: italic;
        font-weight: 400;
        font-size: var(--text-lg);
        line-height: var(--leading-normal);
        color: #2a2a2a;
        text-align: center;
      `;

      captionEl.textContent = photoCaptions[currentIndex];

      card.appendChild(captionEl);

      // ========================================================
      // CLOSE BUTTON
      // ========================================================

      const closeBtn = document.createElement('button');

      closeBtn.type = 'button';
      closeBtn.innerHTML = '✕';
      closeBtn.setAttribute('aria-label', 'Cerrar');

      closeBtn.style.cssText = `
        position: absolute;
        top: -12px;
        right: -12px;
        background: var(--color-red);
        border: none;
        border-radius: var(--radius-full);
        width: 32px;
        height: 32px;
        font-size: 17px;
        color: var(--color-text-heading);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        z-index: 3;
      `;

      card.appendChild(closeBtn);

      // ========================================================
// ARROWS
// ========================================================

const createArrowButton = (direction) => {
  const button = document.createElement('button');

  button.type = 'button';
  button.className = 'lightbox-arrow';

  if (!supportsHover) {
    button.style.display = 'none';
  }

  button.setAttribute(
    'aria-label',
    direction === 'prev'
      ? 'Imagen anterior'
      : 'Imagen siguiente'
  );

  button.style.cssText = `
    position: absolute;
    top: 50%;
    ${direction === 'prev' ? 'left: -46px;' : 'right: -46px;'}
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    padding: var(--space-2);
    border: none;
    border-radius: var(--radius-full);
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  
  `;

  if (!supportsHover) {
  button.style.display = 'none';
}

  const icon = document.createElement('img');

  icon.src = '/skills/arrow.svg';
  icon.alt = '';
  icon.setAttribute('aria-hidden', 'true');

  icon.style.cssText = `
    width: 100%;
    height: 100%;
    display: block;
    filter: invert(1);
    ${direction === 'prev' ? 'transform: rotate(180deg);' : ''}
  `;

  button.appendChild(icon);

  // button.addEventListener('mouseenter', () => {
  //   button.style.background = 'var(--color-text-muted)';
  // });



  return button;
};

const prevBtn = createArrowButton('prev');
const nextBtn = createArrowButton('next');

card.appendChild(prevBtn);
card.appendChild(nextBtn);

      // ========================================================
      // MOUNT
      // ========================================================

      overlay.appendChild(card);
      document.body.appendChild(overlay);

      // ========================================================
      // STATE
      // ========================================================

      let currentIdx = currentIndex;

      let touchStartX = 0;
let touchEndX = 0;

const SWIPE_THRESHOLD = 50;

const handleTouchStart = (e) => {
  touchStartX = e.touches[0].clientX;
};

const handleTouchEnd = (e) => {
  touchEndX = e.changedTouches[0].clientX;

  const deltaX = touchEndX - touchStartX;

  if (Math.abs(deltaX) < SWIPE_THRESHOLD) {
    return;
  }

  if (deltaX < 0) {
    updateImage(currentIdx + 1);
  } else {
    updateImage(currentIdx - 1);
  }
};

card.addEventListener('touchstart', handleTouchStart, {
  passive: true,
});

card.addEventListener('touchend', handleTouchEnd, {
  passive: true,
});

      // ========================================================
      // ARROW VISIBILITY
      // ========================================================

      const updateArrows = () => {
        prevBtn.style.visibility =
          currentIdx > 0 ? 'visible' : 'hidden';

        nextBtn.style.visibility =
          currentIdx < photoSrcs.length - 1
            ? 'visible'
            : 'hidden';
      };

      // ========================================================
      // UPDATE IMAGE
      // ========================================================

      const updateImage = (newIndex) => {
        if (
          newIndex < 0 ||
          newIndex >= photoSrcs.length
        ) {
          return;
        }

        currentIdx = newIndex;

        safeAnimate(
          bigImg,
          { opacity: 0 },
          {
            duration: 0.15,
            easing: 'ease-out',
          }
        )
          .then(() => {
            bigImg.src = photoSrcs[currentIdx];

            bigImg.alt =
              allPhotos[currentIdx].getAttribute('alt') ||
              'Imagen ampliada';

            captionEl.textContent =
              photoCaptions[currentIdx];

            updateArrows();

            return safeAnimate(
              bigImg,
              { opacity: 1 },
              {
                duration: 0.15,
                easing: 'ease-in',
              }
            );
          })
          .catch(() => {});
      };

      // ========================================================
      // ARROW EVENTS
      // ========================================================

      prevBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        updateImage(currentIdx - 1);
      });

      nextBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        updateImage(currentIdx + 1);
      });

      updateArrows();

      // ========================================================
      // CLOSE MODAL
      // ========================================================
const closeModal = () => {
  overlay.remove();

  if (province) {
    if (!supportsHover) {
      province.classList.remove('province--gallery-open');
    } else {
      province.classList.remove('province--lightbox-open');
    }
  }

  document.removeEventListener('keydown', keyHandler);
};
      // ========================================================
      // CLOSE BY CLICKING OUTSIDE
      // ========================================================

      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) {
          closeModal();
        }
      });

      overlay.addEventListener(
        'touchstart',
        (e) => {
          if (e.target === overlay) {
            closeModal();
          }
        },
        { passive: true }
      );

      // ========================================================
      // CLOSE BUTTON
      // ========================================================

      closeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        closeModal();
      });

      // ========================================================
      // PREVENT CARD PROPAGATION
      // ========================================================

      card.addEventListener('click', (e) => {
        e.stopPropagation();
      });

      // ========================================================
      // KEYBOARD
      // ========================================================

      const keyHandler = (e) => {
        if (e.key === 'Escape') {
          closeModal();
        }

        if (e.key === 'ArrowLeft') {
          updateImage(currentIdx - 1);
        }

        if (e.key === 'ArrowRight') {
          updateImage(currentIdx + 1);
        }
      };

      document.addEventListener(
        'keydown',
        keyHandler
      );

      // ========================================================
      // ENTRY ANIMATION
      // ========================================================

      safeAnimate(
        card,
        {
          transform: 'scale(1)',
          opacity: 1,
        },
        {
          ...springs.swap,
          duration: 0.2,
        }
      );
    });
  });
</script>