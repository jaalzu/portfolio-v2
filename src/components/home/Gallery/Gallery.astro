---
import { Image } from "astro:assets";
import "./gallery.css";
import type { ImageMetadata } from "astro";

export interface Props {
  images: ImageMetadata[];
}

const { images } = Astro.props;

// Copy lives here (default lang: Spanish).
const copy = {
  es: {
    name: "Chaco, Argentina",
    alt: "Foto de Chaco",
    captions: ["pero que rico mate", "¡que vista!", "no es Japón, es Chaco."],
  },
  en: {
    name: "Chaco, Argentina",
    alt: "Chaco photo",
    captions: [
      "Capybaras love mate",
      "¡what a view!",
      "it's not Japan, it's Chaco.",
    ],
  },
} as const;
---

<span
  class="province link"
  tabindex="0"
  data-province-label={copy.es.name}
  data-label-es={copy.es.name}
  data-label-en={copy.en.name}
>
  <span class="province-text lang-es">{copy.es.name}</span>
  <span class="province-text lang-en">{copy.en.name}</span>

  <span
    class="province__gallery"
    role="group"
    aria-label={`Fotos de ${copy.es.name}`}
    data-aria-es={`Fotos de ${copy.es.name}`}
    data-aria-en={`Photos of ${copy.en.name}`}
  >
    {images.map((img, i) => {
      const captionEs = copy.es.captions[i] ?? `${copy.es.alt} ${i + 1}`;
      const captionEn = copy.en.captions[i] ?? `${copy.en.alt} ${i + 1}`;

      return (
        <span class="province__polaroid" data-index={i}>
          <Image
            class="province__photo"
            src={img}
            alt={`${copy.es.alt} ${i + 1}`}
            width={480}
            height={480}
            quality={100}
            loading="lazy"
            decoding="async"
            data-caption={captionEs}
            data-caption-es={captionEs}
            data-caption-en={captionEn}
            data-alt-es={`${copy.es.alt} ${i + 1}`}
            data-alt-en={`${copy.en.alt} ${i + 1}`}
            data-caption-index={i}
            data-alt-index={i}
          />

          <span
            class="province__caption lang-es"
            aria-hidden="true"
            data-caption-index={i}
          >
            {captionEs}
          </span>
          <span
            class="province__caption lang-en"
            aria-hidden="true"
            data-caption-index={i}
          >
            {captionEn}
          </span>
        </span>
      );
    })}
  </span>
</span>

<script>
  import { initGalleryInteractions } from "./interactions";
  import { initLightboxes } from "./lightbox";
  import { resolveLang, rootLang } from "../../../lib/lang";

  const supportsHover = window.matchMedia(
    "(hover: hover) and (pointer: fine)",
  ).matches;

  initGalleryInteractions({ supportsHover });
  initLightboxes({ supportsHover });

  function syncGalleryLang(lang: "es" | "en") {
    const isEn = lang === "en";

    // data-province-label is used for positioning (position.js)
    document.querySelectorAll(".province").forEach((el) => {
      const label =
        el.getAttribute(isEn ? "data-label-en" : "data-label-es") ??
        el.getAttribute("data-province-label") ??
        "";
      el.setAttribute("data-province-label", label);
    });

    document.querySelectorAll(".province__gallery").forEach((el) => {
      const aria =
        el.getAttribute(isEn ? "data-aria-en" : "data-aria-es") ?? "";
      if (aria) el.setAttribute("aria-label", aria);
    });

    // Update data-caption + alt from per-element co-located attributes.
    // Lightbox reads these at open time, so it picks up the right lang.
    document.querySelectorAll(".province__photo").forEach((img) => {
      const caption = img.getAttribute(
        isEn ? "data-caption-en" : "data-caption-es",
      );
      if (caption) img.setAttribute("data-caption", caption);
      const alt = img.getAttribute(isEn ? "data-alt-en" : "data-alt-es");
      if (alt) img.setAttribute("alt", alt);
    });
  }

  function currentLang(): "es" | "en" {
    // Manual choice wins; on first paint the head script already resolved
    // browser lang into data-lang, so rootLang() follows the browser
    // without ever persisting detection.
    try {
      const stored = localStorage.getItem("lang");
      if (stored === "en" || stored === "es") return stored;
    } catch {
      // private mode — fall through to root/browser detection
    }
    if (document.documentElement.hasAttribute("data-lang")) return rootLang();
    return resolveLang();
  }

  syncGalleryLang(currentLang());

  document.addEventListener("langchange", (e) => {
    const lang = (e as CustomEvent<{ lang: "es" | "en" }>).detail.lang;
    syncGalleryLang(lang);
  });
  document.addEventListener("astro:page-load", () => {
    syncGalleryLang(currentLang());
  });
  document.addEventListener("astro:after-swap", () => {
    syncGalleryLang(currentLang());
  });
</script>
