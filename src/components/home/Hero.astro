---
// src/components/home/Hero.astro
import LanguageToggle from "../ui/LanguageToggle.astro";

export interface Props {
  t: {
    bio1: string;
    githubIntro: string;
    githubWord: string;
    orWord: string;
    talkIntro: string;
    linkedinWord: string;
    emailWord?: string;
  };
}
const { t } = Astro.props;
---

<div class="top-bar reveal reveal--after" style="--i: 0">
  <LanguageToggle />
</div>

<div class="hero-identity">
  <div class="hero-identity__text">
    <p class="hero-identity__name reveal" style="--i: 0">
      Javier Alzú
    </p>
    <p class="hero-identity__role reveal reveal--after" style="--i: 1">
      Design Engineer
    </p>
  </div>
</div>

<div class="about">
  <p
    class="about__bio reveal reveal--after"
    style="--i: 2"
    data-i18n-html="bio1"
    set:html={t.bio1}
  />

  <p class="about__links reveal reveal--after" style="--i: 3">
    <span data-i18n="githubIntro">{t.githubIntro}</span>{" "}
    <a
      href="https://github.com/jaalzu"
      class="about__text-link"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span data-i18n="githubWord">{t.githubWord}</span>
    </a>{" "}
    <span data-i18n="orWord">{t.orWord}</span>{" "}
    <span data-i18n="talkIntro">{t.talkIntro}</span>{" "}
    <a
      href="https://www.linkedin.com/in/javier-alz%C3%BA-332ab2261/"
      class="about__text-link"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span data-i18n="linkedinWord">{t.linkedinWord}</span>
    </a>.
  </p>
</div>

<style>
  @keyframes revealUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .reveal {
    opacity: 0;
    animation: revealUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--i, 0) * 90ms);
  }

  .reveal--after {
    animation-delay: calc(300ms + var(--i, 0) * 110ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
      opacity: 1;
    }
  }

  :global(html.no-home-intro .reveal) {
    animation: none !important;
    opacity: 1 !important;
  }

  .top-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-2);
    margin-top: 2rem;
    margin-bottom: var(--space-8);
  }

  .hero-identity {
    display: flex;
    align-items: center;
    padding-bottom: calc(var(--space-8) + 1.2rem);
  }

  .hero-identity__name {
    margin: 0;
    font-size: var(--text-md);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-tight);
  }

  .hero-identity__role {
    margin: 0;
    font-size: var(--text-sm);
    letter-spacing: 0.2px;
    color: var(--color-text);
    line-height: var(--leading-tighter);
  }

  .about__bio {
    margin: 0 0 var(--space-6);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    max-inline-size: 68ch;
  }

  .about__text-link {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: var(--color-text);
    text-decoration-color: color-mix(in oklch, currentColor 35%, transparent);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition-fast);
  }

  .about__text-link:hover,
  .about__text-link:focus-visible {
    text-decoration-color: currentColor;
  }

  .about__links {
    padding-top: var(--space-2);
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 768px) {
    .top-bar {
      padding-top: var(--space-4);
    }
    .about {
      padding-block: var(--space-1);
      margin-bottom: var(--space-2);
    }
  }
</style>
