---
import LanguageToggle from "../ui/LanguageToggle.astro";

const copy = {
  es: {
    bio: '<span class="enfasis-text">Creando interfaces web</span> con ingeniería frontend y sentido del diseño.<br><br>Del prototipo al usuario, convierto ideas en código real, construyendo soluciones frontend escalables y sistemas de UI utilizando tecnologías modernas, con especial atención a la calidad y la experiencia de usuario.',
    githubIntro: "Podés ver más de mi código en",
    githubWord: "GitHub",
    orWord: "o",
    talkIntro: "contactarme por",
    linkedinWord: "LinkedIn",
  },
  en: {
    bio: '<span class="enfasis-text">Creating web interfaces</span> with frontend engineering and a sense of design.<br><br>From prototype to user, I turn ideas into real code, building scalable frontend solutions and UI systems using modern technologies, with a strong focus on quality and user experience.',
    githubIntro: "You can see my code on",
    githubWord: "GitHub",
    orWord: "or",
    talkIntro: "reach me on",
    linkedinWord: "LinkedIn",
  },
} as const;
---

<div class="top-bar reveal reveal--after" style="--i: 0">
  <LanguageToggle />
</div>
<div class="hero-identity">
  <div class="hero-identity__text">
    <p class="hero-identity__name reveal" style="--i: 0">
      Javier Alzú
    </p>
    <p class="hero-identity__role reveal reveal--after" style="--i: 1">
      Design Engineer
    </p>
  </div>
</div>
<div class="about">
  <!-- reveal lives on the wrapper so toggling .lang-es/.lang-en
       (display:none) never restarts the entrance animation -->
  <div class="reveal reveal--after" style="--i: 2">
    <p class="about__bio lang-es" set:html={copy.es.bio} />
    <p class="about__bio lang-en" set:html={copy.en.bio} />
  </div>

  <p class="about__links reveal reveal--after" style="--i: 3">
    <span class="lang-es">{copy.es.githubIntro}</span>
    <span class="lang-en">{copy.en.githubIntro}</span>{" "}
    <a
      href="https://github.com/jaalzu"
      class="about__text-link"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span>GitHub</span>
    </a>{" "}
    <span class="lang-es">{copy.es.orWord}</span>
    <span class="lang-en">{copy.en.orWord}</span>{" "}
    <span class="lang-es">{copy.es.talkIntro}</span>
    <span class="lang-en">{copy.en.talkIntro}</span>{" "}
    <a
      href="https://www.linkedin.com/in/javier-alz%C3%BA-332ab2261/"
      class="about__text-link"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span>LinkedIn</span>
    </a>
    .
  </p>
</div>
<style>
  @keyframes revealUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .reveal {
    opacity: 0;
    animation: revealUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--i, 0) * 90ms);
  }

  .reveal--after {
    animation-delay: calc(300ms + var(--i, 0) * 110ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
      opacity: 1;
    }
  }

  :global(html.no-home-intro .reveal) {
    animation: none !important;
    opacity: 1 !important;
  }

  .top-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-2);
    margin-top: 2rem;
    margin-bottom: var(--space-8);
  }

  .hero-identity {
    display: flex;
    align-items: center;
    padding-bottom: calc(var(--space-8) + 1.2rem);
  }

  .hero-identity__name {
    margin: 0;
    font-size: var(--text-md);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-tight);
  }

  .hero-identity__role {
    margin: 0;
    font-size: var(--text-sm);
    letter-spacing: 0.2px;
    color: var(--color-text);
    line-height: var(--leading-tighter);
  }

  .about__bio {
    margin: 0 0 var(--space-6);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    font-weight: var(--font-weight-regular);
    max-inline-size: 60ch;
  }

  .about__text-link {
    display: inline-flex;
    align-items: center;
    gap: 3px;

    color: var(--color-text-heading);
    text-decoration-color: color-mix(in oklch, currentColor 35%, transparent);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition-fast);
  }

  .about__text-link:hover,
  .about__text-link:focus-visible {
    text-decoration-color: currentColor;
  }

  .about__links {
    padding-top: var(--space-2);
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 768px) {
    .top-bar {
      padding-top: var(--space-4);
    }
    .about {
      padding-block: var(--space-1);
      margin-bottom: var(--space-2);
    }
  }
</style>
