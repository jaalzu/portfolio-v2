---
// src/components/home/Hero.astro
import Button from "../ui/Button.astro";
import Icon from "../icons/Icon.astro";
import GithubIcon from "../icons/GithubIcon.astro";
import LanguageToggle from "../ui/LanguageToggle.astro";

export interface Props {
  t: any;
}
const { t } = Astro.props;
---
<div class="top-bar">
  <LanguageToggle />
</div>

<div class="hero-identity">
  <img class="hero-identity__avatar" src="/favicon.png" alt="Foto de Javier Alzú" />
  <div class="hero-identity__text">
    <p class="hero-identity__name">Javier Alzú</p>
    <p class="hero-identity__role">Design Engineer</p>
  </div>
</div>

<div class="about">
  <p class="about__bio" data-i18n-html="bio1" set:html={t.bio1} />

  <p class="about__bio">
    <span data-i18n="bio2Before">{t.bio2Before}</span> <br />
    <span class="about__email-line">
      <span data-i18n="emailIntro">{t.emailIntro}</span>
      <a href="mailto:javieralzuu@gmail.com" class="about__email-link">
        <Icon name="mail-outline" size={16} class="about__at-icon" /><span data-i18n="emailWord">{t.emailWord}</span>
      </a>
      <span data-i18n="emailAfter">{t.emailAfter}</span>
    </span>
  </p>

  <div class="about__actions">
    <Button href="https://www.linkedin.com/in/javier-alz%C3%BA-332ab2261/" variant="icon" ariaLabel="LinkedIn" target="_blank">
      <Icon name="linkedin" size={24} />
    </Button>
    <Button href="https://github.com/jaalzu" variant="icon" class="tab-btn" ariaLabel="GitHub" target="_blank">
      <GithubIcon size={24} />
    </Button>
    <Button
      href="/CV-ESP.pdf"
      variant="icon"
      ariaLabel={t.aria.cv}
      data-i18n-attr="aria-label:aria.cv;href:cvHref"
      data-cv-es="/CV-ESP.pdf"
      data-cv-en="/CV-ENG.pdf"
      download="Javier-Alzu-CV.pdf"
    >
      <Icon name="document" size={24} />
    </Button>
  </div>
</div>

<style>
  .top-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-2);
    padding-top: 1rem;
    margin-bottom: var(--space-4);
  }

  .hero-identity {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: 5rem;
  }

  .hero-identity__avatar {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
  }

  .hero-identity__name {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-tight);
    color: var(--color-surface);
  }

  .hero-identity__role {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-tight);
  }

  .about {
    padding-block: var(--space-8);
  }

  .about__bio {
    margin: 0 0 var(--space-6);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    max-inline-size: 70ch;
  }

  .about__bio :global(.about__design) {
    font-family: 'Story Script', cursive, sans-serif;
    font-weight: 400;
    font-size: 1.08rem;
    color: var(--color-surface);
    display: inline-block;
    transform: translateY(-1px);
  }

  .about__bio :global(.about__care) {
    font-weight: 400;
    font-family: 'Story Script', cursive, sans-serif;
    font-size: 1.08rem;
    color: var(--color-surface);
    display: inline-block;
    transform: translateY(-1px);
  }

  .about__bio :global(.about__code) {
    font-weight: 400;
    color: var(--color-surface);
  }

  .about__email-line {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.32em;
    vertical-align: baseline;
  }

  .about__email-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration-color: color-mix(in oklch, currentColor 35%, transparent);
    text-underline-offset: 2px;
    transition: text-decoration-color var(--transition-fast);
    line-height: 1;
  }

  .about__email-link :global(.about__at-icon) {
    flex-shrink: 0;
    display: block;
  }

  .about__email-link:hover {
    text-decoration-color: currentColor;
  }

  .about__actions {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    margin-top: var(--space-16);
  }

  .about__actions :global(.btn) {
    opacity: 0.8;
    transition: opacity var(--transition-fast), color var(--transition-fast);
  }

  .about__actions :global(.btn:hover),
  .about__actions :global(.btn:focus-visible) {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .hero-identity {
      margin-top: 1.5rem;
    }

    .about {
      padding-block: var(--space-4);
    }

    .about__actions {
      margin-top: var(--space-8);
    }
  }
</style>