---
// src/components/home/Hero.astro
import LanguageToggle from "../ui/LanguageToggle.astro";

export interface Props {
	t: any;
}
const { t } = Astro.props;
---
<div class="top-bar">
  <LanguageToggle />
</div>

<div class="hero-identity">
  <div class="hero-identity__text">
    <p class="hero-identity__name">Javier Alzú</p>
    <p class="hero-identity__role">Design Engineer</p>
  </div>
</div>

<div class="about">
  <p class="about__bio" data-i18n-html="bio1" set:html={t.bio1} />

  <div class="about__links">
<a href="https://github.com/jaalzu" class="about__text-link" target="_blank" rel="noopener noreferrer">
  <span data-i18n="githubWord">{t.githubWord}</span>
</a>
<a href="https://www.linkedin.com/in/javier-alz%C3%BA-332ab2261/" class="about__text-link" target="_blank" rel="noopener noreferrer">
  <span data-i18n="linkedinWord">{t.linkedinWord}</span>
</a>
<a href="mailto:javieralzuu@gmail.com" class="about__text-link">
  <span data-i18n="emailWord">{t.emailWord}</span>
</a>
  </div>
</div>

<style>
  .top-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .hero-identity {
    display: flex;
    align-items: center;
    padding-bottom: var(--space-6);

  }

  .hero-identity__name {
    margin: 0;
    font-size: var(--text-md);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-tight);
  }

  .hero-identity__role {
    margin: 0;
    font-size: var(--text-sm);
    letter-spacing: .2px;
    color: var(--color-text);
    line-height: var(--leading-tighter);
  }

  .about__bio {
    margin: 0 0 var(--space-6);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    max-inline-size: 60ch;
  }

  .about__bio :global(.about__design) {
    font-family: 'Story Script', cursive, sans-serif;
    color: var(--color-text-heading);
    display: inline-block;
    font-size: 1.05em;
    line-height: 1;
    transform: translateY(-1px);
  }

 .about__bio :global(.about__code),
.about__bio :global(.about__unique) {
  color: var(--color-text-heading);
  
}

 

  .about__text-link {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: var(--color-text-heading);
    text-decoration-color: color-mix(in oklch, currentColor 35%, transparent);
    text-underline-offset: 2px;
    transition: text-decoration-color var(--transition-fast);
  }

  .about__text-link:hover,
  .about__text-link:focus-visible {
    text-decoration-color: currentColor;
  }

  .about__links {
    padding-top: var(--space-2);
        display: flex;
    gap: var(--space-4);
    font-size: var(--text-sm);
    flex-wrap: wrap;
    align-items: center;
  }


  @media (max-width: 768px) {
    .top-bar{
    padding-top: var(--space-4);

    }
    .about {
      padding-block: var(--space-1);
      margin-bottom: var(--space-12);
    }
  }
</style>