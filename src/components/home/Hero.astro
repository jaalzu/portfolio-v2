---
import LanguageToggle from "../ui/LanguageToggle.astro";

const copy = {
  es: {
    bioLead:
      '<span class="enfasis-text">Creando interfaces</span> con ingeniería frontend y sentido del diseño.',
    bioBody:
      "Del prototipo al usuario, materializo ideas en experiencias web con personalidad, accesibles para todos y respaldadas por sistemas consistentes y escalables, para que se sientan especiales y no simplemente funcionales.",
    githubIntro: "Podés ver más de mi código en",
    githubWord: "GitHub",
    orWord: "o",
    talkIntro: "contactarme por",
    linkedinWord: "LinkedIn",
  },
  en: {
    bioLead:
      '<span class="enfasis-text">Crafting interfaces</span> through frontend engineering and design sensibility.',
    bioBody:
      "From prototype to user, I turn ideas into distinctive, accessible web experiences for everyone, backed by consistent and scalable systems that feel special rather than simply functional.",
    githubIntro: "You can see more of my code on",
    githubWord: "GitHub",
    orWord: "or",
    talkIntro: "reach me on",
    linkedinWord: "LinkedIn",
  },
} as const;
---

<div class="top-bar reveal reveal--after" style="--i: 0">
  <LanguageToggle />
</div>
<div class="hero-identity">
  <div class="hero-identity__text">
    <p class="hero-identity__name reveal" style="--i: 0">
      Javier Alzú
    </p>
    <p class="hero-identity__role reveal reveal--after" style="--i: 1">
      Design Engineer
    </p>
  </div>
</div>
<div class="about">
  <!-- reveal lives on the wrapper so toggling .lang-es/.lang-en
       (display:none) never restarts the entrance animation -->
  <div class="reveal reveal--after" style="--i: 2">
    <p class="about__bio about__bio--lead lang-es" set:html={copy.es.bioLead} />
    <p class="about__bio about__bio--lead lang-en" set:html={copy.en.bioLead} />
    <p class="about__bio about__bio--body lang-es" set:html={copy.es.bioBody} />
    <p class="about__bio about__bio--body lang-en" set:html={copy.en.bioBody} />
  </div>

  <p class="about__links reveal reveal--after" style="--i: 3">
    <span class="lang-es">{copy.es.githubIntro}</span>
    <span class="lang-en">{copy.en.githubIntro}</span>{" "}
    <a
      href="https://github.com/jaalzu"
      class="about__text-link link link--flex"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span>GitHub</span>
    </a>{" "}
    <span class="lang-es">{copy.es.orWord}</span>
    <span class="lang-en">{copy.en.orWord}</span>{" "}
    <span class="lang-es">{copy.es.talkIntro}</span>
    <span class="lang-en">{copy.en.talkIntro}</span>{" "}
    <a
      href="https://www.linkedin.com/in/javier-alz%C3%BA-332ab2261/"
      class="about__text-link link link--flex"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span>LinkedIn</span>
    </a>
    .
  </p>
</div>
<style>
  @keyframes revealUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .reveal {
    opacity: 0;
    animation: revealUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--i, 0) * 90ms);
  }

  .reveal--after {
    animation-delay: calc(300ms + var(--i, 0) * 110ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
      opacity: 1;
    }
  }

  :global(html.no-home-intro .reveal) {
    animation: none !important;
    opacity: 1 !important;
  }

  .top-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-2);
    margin-top: 2rem;
    margin-bottom: var(--space-12);
  }

  .hero-identity {
    display: flex;
    align-items: center;
    padding-bottom: calc(var(--space-8) + 1.2rem);
  }

  .hero-identity__name {
    margin: 0;
    font-size: var(--text-md);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-tight);
  }

  .hero-identity__role {
    margin: 0;
    font-size: var(--text-sm);
    letter-spacing: 0.2px;
    color: var(--color-text);
    line-height: var(--leading-tighter);
  }

  .about__bio {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    font-weight: var(--font-weight-regular);
    max-inline-size: 60ch;
  }

  .about__bio--body {
    margin-top: var(--space-2);
  }

  .about__text-link {
    color: var(--color-text-heading);
  }

  .about__links {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 768px) {
    .top-bar {
      padding-top: var(--space-4);
    }
    .about {
      padding-block: var(--space-1);
      margin-bottom: var(--space-2);
    }
    .about__bio--body {
      margin-top: var(--space-5);
    }
  }
</style>
