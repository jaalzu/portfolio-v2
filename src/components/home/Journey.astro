---
export interface Props {
	years: string[];
	texts: readonly string[];
}
const { years, texts } = Astro.props;
---
<ol class="journey">
  {years.map((year, i) => (
    <li class="journey__item">
      <span class="journey__year">{year}</span>
      <p class="journey__text" data-i18n={`journey.${i}`}>{texts[i]}</p>
    </li>
  ))}
</ol>

<style>
  .journey { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-8); }
  .journey__item { display: flex; align-items: baseline; gap: var(--space-8); }
  .journey__year { width: 110px; flex-shrink: 0; white-space: nowrap; font-size: var(--text-sm); font-weight: var(--font-weight-semibold); font-variant-numeric: tabular-nums; color: var(--color-text); }
  .journey__text { margin: 0; font-size: var(--text-base); line-height: var(--leading-relaxed); color: var(--color-text-muted); text-wrap: pretty; }

  @media (max-width: 560px) {
    .journey__item { flex-direction: column; gap: var(--space-1); }
  }
</style>