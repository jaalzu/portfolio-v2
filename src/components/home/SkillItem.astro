---
interface Props {
	iconSrc: string;
	title: string;
	subtitle: string;
	href?: string;
	variant?: "default" | "arrows";
}

const {
	iconSrc,
	title,
	subtitle,
	href = "/skills",
	variant = "default",
} = Astro.props;
---

<div class="skill-frame">
  <a href={href} class:list={["skill", variant === "arrows" && "skill--arrows"]}>
    <div class="skill__text">
      <p class="skill__title">{title}</p>
      <p class="skill__subtitle">{subtitle}</p>
    </div>
    {variant === "arrows" ? (
      <span class="skill__arrows" aria-hidden="true">
        <img src="/skills/arrow.svg" alt="" width="16" height="16" class="skill__arrow" />
      </span>
    ) : (
      <span class="skill__arrow-wrap" aria-hidden="true">
        <img src="/skills/arrow.svg" alt="" width="16" height="16" class="skill__arrow" />
      </span>
    )}
  </a>
</div>

<style>
  .skill-frame {
    border: none;
    border-radius: var(--radius-base);
    padding: var(--card-inset);
    background: color-mix(in oklch, var(--color-bg-warm) 55%, transparent);
    transition: background var(--transition-base);
  }

  .skill-frame:has(.skill:hover) {
    background: color-mix(in oklch, var(--color-bg-warm) 75%, transparent);
  }

  .skill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-inline: 0;
    padding-block: var(--space-6);
    border: none;
    border-radius: var(--radius-inner);
    text-decoration: none;
    background: transparent;
    transition: opacity var(--transition-base), transform var(--transition-base), background var(--transition-base);
  }

  .skill__icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    object-fit: contain;
    filter: invert(1) brightness(0.95);
    opacity: 0.75;
  }

  .skill__text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
    min-width: 0;
  }

  .skill__title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-tight);
        color: var(--color-text-heading);

  }

  .skill__subtitle {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  .skill__arrow-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    margin-left: auto;
    opacity: 0.7;
    transform: translateX(0);
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .skill__arrow {
    width: 17px;
    height: 17px;
    filter: invert(1) brightness(1);
  }

  .skill:hover .skill__arrow-wrap,
  .skill:focus-visible .skill__arrow-wrap {
    opacity: 1;
  }

  .skill__arrows {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    margin-left: auto;
    opacity: 0.7;
    transition: opacity var(--transition-base);
  }

  .skill:hover .skill__arrows,
  .skill:focus-visible .skill__arrows {
    opacity: 1;
  }

  .skill--arrows {
    border: none;
  }

</style>
