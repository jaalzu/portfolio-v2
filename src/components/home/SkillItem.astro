---
interface Props {
  title: string;
  subtitle: string;
  href?: string;
  variant?: "default" | "arrows";
}

const { title, subtitle, href = "/skills", variant = "default" } = Astro.props;
---

<div class="skill-frame">
  <a
    href={href}
    class:list={["skill", variant === "arrows" && "skill--arrows"]}
  >
    <div class="skill__text">
      <p class="skill__title" data-i18n="skillsPromo.title">
        {title}
      </p>
      <p class="skill__subtitle" data-i18n="skillsPromo.subtitle">
        {subtitle}
      </p>
    </div>
    {variant === "arrows" ? (
      <span class="skill__arrows" aria-hidden="true">
        <img
          src="/skills/arrow.svg"
          alt=""
          width="16"
          height="16"
          class="skill__arrow"
        />
      </span>
    ) : (
      <span class="skill__arrow-wrap" aria-hidden="true">
        <img
          src="/skills/arrow.svg"
          alt=""
          width="16"
          height="16"
          class="skill__arrow"
        />
      </span>
    )}
  </a>
</div>

<style>
  .skill-frame {
    display: block;
    border: none;
    padding: 0;
  }

  .skill {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
    padding: var(--space-4) 44px var(--space-4) var(--space-4);
    background: var(--color-surface-2);
    border: 1px solid transparent;
    border-radius: var(--radius-base);
    text-decoration: none;
    overflow: hidden;
    transition: border-color var(--transition-base);
  }

  .skill:hover,
  .skill:focus-visible {
    border-color: var(--color-border-soft);
  }

  .skill__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    flex: 1;
    min-width: 0;
  }

  .skill__title {
    margin: 0;
    letter-spacing: 0.2px;
    font-size: var(--text-base);
    font-weight: var(--font-weight-regular);
    line-height: var(--leading-tight);
    color: var(--color-text-heading);
  }

  .skill__subtitle {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  .skill__arrow {
    width: 16px;
    height: 16px;
    filter: invert(1) brightness(1);
  }

  .skill__arrow-wrap,
  .skill__arrows {
    position: absolute;
    right: var(--space-3);
    top: 50%;
    transform: translateY(-50%) translateX(-6px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    opacity: 0;
    transition:
      opacity var(--transition-base),
      transform var(--transition-base);
  }

  .skill:hover .skill__arrow-wrap,
  .skill:focus-visible .skill__arrow-wrap,
  .skill:hover .skill__arrows,
  .skill:focus-visible .skill__arrows {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  .skill--arrows {
    border: 1px solid transparent;
  }

  @media (max-width: 480px) {
    .skill {
      padding: var(--space-3) 36px var(--space-3) var(--space-4);
    }
  }
</style>
