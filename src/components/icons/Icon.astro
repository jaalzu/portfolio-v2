      <path d="M10 14 20 4" />
      <path d="M19 13v5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5" />
    </svg>
  )
}
{
  name === "download" && (
    <svg
      class={className}
      width={size}
      height={size}
