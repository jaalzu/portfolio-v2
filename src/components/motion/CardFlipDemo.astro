<!-- ---
// src/components/motion/CardFlipDemo.astro
// Tarjeta que rota en Y al hacer click, mostrando su cara trasera con el stack.
// Nota: usa el mismo patrón de "toggle-card" que el bloque de Morphing en otra página,
// por eso mantiene esas clases aunque viva en su propio componente.
---

<div class="skill-block-frame">
  <div class="toggle-card">
    <div class="toggle-card__stage flip-card__stage">
      <label class="flip-card">
        <input type="checkbox" class="flip-card__toggle" />
        <div class="flip-card__inner">
          <div class="flip-card__face flip-card__face--front">
            <h3>Portfolio v2</h3>
            <p>Astro + React + Motion</p>
            <span class="flip-card__hint">Click para más info</span>
          </div>
          <div class="flip-card__face flip-card__face--back">
            <h3>Stack</h3>
            <ul>
              <li>Astro</li>
              <li>React</li>
              <li>Motion</li>
              <li>CSS puro</li>
            </ul>
            <span class="flip-card__hint">Click para volver</span>
          </div>
        </div>
      </label>
    </div>
    <div class="toggle-card__toolbar">
      <span class="flip-card__toolbar-label">
        Card flip — rotateY + perspective
      </span>
    </div>
  </div>
</div>

<style>
  .skill-block-frame {
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-base);
    padding: var(--card-inset);
    margin-bottom: var(--space-24);
    overflow: hidden;
  }
  .toggle-card {
    position: relative;
    border-radius: var(--radius-base);
    overflow: hidden;
    margin: calc(var(--card-inset) * -1);
    width: calc(100% + var(--card-inset) * 2);
  }
  .toggle-card__stage {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: var(--space-12) var(--space-6);
  }
  .toggle-card__toolbar {
    width: 100%;
    padding: var(--space-2);
    display: flex;
    align-items: center;
    justify-content: center;
    border-top: 1px solid var(--color-border-soft);
    background: var(--color-surface-2);
  }
  .flip-card__toolbar-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .flip-card {
    display: block;
    width: 220px;
    height: 260px;
    perspective: 800px;
    cursor: pointer;
  }
  .flip-card__toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .flip-card__inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform var(--transition-base);
    transform-style: preserve-3d;
  }
  .flip-card__toggle:checked ~ .flip-card__inner {
    transform: rotateY(180deg);
  }
  .flip-card__toggle:focus-visible ~ .flip-card__inner {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }
  .flip-card__face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-6);
    background-color: var(--color-surface-3);
    border: 1px solid var(--color-border-softer);
    border-radius: var(--radius-inner);
    backface-visibility: hidden;
  }
  .flip-card__face h3 {
    font-size: var(--text-md);
    color: var(--color-text-heading);
    margin: 0;
  }
  .flip-card__face p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }
  .flip-card__face ul {
    list-style: none;
