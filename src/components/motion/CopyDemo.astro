---
// src/components/motion/CopyDemo.astro
// Fila con un valor y un botón que copia al portapapeles (usa el CopyButton compartido).
import CopyButton from "../ui/CopyButton.astro";

interface Props {
  value?: string;
  label?: string;
}

const { value = "tu@email.com", label = "Copiar email" } = Astro.props;
---

<div class="copy-demo">
  <span class="copy-demo__value">{value}</span>
  <CopyButton text={value} label={label} />
</div>

<style>
  .copy-demo {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 280px;
    padding: var(--space-3) var(--space-10) var(--space-3) var(--space-4);
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-sm);
  }

  .copy-demo__value {
    font-size: var(--text-sm);
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
