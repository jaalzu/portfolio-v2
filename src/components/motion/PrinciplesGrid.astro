---
const principles = [
  {
    key: "translation",
    title: "Traslación",
    desc: "Moverse de un punto a otro.",
  },
  { key: "rotation", title: "Rotación", desc: "Girar sobre un eje." },
  { key: "scaling", title: "Escalado", desc: "Crecer o achicarse." },
  { key: "skew", title: "Distorsión", desc: "Inclinar la forma." },
  { key: "opacity", title: "Opacidad", desc: "Aparecer o desvanecerse." },
  { key: "blur", title: "Desenfoque", desc: "Sumar o quitar foco." },
  { key: "glow", title: "Resplandor", desc: "Un toque de luz extra." },
  { key: "color", title: "Color", desc: "Transición de color suave." },
  { key: "clip", title: "Recorte", desc: "Revelar solo una parte." },
  { key: "perspective", title: "Perspectiva", desc: "Profundidad en 2D." },
];

// Todas a 2s. Solo cambia el timing-function (rotation es linear porque es un
// giro completo, no un bounce).
const effectAnim = {
  translation: "principle-translate 2s ease-in-out infinite",
  rotation: "principle-rotate 2s linear infinite",
  scaling: "principle-scale 2s ease-in-out infinite",
  skew: "principle-skew 2s ease-in-out infinite",
  opacity: "principle-opacity 2s ease-in-out infinite",
  blur: "principle-blur 2s ease-in-out infinite",
  glow: "principle-glow 2s ease-in-out infinite",
  color: "principle-color 2s ease-in-out infinite",
  clip: "principle-clip 2s ease-in-out infinite",
  perspective: "principle-perspective 2s ease-in-out infinite",
} as const;

type EffectKey = keyof typeof effectAnim;
const labelOf = (k: EffectKey) => principles.find((p) => p.key === k)!.title;

// "translation" toca `transform` junto con otro efecto de la lista: no se
// puede comma-joinear (CSS solo aplica la última animación que toca una
// propiedad dada). Para ese caso uso un keyframe hecho a mano que combina
// ambas funciones dentro del mismo `transform:`.
const comboCards = [
  {
    title: `${labelOf("translation")} + ${labelOf("rotation")}`,

    animation: "combo-translate-rotate 2s ease-in-out infinite",
  },
  {
    title: `${labelOf("scaling")} + ${labelOf("opacity")}`,

    animation: [effectAnim.scaling, effectAnim.opacity].join(", "),
  },
  {
    title: `${labelOf("skew")} + ${labelOf("color")}`,

    animation: [effectAnim.skew, effectAnim.color].join(", "),
  },
  {
    title: `${labelOf("blur")} + ${labelOf("opacity")}`,

    animation: [effectAnim.blur, effectAnim.opacity].join(", "),
  },
  {
    title: `${labelOf("clip")} + ${labelOf("perspective")}`,

    animation: [effectAnim.clip, effectAnim.perspective].join(", "),
  },
  {
    title: `${labelOf("rotation")} + ${labelOf("color")}`,

    animation: [effectAnim.rotation, effectAnim.color].join(", "),
  },
  {
    title: `${labelOf("blur")} + ${labelOf("opacity")} + ${labelOf("color")}`,
    animation: [effectAnim.blur, effectAnim.opacity, effectAnim.color].join(
      ", ",
    ),
  },
];
---

<div class="principles__container">
  <div class="principles__intro">
    <h2 class="principles__title">Intro</h2>
    <p class="principles__description">
      Toda animación en la web parte de principios de movimiento. Podés armar
      casi cualquier cosa que imagines, desde una transición sutil hasta un
      efecto interactivo complejo. Por más complejo que se vea, es solo una
      combinacion de estas bases.
    </p>
  </div>

  <div class="principles__grid">
    {principles.map((p) => (
      <div class={`principles__card principles__card--${p.key}`}>
        <div class="principles__stage">
          <span class="principles__shape"></span>
        </div>
        <h3>{p.title}</h3>
        <p>{p.desc}</p>
      </div>
    ))}
  </div>

  <div class="principles__intro">
    <h2 class="principles__title">Combinando</h2>
    <p class="principles__description">
      Algunas animaciones son simplemente la combinación de 2 o más efectos.
    </p>
  </div>

  <div class="principles__grid">
    {comboCards.map((card) => (
      <div class="principles__card">
        <div class="principles__stage">
          <span
            class="principles__shape"
            style={`animation: ${card.animation}`}
          ></span>
        </div>
        <h3>{card.title}</h3>
        <p>{card.desc}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .principles__container {
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-base);
    padding-inline: 18px;
    padding-block: 1rem 1.5rem;
    background-color: var(--color-surface-2);
    margin-bottom: 4rem;
  }
  .principles__intro {
    display: flex;
    flex-direction: column;
    padding-bottom: 0.5rem;
  }
  .principles__title {
    margin: 0;
    font-weight: var(--font-weight-medium);
    padding-top: 0.5rem;
    padding-bottom: 0.25rem;
  }

  .principles__description {
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: var(--font-weight-light);
    border-radius: var(--radius-base);
    margin-top: 5px;
  }

  .principles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--space-4);
    padding-bottom: 2rem;
  }

  .principles__card {
    background-color: var(--color-surface-3);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-base);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
  }

  .principles__card h3 {
    font-size: var(--text-base);
    color: var(--color-text-heading);
    margin: 0;
    padding-left: 0.35rem;
    font-weight: var(--font-weight-medium);
  }

  .principles__card p {
    font-size: var(--text-sm);
    padding-left: 0.35rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.2;
  }

  .principles__stage {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: start;
    padding-left: 0.35rem;
    overflow: hidden;
    perspective: 300px;
  }

  .principles__shape {
    width: 35px;
    height: 35px;
    border-radius: var(--radius-sm);
    background-color: var(--color-primary);
    transform-style: preserve-3d;
  }

  .principles__card--translation .principles__shape {
    animation: principle-translate 2s ease-in-out infinite;
  }
  .principles__card--rotation .principles__shape {
    animation: principle-rotate 2s linear infinite;
  }
  .principles__card--scaling .principles__shape {
    animation: principle-scale 2s ease-in-out infinite;
  }
  .principles__card--skew .principles__shape {
    animation: principle-skew 2s ease-in-out infinite;
  }
  .principles__card--opacity .principles__shape {
    animation: principle-opacity 2s ease-in-out infinite;
  }
  .principles__card--blur .principles__shape {
    animation: principle-blur 2s ease-in-out infinite;
  }
  .principles__card--glow .principles__shape {
    animation: principle-glow 2s ease-in-out infinite;
  }
  .principles__card--color .principles__shape {
    animation: principle-color 2s ease-in-out infinite;
  }
  .principles__card--clip .principles__shape {
    animation: principle-clip 2s ease-in-out infinite;
  }
  .principles__card--perspective .principles__shape {
    animation: principle-perspective 2s ease-in-out infinite;
  }

  /* Bounce (ida y vuelta): mismo timing-function y misma duración en todas,
     para que al combinarse queden siempre en fase. */
  @keyframes principle-translate {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-14px);
    }
  }
  @keyframes principle-scale {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.25);
    }
  }
  @keyframes principle-skew {
    0%,
    100% {
      transform: skew(0deg, 0deg);
    }
    50% {
      transform: skew(-14deg, 0deg);
    }
  }
  @keyframes principle-opacity {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: var(--opacity-faint);
    }
  }
  @keyframes principle-blur {
    0%,
    100% {
      filter: blur(0);
    }
    50% {
      filter: blur(3px);
    }
  }
  @keyframes principle-glow {
    0%,
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
    50% {
      box-shadow: 0 0 20px 4px var(--color-primary-soft);
    }
  }
  @keyframes principle-color {
    0%,
    100% {
      background-color: var(--color-primary);
    }
    50% {
      background-color: var(--color-blue);
    }
  }

  /* Giro completo: no vuelve sobre sus pasos, por eso no se siente el "frenón"
     de un bounce en los extremos. */
  @keyframes principle-rotate {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* Revela desde 0% en vez de achicarse desde 75%: se siente como un ciclo
     completo de aparición, no un simple achique. */
  @keyframes principle-clip {
    0%,
    100% {
      clip-path: circle(0% at 50% 50%);
    }
    50% {
      clip-path: circle(75% at 50% 50%);
    }
  }

  @keyframes principle-perspective {
    0%,
    100% {
      transform: rotateY(0deg) translateZ(0);
    }
    50% {
      transform: rotateY(-45deg) translateZ(0.8rem);
    }
  }

  /* Combo que toca `transform` dos veces: no se puede comma-joinear,
     necesita las dos funciones dentro del mismo `transform:`. */
  @keyframes combo-translate-rotate {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-14px) rotate(180deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .principles__shape {
      animation: none !important;
    }
  }
</style>
