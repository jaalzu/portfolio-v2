---
const timings = [
  { key: "linear", title: "Linear", value: "linear" },
  { key: "ease", title: "Ease", value: "ease" },
  { key: "ease-in", title: "Ease-in", value: "ease-in" },
  { key: "ease-out", title: "Ease-out", value: "ease-out" },
  { key: "ease-in-out", title: "Ease-in-out", value: "ease-in-out" },
];

const cubicBeziers = [
  {
    title: "Ease out",
    value: "cubic-bezier(0, 0, 0.2, 1)",
  },
  {
    title: "Soft",
    value: "cubic-bezier(0.25, 0.1, 0.25, 1)",
  },
];
---

<div class="timing__container">
  <div class="timing__intro">
    <h2 class="timing__title">Timing Functions</h2>

    <p class="timing__description">
      Define how the animation progresses over time — speeding up, slowing down,
      or following a custom curve.
    </p>
  </div>

  <div class="timing__list">
    {timings.map((timing) => (
      <div class="timing__item">
        <span class="timing__label">{timing.title}</span>

        <div class="timing__track">
          <span class="timing__dot" style={`--timing: ${timing.value}`}></span>
        </div>
      </div>
    ))}
  </div>

  <p class="timing__note">
    All animations take the same amount of time. What changes is the way the
    movement progresses.
  </p>

  <div class="timing__intro timing__intro--custom">
    <h2 class="timing__title">Cubic Bezier</h2>

    <p class="timing__description">
      Create custom timing functions using four values:
      <code>x1</code>, <code>y1</code>, <code>x2</code> and <code>y2</code>. Low{" "}
      <code>y</code> values create slower movement, while higher values make it
      faster. The <code>x</code> values control when those changes in speed
      happen during the animation.
    </p>
  </div>

  <div class="timing__custom">
    {cubicBeziers.map((curve) => (
      <div class="timing__custom-item">
        <span class="timing__label">{curve.title}</span>

        <div class="timing__track">
          <span class="timing__dot" style={`--timing: ${curve.value}`}></span>
        </div>

        <code class="timing__code">{curve.value}</code>
      </div>
    ))}
  </div>

  <p class="timing__note timing__note--custom">
    Use cubic-bezier to create transitions that feel smoother, more natural, and
    more expressive.
  </p>
</div>

<style>
  .timing__container {
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-base);
    padding-inline: 18px;
    padding-block: 1rem 1.5rem;
    background-color: var(--color-surface-2);
  }

  .timing__intro {
    display: flex;
    flex-direction: column;
    padding-bottom: 0.5rem;
  }

  .timing__title {
    margin: 0;
    font-weight: var(--font-weight-medium);
    padding-top: 0.5rem;
    padding-bottom: 0.25rem;
  }

  .timing__description {
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: var(--font-weight-light);
    border-radius: var(--radius-base);
    margin-top: 5px;
    line-height: var(--leading-relaxed);
  }

  .timing__description code {
    font-family: monospace;
    font-size: var(--text-sm);
    color: var(--color-text-heading);
  }

  .timing__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-block: var(--space-4) var(--space-6);
    max-width: 560px;
  }

  .timing__item,
  .timing__custom-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .timing__label {
    font-size: var(--text-sm);
    color: var(--color-text-heading);
    font-weight: var(--font-weight-medium);
  }

  .timing__track {
    position: relative;
    width: 100%;
    height: 2px;
    background-color: var(--color-border-softer);
    border-radius: var(--radius-full);
  }

  .timing__dot {
    position: absolute;
    top: 50%;
    left: 0;
    width: 14px;
    height: 14px;
    margin-top: -7px;
    border-radius: var(--radius-full);
    background-color: var(--color-primary);
    animation: timing-move 1.8s var(--timing) infinite alternate;
  }

  .timing__note {
    margin: 0;
    padding-bottom: var(--space-4);
    max-width: 560px;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    font-weight: var(--font-weight-light);
  }

  .timing__intro--custom {
    padding-top: var(--space-4);
  }

  .timing__custom {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 560px;
    padding-top: var(--space-4);
  }

  .timing__code {
    font-family: monospace;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .timing__note--custom {
    padding-top: var(--space-4);
    padding-bottom: 0;
  }

  @keyframes timing-move {
    from {
      left: 0;
    }

    to {
      left: calc(100% - 14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timing__dot {
      animation: none !important;
    }
  }
</style>
