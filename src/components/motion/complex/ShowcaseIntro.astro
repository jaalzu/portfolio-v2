---
import { translations } from "../../../data/translations";
const t = translations.es;
---

<div class="showcase-intro">
  <h2 class="showcase-intro__title" data-i18n="motionPage.showcaseIntro.title">
    {t.motionPage.showcaseIntro.title}
  </h2>

  <p
    class="showcase-intro__description"
    data-i18n="motionPage.showcaseIntro.description"
  >
    {t.motionPage.showcaseIntro.description}
  </p>
</div>

<style>
  .showcase-intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .showcase-intro__title {
    margin: 0;
    font-weight: var(--font-weight-medium);
    padding-top: 0.5rem;
    padding-bottom: 0.25rem;
  }

  .showcase-intro__description {
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: var(--font-weight-light);
    margin: 0;
  }
</style>
