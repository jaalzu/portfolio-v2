---
import SocialExpand from "./SocialExpand.astro";
import SpotifyPlayer from "./SpotifyPlayer.astro";
---

<div class="triggers-group">
  <div class="triggers-group__row triggers-group__row--center">
    <SocialExpand />
  </div>

  <div class="triggers-group__player">
    <SpotifyPlayer />
  </div>
</div>

<style>
  .triggers-group {
    display: flex;
    align-items: center;
    padding: var(--space-16) var(--space-12) var(--space-12);
    flex-direction: row;
    width: 100%;
    gap: var(--space-5);
  }

  .triggers-group__title {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .triggers-group__row {
    display: flex;
    justify-content: flex-start;
    padding-left: var(--space-2);
  }

  .triggers-group__row--center {
    justify-content: center;
    padding-left: var(--space-6);
    margin-top: var(--space-6);
  }

  .triggers-group__player {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  /* Mobile: apilados, player arriba y SocialExpand abajo */
  @media (max-width: 560px) {
    .triggers-group {
      flex-direction: column;
      align-items: stretch;
      padding: var(--space-12) var(--space-4) var(--space-8);
      gap: var(--space-12);
    }

    .triggers-group__player {
      order: 0;
    }

    .triggers-group__row--center {
      order: 1;
      justify-content: center;
      padding-left: 0;
      margin-top: 0;
      padding-top: var(--space-12);
    }
  }
</style>
