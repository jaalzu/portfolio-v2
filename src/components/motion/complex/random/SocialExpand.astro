---
---

<div class="demo-social">
  <div class="demo-social__items">
    <a
      href="#"
      class="demo-social__item demo-social__item--1"
      aria-label="Email"
    >
      <img src="/motion/at.svg" alt="" class="demo-social__icon" />
    </a>

    <a
      href="#"
      class="demo-social__item demo-social__item--2"
      aria-label="LinkedIn"
    >
      <img src="/motion/linkedin-logo.svg" alt="" class="demo-social__icon" />
    </a>

    <a
      href="#"
      class="demo-social__item demo-social__item--3"
      aria-label="GitHub"
    >
      <img src="/motion/github-logo.svg" alt="" class="demo-social__icon" />
    </a>
  </div>

  <button
    class="demo-social__main"
    data-toggle="group"
    data-toggle-target=".demo-social"
    aria-label="Compartir"
    aria-expanded="false"
  >
    <img
      src="/motion/share-network.svg"
      alt=""
      class="demo-social__icon demo-social__icon--main"
    />
  </button>
</div>
<script>
  function init() {
    // Links demo deshabilitados: no navegan ni scrollean al top.
    document
      .querySelectorAll<HTMLAnchorElement>(".demo-social__item:not([data-bound])")
      .forEach((link) => {
        link.dataset.bound = "true";
        link.setAttribute("aria-disabled", "true");
        link.addEventListener("click", (e) => e.preventDefault());
      });

    document
      .querySelectorAll<HTMLElement>('[data-toggle="group"]:not([data-bound])')
      .forEach((el) => {
        el.dataset.bound = "true";

        const selector = el.dataset.toggleTarget;
        const target = selector ? el.closest<HTMLElement>(selector) : el;
        if (!target) return;

        el.addEventListener("click", () => {
          const isOpen = target.classList.contains("is-active");

          if (isOpen) {
            target.classList.remove("is-active");
            target.classList.add("is-closing");
            el.setAttribute("aria-expanded", "false");

            window.setTimeout(() => {
              target.classList.remove("is-closing");
            }, 500);
          } else {
            target.classList.remove("is-closing");
            target.classList.add("is-active");
            el.setAttribute("aria-expanded", "true");
          }
        });
      });
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .demo-social {
    /* Abanico hacia arriba: los 3 items salen por encima del botón */
    --menu-distance-x: 54px;
    --menu-distance-side-y: -46px;
    --menu-distance-top-y: -80px;

    --menu-open-duration: 420ms;
    --menu-close-duration: 360ms;
    --menu-stagger: 100ms;

    position: relative;
    width: 44px;
    height: 44px;
    margin-bottom: 54px;
  }

  .demo-social__main {
    position: relative;
    z-index: 2;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 44px;
    height: 44px;

    border: 1px solid var(--color-border-soft);
    border-radius: 50%;

    background: var(--color-surface-2);
    color: var(--color-text);

    cursor: pointer;

    box-shadow: var(--shadow-md);

    will-change: transform;
    backface-visibility: hidden;

    transition:
      transform 250ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 120ms ease,
      border-color 120ms ease,
      color 120ms ease,
      box-shadow 120ms ease;
  }

  .demo-social:hover .demo-social__main {
    border-color: var(--color-border);
    background: color-mix(in oklch, var(--color-surface-2) 85%, white 05%);
    box-shadow: var(--shadow-md);
  }

  .demo-social.is-active .demo-social__main {
    background: var(--color-primary);
    color: var(--color-text-heading);
    border-color: var(--color-primary);
  }

  /*
   * CLOSE IMPACT
   *
   * El botón recibe el "golpe" de los 3 items volviendo: se empuja
   * hacia abajo y rebota de vuelta a su posición, un solo impacto.
   */
  /*
   * CLOSE IMPACT
   *
   * translateY va ANTES de rotate en la lista de transforms: así el
   * desplazamiento ocurre en el eje vertical de pantalla (recto hacia
   * abajo), sin mezclarse con el eje ya rotado. Un rebote leve, no
   * exagerado.
   */
  .demo-social.is-closing .demo-social__main {
    transition: none;
    animation: demo-social-bounce 480ms ease-out forwards;
  }

  @keyframes demo-social-bounce {
    0% {
      transform: translateY(0) rotate(45deg);
    }
    30% {
      transform: translateY(4px) rotate(20deg);
    }
    100% {
      transform: translateY(0) rotate(0deg);
    }
  }

  .demo-social__items {
    position: absolute;
    top: 50%;
    left: 50%;

    width: 0;
    height: 0;
  }
  .demo-social__item {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--color-border-soft);
    background: var(--color-surface-2);
    color: var(--color-text);
    text-decoration: none;
    opacity: 0;
    box-shadow: var(--shadow-sm);
    transform: translate(-50%, -50%) scale(0.72);
    transition:
      transform var(--menu-open-duration) cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 120ms ease,
      border-color 120ms ease,
      background-color 120ms ease,
      box-shadow 120ms ease,
      scale 120ms ease;
    pointer-events: none;
  }

  .demo-social__item:hover {
    border-color: var(--color-border);
    background: color-mix(in oklch, var(--color-surface-2) 85%, white 05%);
    box-shadow: var(--shadow-md);
  }

  /* Click demo: solo un press sutil, sin romper el translate del abanico */
  .demo-social__item:active {
    scale: 0.99;
  }

  .demo-social__icon {
    width: 18px;
    height: 18px;
    filter: brightness(0) invert(1);
    opacity: 0;
    transition:
      opacity 180ms ease,
      filter 180ms ease;
  }

  .demo-social__icon--main {
    width: 18px;
    height: 18px;
    opacity: 1;
    filter: brightness(0) invert(1);
  }

  /*
   * OPEN — abanico hacia arriba
   *
   * 0ms   → Email     (arriba-izquierda)
   * 40ms  → LinkedIn  (arriba-centro, el más alto)
   * 80ms  → GitHub    (arriba-derecha)
   */
  .demo-social.is-active .demo-social__item {
    opacity: 1;
    pointer-events: auto;

    transition:
      transform var(--menu-open-duration) cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 180ms ease,
      filter 180ms ease;
  }

  .demo-social.is-active .demo-social__item--1 {
    opacity: 1;
    pointer-events: auto;
    transform: translate(
        calc(-50% - var(--menu-distance-x)),
        calc(-50% + var(--menu-distance-side-y))
      )
      scale(1);
    transition-delay: 0ms;
  }

  .demo-social.is-active .demo-social__item--2 {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, calc(-50% + var(--menu-distance-top-y))) scale(1);
    transition-delay: var(--menu-stagger);
  }

  .demo-social.is-active .demo-social__item--3 {
    opacity: 1;
    pointer-events: auto;
    transform: translate(
        calc(-50% + var(--menu-distance-x)),
        calc(-50% + var(--menu-distance-side-y))
      )
      scale(1);
    transition-delay: calc(var(--menu-stagger) * 2);
  }

  .demo-social.is-active .demo-social__icon {
    opacity: 1;
    filter: brightness(0) invert(1) blur(0);

    transition-delay: 120ms;
  }

  /*
   * CLOSE
   *
   * Los 3 items vuelven a su lugar de origen todos juntos y rápido
   * (sin stagger). Posición y opacidad duran lo mismo para que se
   * los vea deslizarse hacia el centro, no desaparecer de golpe.
   */
  .demo-social.is-closing .demo-social__item {
    opacity: 0;
    pointer-events: none;

    transform: translate(-50%, -50%);

    transition:
      transform 220ms ease-out,
      opacity 220ms ease-out;
  }
</style>
