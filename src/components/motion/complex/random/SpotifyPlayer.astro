---
// src/components/motion/triggers/TriggersHoverClick/SpotifyPlayer.astro
---

<div class="demo-player" data-player>
  <div class="demo-player__info">
    <span class="demo-player__artist">Let It Happen</span>
    <span class="demo-player__track">tame impala</span>
    <div class="demo-player__bar">
      <div class="demo-player__fill"></div>
    </div>
  </div>

  <div class="demo-player__panel">
    <div class="demo-player__art">
      <img src="/tame.jpg" alt="" class="demo-player__img" />
    </div>

    <div class="demo-player__controls">
      <button class="demo-player__btn" aria-label="Anterior">
        <img src="/motion/skip-back.svg" alt="" class="demo-player__ico" />
      </button>

      <button
        class="demo-player__btn"
        data-toggle="play"
        aria-label="Play / Pause"
      >
        <img
          src="/motion/play-pause.svg"
          alt=""
          class="demo-player__ico demo-player__ico--play"
        />
      </button>

      <button class="demo-player__btn" aria-label="Siguiente">
        <img src="/motion/skip-forward.svg" alt="" class="demo-player__ico" />
      </button>
    </div>
  </div>
</div>
<script>
  function init() {
    document
      .querySelectorAll<HTMLElement>('[data-toggle="play"]:not([data-bound])')
      .forEach((btn) => {
        btn.dataset.bound = "true";
        const player = btn.closest<HTMLElement>("[data-player]");

        btn.addEventListener("click", () => {
          player?.classList.toggle("is-active");
        });
      });
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .demo-player {
    position: relative;
    width: 300px;
    max-width: 100%;
    overflow: visible; /* clave: nada recorta la curva del art ni el panel de info */
  }

  /* --- Info bar: más baja, transición lenta y prolija --- */
  .demo-player__info {
    position: absolute;
    height: 57px;
    top: 0;
    left: 10px;
    right: 10px;
    opacity: 0;
    background: var(--color-surface-3);
    padding: 7px 15px 4px 100px;
    border-radius: var(--radius-base);
    transition:
      top 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.6s ease;
    pointer-events: none;
  }

  .demo-player.is-active .demo-player__info {
    top: -57.5px;
    opacity: 1;
  }

  .demo-player__artist {
    display: block;
    color: var(--color-text-heading);
    font-size: var(--text-sm);
    line-height: 1.2;
  }

  .demo-player__track {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    margin-bottom: 6px;
  }

  .demo-player__bar {
    width: 100%;
    height: 2px;
    background: var(--color-border-soft);
    position: relative;
  }

  .demo-player__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 10%;
    background: var(--color-primary);
    animation: player-progress 35s linear infinite;
    animation-play-state: paused;
  }

  .demo-player.is-active .demo-player__fill {
    animation-play-state: running;
  }

  @keyframes player-progress {
    from {
      width: 0%;
    }
    to {
      width: 100%;
    }
  }

  /* --- Panel de control --- */
  .demo-player__panel {
    position: relative;
    z-index: 5;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-base);
    width: 100%;
    max-width: 100%;
    height: 80px;
    overflow: visible;
    box-shadow: var(--shadow-soft-light);
  }

  .demo-player__art {
    position: absolute;
    left: 20px;
    top: -15px;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--color-border-soft);
    box-shadow: 0 0 0 0 transparent;
    transform: scale(1);
    transition:
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.6s ease;
  }

  .demo-player__art::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 15px;
    height: 15px;
    background: var(--color-surface-2);
    border-radius: 50%;
    z-index: 5;
    transform: translate(-50%, -50%);
  }

  .demo-player.is-active .demo-player__art {
    box-shadow: 0 0 20px 5px oklch(0 0 0 / 0.25);
    transform: scale(1.2);
  }

  .demo-player__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .demo-player.is-active .demo-player__img {
    animation: player-spin 3s linear infinite;
  }

  @keyframes player-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .demo-player__controls {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    height: 80px;
    padding: 0 15px;
    gap: 2px;
  }

  .demo-player__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 55px;
    height: 48px;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
    transition: var(--transition-base);
  }

  .demo-player__btn:hover {
    background: var(--color-surface-3);
  }

  .demo-player__ico {
    width: 22px;
    height: 22px;
    display: block;
    filter: brightness(0) invert(1);
  }
  .demo-player__ico--play {
    width: 26px;
    height: 26px;
  }

  @media (max-width: 560px) {
    .demo-player {
      width: 100%;
      max-width: 230px;
      margin-inline: auto;
    }

    .demo-player__art {
      left: 14px;
      width: 70px;
      height: 70px;
      top: -10px;
    }

    .demo-player__info {
      padding-left: 88px;
    }

    .demo-player__controls {
      padding: 0 8px;
      gap: 0;
    }

    .demo-player__btn {
      width: 44px;
      height: 44px;
    }

    .demo-player__ico {
      width: 20px;
      height: 20px;
    }

    .demo-player__ico--play {
      width: 24px;
      height: 24px;
    }
  }
</style>
