---
import "./principles.css";
import PrincipleCard from "./PrincipleCard.astro";
import ComboCard from "./ComboCard.astro";
import MotionBlock from "../../ui/MotionBlock.astro";
import MotionTitle from "../../ui/MotionTitle.astro";
import { principles, comboCards } from "./principles.data";

// Copy lives here (default lang: Spanish).
const copy = {
  es: {
    title: "Intro",
    description:
      "Toda animación en la web parte de principios de movimiento. Podés armar casi cualquier cosa que imagines, desde una transición sutil hasta un efecto interactivo complejo. Por más complejo que se vea, es solo una combinacion de estas bases. ",
    combiningTitle: "Combinando",
    combiningDesc:
      "Algunas animaciones son simplemente la combinación de 2 o más efectos.",
  },
  en: {
    title: "Intro",
    description:
      "Every web animation is built on motion principles. You can create almost anything you imagine, from a subtle transition to a complex interactive effect. No matter how complex it looks, it's just a combination of these basics.",
    combiningTitle: "Combining",
    combiningDesc:
      "Some animations are simply the combination of 2 or more effects.",
  },
} as const;
---

<MotionBlock id="principles" titleEs={copy.es.title} titleEn={copy.en.title}>
  <div class="principles__container">
    <div class="principles__intro">
      <p class="motion-desc lang-es">{copy.es.description}</p>
      <p class="motion-desc lang-en">{copy.en.description}</p>
    </div>

    <div class="principles__grid" data-inview>
      {principles.map((p) => (
        <PrincipleCard principle={p} />
      ))}
    </div>

    <div class="principles__intro">
      <MotionTitle
        level={3}
        id="combining"
        titleEs={copy.es.combiningTitle}
        titleEn={copy.en.combiningTitle}
      />
      <p class="motion-desc lang-es">{copy.es.combiningDesc}</p>
      <p class="motion-desc lang-en">{copy.en.combiningDesc}</p>
    </div>

    <div class="principles__grid" data-inview>
      {comboCards.map((card) => (
        <ComboCard card={card} />
      ))}
    </div>
  </div>
</MotionBlock>

<script>
  import { initPrincipleFlip } from "./principlesFlip";
  initPrincipleFlip();
  document.addEventListener("astro:page-load", () => initPrincipleFlip());
  document.addEventListener("astro:after-swap", () => initPrincipleFlip());
</script>
