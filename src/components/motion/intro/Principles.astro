---
import "./principles.css";
import PrincipleCard from "./PrincipleCard.astro";
import ComboCard from "./ComboCard.astro";
import MotionBlock from "../../ui/MotionBlock.astro";
import MotionTitle from "../../ui/MotionTitle.astro";
import { principles, comboCards } from "./principles.data";

// Copy lives here (default lang: Spanish).
const copy = {
  es: {
    title: "Introducción",
    description:
      "Toda animación en la web puede construirse a partir de unas pocas propiedades y principios visuales.",
    description2:
      'Podés crear <span class="sans-italic-text">casi cualquier cosa que imagines</span>, desde una transición sutil hasta un efecto interactivo complejo. Por más sofisticado que parezca, generalmente es una combinación de estos recursos.',
    combiningTitle: "Combinando",
    combiningDesc:
      "También podés combinarlos para crear efectos más interesantes.",
  },
  en: {
    title: "Introduction",
    description:
      "Every web animation can be built from a few properties and visual principles.",
    description2:
      'You can create almost <span class="sans-italic-text">anything you imagine</span>, from a subtle transition to a complex interactive effect. No matter how sophisticated it looks, it\'s usually a combination of these building blocks.',
    combiningTitle: "Combining",
    combiningDesc:
      "You can even mix and match them to create more interesting effects.",
  },
} as const;
---

<MotionBlock id="principles" titleEs={copy.es.title} titleEn={copy.en.title}>
  <div class="principles__container">
    <div class="principles__intro">
      <p class="motion-desc lang-es">{copy.es.description}</p>
      <p class="motion-desc lang-en">{copy.en.description}</p>
      <p class="motion-desc lang-es" set:html={copy.es.description2} />
      <p class="motion-desc lang-en" set:html={copy.en.description2} />
    </div>

    <div class="principles__grid" data-inview>
      {principles.map((p) => (
        <PrincipleCard principle={p} />
      ))}
    </div>

    <div class="principles__intro">
      <MotionTitle
        id="combining"
        titleEs={copy.es.combiningTitle}
        titleEn={copy.en.combiningTitle}
      />
      <p class="motion-desc lang-es">{copy.es.combiningDesc}</p>
      <p class="motion-desc lang-en">{copy.en.combiningDesc}</p>
    </div>

    <div class="principles__grid" data-inview>
      {comboCards.map((card) => (
        <ComboCard card={card} />
      ))}
    </div>
  </div>
</MotionBlock>

<script>
  import { initPrincipleFlip } from "./principlesFlip";
  initPrincipleFlip();
  document.addEventListener("astro:page-load", () => initPrincipleFlip());
  document.addEventListener("astro:after-swap", () => initPrincipleFlip());
</script>
