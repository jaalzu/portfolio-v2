---
import { translations } from "../../../data/translations";
const t = translations.es;
---

<div class="keyframes-intro">
  <h2
    class="keyframes-intro__title"
    data-i18n="motionPage.keyframesIntro.title"
  >
    {t.motionPage.keyframesIntro.title}
  </h2>

  <p
    class="keyframes-intro__description"
    data-i18n-html="motionPage.keyframesIntro.description"
    set:html={t.motionPage.keyframesIntro.description}
  />
</div>

<style>
  .keyframes-intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: 1rem;
  }

  .keyframes-intro__title {
    margin: 0;
    font-family: var(--font-family-enfasis);
    font-style: italic;
    font-weight: var(--font-weight-medium);
    letter-spacing: normal;
    padding-top: 0.5rem;
    padding-bottom: 0.25rem;
  }

  .keyframes-intro__description {
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: var(--font-weight-light);
    margin: 0;
  }

  .keyframes-intro__description :global(code) {
    font-family: monospace;
    font-size: 0.9em;
    color: var(--color-text-heading);
    background: var(--color-surface-3);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }
</style>
