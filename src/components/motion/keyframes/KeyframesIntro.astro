---
// Copy lives here (default lang: Spanish).
const copy = {
  es: {
    description:
      '<code>transition</code> anima una propiedad <span class="sans-italic-text">de un estado a otro</span>. <code>@keyframes</code> te permite controlar todo el recorrido definiendo <span class="sans-italic-text">distintos estados en porcentajes</span>.',
  },
  en: {
    description:
      '<code>transition</code> animates a property <span class="sans-italic-text">from one state to another</span>. <code>@keyframes</code> lets you control the whole path by defining <span class="sans-italic-text">different states at specific percentages</span>.',
  },
} as const;
---

<div class="keyframes-intro">
  <p
    class="keyframes-intro__description lang-es"
    set:html={copy.es.description}
  />
  <p
    class="keyframes-intro__description lang-en"
    set:html={copy.en.description}
  />
</div>

<style>
  .keyframes-intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: 1rem;
  }

  .keyframes-intro__description {
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: var(--font-weight-light);
    margin: 0;
  }

  .keyframes-intro__description :global(code) {
    font-family: monospace;
    font-size: 0.9em;
    color: var(--color-text-heading);
    background: var(--color-surface-3);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }
</style>
