---
// Copy lives here (default lang: Spanish).
const copy = {
  es: {
    p1: "<code>transition</code> se ejecuta cuando el valor de una propiedad cambia, por ejemplo con <code>:hover</code>. Permite definir cuánto dura ese cambio y cómo se suaviza.",
    p2: "En <code>@keyframes</code>, <code>0%</code> y <code>100%</code> marcan el inicio y el final. Podés agregar porcentajes intermedios para controlar el recorrido y repetir la animación con <code>infinite</code>.",
  },
  en: {
    p1: "A <code>transition</code>  runs when a property value changes, for example on :hover. You define how long the change takes and how it's eased",
    p2: "In <code>@keyframes</code>, <code>0%</code> and <code>100%</code> mark the start and end. You can add intermediate percentages to control the path and repeat the animation with <code>infinite</code>.",
  },
} as const;
---

<div class="keyframes-notes">
  <p class="keyframes-notes__text lang-es" set:html={copy.es.p1} />
  <p class="keyframes-notes__text lang-en" set:html={copy.en.p1} />
  <p class="keyframes-notes__text lang-es" set:html={copy.es.p2} />
  <p class="keyframes-notes__text lang-en" set:html={copy.en.p2} />
</div>

<style>
  .keyframes-notes {
    display: flex;
    margin-top: 1rem;
    flex-direction: column;
    gap: var(--space-3);
  }

  .keyframes-notes__text {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: var(--font-weight-light);
  }

  .keyframes-notes__text :global(code) {
    font-family: monospace;
    font-size: 0.9em;
    color: var(--color-text-heading);
    background: var(--color-surface-3);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }
</style>
