---
// Recorrido por las 4 esquinas + código de @keyframes sincronizado.
// Dos tipos: Keyframes y Transition. Dos modos: Normal (rápido) y Lento.
// Botón de pausa (solo icono, solo en Keyframes).
---

<div class="orbit" data-orbit data-kind="keyframes">
  <div class="orbit-tabs" role="tablist">
    <div class="orbit-types">
      <button
        class="orbit-tab is-active"
        data-orbit-type="keyframes"
        type="button"
      >
        Keyframes
      </button>
      <button class="orbit-tab" data-orbit-type="transition" type="button">
        Transition
      </button>
    </div>

    <div class="orbit-controls">
      <button
        class="orbit-tab orbit-tab--icon"
        data-orbit-mode="normal"
        type="button"
        aria-label="Normal"
        title="Normal"
      >
        <img src="/motion/lightning.svg" alt="" class="orbit-tab__img" />
      </button>
      <button
        class="orbit-tab orbit-tab--icon is-active"
        data-orbit-mode="slow"
        type="button"
        aria-label="Lento"
        title="Lento"
      >
        <img src="/motion/hourglass.svg" alt="" class="orbit-tab__img" />
      </button>
      <button
        class="orbit-tab orbit-tab--icon"
        data-orbit-pause
        type="button"
        aria-label="Pausar"
      >
        <img
          src="/motion/pause.svg"
          alt=""
          class="orbit-tab__icon orbit-tab__icon--pause"
        />
        <img
          src="/motion/play.svg"
          alt=""
          class="orbit-tab__icon orbit-tab__icon--play"
        />
      </button>
    </div>
  </div>

  <div class="orbit-body">
    <!-- Código: @keyframes -->
    <div class="orbit-code" data-orbit-code="keyframes">
      <span class="orbit-line orbit-line--static">@keyframes orbit {"{"}</span>
      <span class="orbit-line orbit-line--indent" data-orbit-line>
        0% {"{"} transform: translate(0, 0); {"}"}
      </span>
      <span class="orbit-line orbit-line--indent" data-orbit-line>
        25% {"{"} transform: translate(<span data-orbit-travel="x">200</span>px,
        0); {"}"}
      </span>
      <span class="orbit-line orbit-line--indent" data-orbit-line>
        50% {"{"} transform: translate(<span data-orbit-travel="x">200</span>px,{" "}
        <span data-orbit-travel="y">200</span>px); {"}"}
      </span>
      <span class="orbit-line orbit-line--indent" data-orbit-line>
        75% {"{"} transform: translate(0, <span data-orbit-travel="y">200</span>
        px); {"}"}
      </span>
      <span class="orbit-line orbit-line--indent" data-orbit-line>
        100% {"{"} transform: translate(0, 0); {"}"}
      </span>
      <span class="orbit-line orbit-line--static">{"}"}</span>
      <span class="orbit-line orbit-line--static orbit-line--gap">
        .box {"{"}
      </span>
      <span class="orbit-line orbit-line--static orbit-line--indent-static">
        animation: orbit <span data-orbit-dur>14s</span> ease-in-out infinite;
      </span>
      <span class="orbit-line orbit-line--static">{"}"}</span>
    </div>

    <!-- Código: transition -->
    <div class="orbit-code" data-orbit-code="transition" hidden>
      <span class="orbit-line orbit-line--static">.box {"{"}</span>
      <span class="orbit-line orbit-line--static orbit-line--indent-static">
        transform: translate(0, 0);
      </span>
      <span class="orbit-line orbit-line--static orbit-line--indent-static">
        transition: transform <span data-orbit-tdur>1.8s</span> ease-in-out;
      </span>
      <span class="orbit-line orbit-line--static">{"}"}</span>
      <span class="orbit-line orbit-line--static orbit-line--gap">
        .box.is-moved {"{"}
      </span>
      <span class="orbit-line orbit-line--static orbit-line--indent-static">
        transform: translate(<span data-orbit-travel="x">200</span>px,{" "}
        <span data-orbit-travel="y">200</span>px);
      </span>
      <span class="orbit-line orbit-line--static">{"}"}</span>
    </div>

    <div class="orbit-stage" data-orbit-stage>
      <div class="orbit-box" data-orbit-box></div>
      <span class="orbit-hint" data-orbit-hint hidden>
        Click
      </span>
    </div>
  </div>
</div>

<script>
  import { initOrbit } from "./keyframesOrbit";

  initOrbit();
  document.addEventListener("astro:page-load", initOrbit);
</script>

<style>
  .orbit {
    --orbit-size: 262px; /* tamaño máximo del stage y alto del código */

    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
  }

  .orbit [hidden] {
    display: none !important;
  }

  .orbit-tabs {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Normal / Lento / Pausa: agrupados a la derecha */
  .orbit-controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }

  .orbit-types {
    display: flex;
    gap: var(--space-2);
  }

  .orbit-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-sm);
    background: var(--color-surface-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    padding: 0 var(--space-3);
    cursor: pointer;
    transition: var(--transition-base);
  }

  /* hover: borde más potente (más claro), sin primary */
  .orbit-tab:hover {
    border-color: var(--color-text-muted);
    color: var(--color-text-heading);
  }

  /* active: tabs de tipo y de modo. El botón de pausa no tiene estado. */
  .orbit-tab.is-active,
  .orbit-tab.is-active:hover {
    color: var(--color-text-heading);
    background: var(--color-surface-3);
  }

  /* --- Botón de pausa: swap pause <-> play con blur --- */
  .orbit-tab--icon {
    position: relative;
    width: 32px;
    padding: 0;
  }

  .orbit-tab__img {
    width: 16px;
    height: 16px;
    filter: brightness(0) invert(1);
    opacity: 0.6;
    transition: opacity 140ms ease;
  }

  .orbit-tab:hover .orbit-tab__img,
  .orbit-tab.is-active .orbit-tab__img {
    opacity: 1;
  }

  .orbit-tab:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .orbit-tab:disabled:hover {
    border-color: var(--color-border-soft);
    color: var(--color-text-muted);
  }

  .orbit-tab__icon {
    position: absolute;
    width: 16px;
    height: 16px;
    filter: brightness(0) invert(1);
    transition:
      opacity 140ms ease,
      transform 140ms ease,
      filter 140ms ease;
  }

  .orbit-tab__icon--pause {
    opacity: 1;
    transform: scale(1);
  }

  .orbit-tab__icon--play {
    opacity: 0;
    transform: scale(0.5);
    filter: brightness(0) invert(1) blur(3px);
    transition-delay: 0ms;
  }

  .orbit-tab--icon.is-paused .orbit-tab__icon--pause {
    opacity: 0;
    transform: scale(0.5);
    filter: brightness(0) invert(1) blur(3px);
  }

  .orbit-tab--icon.is-paused .orbit-tab__icon--play {
    opacity: 1;
    transform: scale(1);
    filter: brightness(0) invert(1) blur(0);
    transition-delay: 40ms;
  }

  .orbit-tab--icon:not(.is-paused) .orbit-tab__icon--pause {
    transition-delay: 40ms;
  }

  .orbit-body {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-4);
  }

  /* --- Código (izquierda) --- */
  .orbit-code {
    box-sizing: border-box;
    flex: 1;
    min-width: min(240px, 100%);
    height: var(--orbit-size);
    display: flex;
    flex-direction: column;
    justify-content: center;
    font-family: monospace;
    font-size: var(--text-xs);
    background: var(--color-surface-3);
    border: 1px solid var(--color-border-softer);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    overflow-x: auto;
  }

  .orbit-line {
    position: relative;
    display: block;
    white-space: pre;
    padding: 1px var(--space-2);
    border-radius: 4px;
    color: var(--color-text-muted);
    transition: none;
  }

  .orbit-line--indent,
  .orbit-line--indent-static {
    padding-left: calc(var(--space-2) + 1.5em);
  }

  .orbit-line--gap {
    margin-top: var(--space-3);
  }

  .orbit-line--static {
    color: var(--color-text);
  }

  /* dot primary: solo aparece en la línea activa */
  .orbit-line--indent::before {
    content: "";
    position: absolute;
    left: var(--space-2);
    top: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
    transform: translateY(-50%) scale(0);
  }

  .orbit-line.is-active {
    color: var(--color-text-heading);
    background: var(--color-surface-1);
    /* prender sí se anima */
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  .orbit-line--indent.is-active::before {
    transform: translateY(-50%) scale(1);
    transition: transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* --- Stage (derecha): cuadrado, máximo 262px --- */
  .orbit-stage {
    box-sizing: border-box;
    position: relative;
    flex-shrink: 0;
    width: 100%;
    max-width: var(--orbit-size);
    aspect-ratio: 1 / 1;
    border: 1px solid var(--color-border-softer);
    border-radius: var(--radius-sm);
    background: var(--color-surface-3);
  }

  .orbit-box {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    z-index: 1;
  }

  /* --- Modo Transition: la caja se mueve con transition + click --- */
  .orbit[data-kind="transition"] .orbit-stage {
    cursor: pointer;
  }

  .orbit[data-kind="transition"] .orbit-box {
    transition: transform var(--tdur, 1.8s) ease-in-out;
  }

  .orbit[data-kind="transition"] .orbit-box.is-moved {
    transform: translate(var(--tx), var(--ty));
  }

  .orbit-hint {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  @media (max-width: 560px) {
    .orbit-stage {
      max-width: none;
      aspect-ratio: auto;
      height: 200px;
    }

    .orbit-code {
      height: auto;
    }

    .orbit-tab {
      padding: 0 var(--space-2);
    }

    .orbit-tab--icon {
      padding: 0;
    }

    /* Los hijos de .orbit-tabs pasan a ser hijos directos de .orbit */
    .orbit-tabs {
      display: contents;
    }

    .orbit-types {
      order: 0;
    }

    .orbit-body {
      order: 1;
    }

    /* Los 3 íconos debajo del preview, centrados */
    .orbit-controls {
      order: 2;
      margin-left: 0;
      width: 100%;
      justify-content: center;
    }
  }
</style>
