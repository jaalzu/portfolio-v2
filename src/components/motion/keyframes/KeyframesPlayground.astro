---
// src/components/motion/keyframes/KeyframesPlayground.astro
// Playground interactivo: elegí el tipo de keyframe y ajustá sus parámetros
// en vivo, igual que el editor de Cubic Bezier.
---

<div class="kf-playground" data-kf-playground>
  <div class="kf-tabs" role="tablist">
    <button class="kf-tab is-active" data-kf-type="pulse" type="button">
      Pulse
    </button>
    <button class="kf-tab" data-kf-type="bounce" type="button">
      Bounce
    </button>
    <button class="kf-tab" data-kf-type="spin" type="button">
      Spin + Fade
    </button>
  </div>

  <div class="kf-stage">
    <div class="kf-preview" data-kf-preview data-type="pulse"></div>
  </div>

  <div class="kf-controls">
    <label class="kf-control">
      <span class="kf-control__label">
        Intensity <span data-kf-intensity-value>30</span>%
      </span>
      <input type="range" min="0" max="100" value="30" data-kf-intensity />
    </label>

    <label class="kf-control">
      <span class="kf-control__label">
        Duration <span data-kf-duration-value>1.5</span>s
      </span>
      <input type="range" min="3" max="40" value="15" data-kf-duration />
    </label>

    <label class="kf-control kf-control--switch">
      <span class="kf-control__label">Infinite</span>
      <input type="checkbox" checked data-kf-infinite />
    </label>
  </div>

  <pre class="kf-code"><code data-kf-code></code></pre>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-kf-playground]");
  if (root) {
    const preview = root.querySelector<HTMLElement>("[data-kf-preview]")!;
    const tabs = root.querySelectorAll<HTMLButtonElement>("[data-kf-type]");
    const intensityInput = root.querySelector<HTMLInputElement>(
      "[data-kf-intensity]",
    )!;
    const durationInput =
      root.querySelector<HTMLInputElement>("[data-kf-duration]")!;
    const infiniteInput =
      root.querySelector<HTMLInputElement>("[data-kf-infinite]")!;
    const intensityLabel = root.querySelector("[data-kf-intensity-value]")!;
    const durationLabel = root.querySelector("[data-kf-duration-value]")!;
    const codeEl = root.querySelector("[data-kf-code]")!;

    const snippets: Record<
      string,
      (intensity: number, dur: number, iter: string) => string
    > = {
      pulse: (i, d, it) => `@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(${(1 + i).toFixed(2)}); }
}

.element {
  animation: pulse ${d}s ease-in-out ${it};
}`,
      bounce: (i, d, it) => `@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-${Math.round(i * 60)}px); }
}

.element {
  animation: bounce ${d}s ease-in-out ${it};
}`,
      spin: (i, d, it) => `@keyframes spin {
  0% { transform: rotate(0deg); opacity: 1; }
  50% { opacity: ${(1 - i).toFixed(2)}; }
  100% { transform: rotate(360deg); opacity: 1; }
}

.element {
  animation: spin ${d}s ease-in-out ${it};
}`,
    };

    function update() {
      const type = preview.dataset.type ?? "pulse";
      const intensity = Number(intensityInput.value) / 100;
      const duration = Number(durationInput.value) / 10;
      const isInfinite = infiniteInput.checked;

      intensityLabel.textContent = intensityInput.value;
      durationLabel.textContent = duration.toFixed(1);

      preview.style.setProperty("--kf-intensity", String(intensity));
      preview.style.setProperty("--kf-duration", `${duration}s`);
      preview.style.setProperty("--kf-iter", isInfinite ? "infinite" : "1");

      codeEl.textContent = snippets[type](
        intensity,
        duration.toFixed(1) as unknown as number,
        isInfinite ? "infinite" : "1",
      );
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((t) => t.classList.remove("is-active"));
        tab.classList.add("is-active");
        preview.dataset.type = tab.dataset.kfType ?? "pulse";
        update();
      });
    });

    [intensityInput, durationInput, infiniteInput].forEach((input) => {
      input.addEventListener("input", update);
    });

    update();
  }
</script>

<style>
  .kf-playground {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
  }

  .kf-tabs {
    display: flex;
    gap: var(--space-2);
  }

  .kf-tab {
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-sm);
    background: var(--color-surface-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
    transition: var(--transition-base);
  }

  .kf-tab.is-active {
    border-color: var(--color-primary);
    color: var(--color-text-heading);
    background: var(--color-surface-3);
  }

  .kf-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100px;
    border: 1px solid var(--color-border-softer);
    border-radius: var(--radius-sm);
    background: var(--color-surface-3);
  }

  .kf-preview {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-primary);
    --kf-intensity: 0.3;
    --kf-duration: 1.5s;
    --kf-iter: infinite;
    animation-duration: var(--kf-duration);
    animation-iteration-count: var(--kf-iter);
    animation-timing-function: ease-in-out;
  }

  .kf-preview[data-type="pulse"] {
    animation-name: kf-pulse;
  }
  .kf-preview[data-type="bounce"] {
    animation-name: kf-bounce;
  }
  .kf-preview[data-type="spin"] {
    animation-name: kf-spin;
  }

  @keyframes kf-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(calc(1 + var(--kf-intensity, 0.3)));
    }
  }

  @keyframes kf-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(calc(-60px * var(--kf-intensity, 0.3)));
    }
  }

  @keyframes kf-spin {
    0% {
      transform: rotate(0deg);
      opacity: 1;
    }
    50% {
      opacity: calc(1 - var(--kf-intensity, 0.3));
    }
    100% {
      transform: rotate(360deg);
      opacity: 1;
    }
  }

  .kf-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .kf-control {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    flex: 1;
    min-width: 140px;
  }

  .kf-control--switch {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-width: 100px;
    flex: 0;
  }

  .kf-control__label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .kf-code {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-text);
    background: var(--color-surface-3);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    overflow-x: auto;
  }
</style>
