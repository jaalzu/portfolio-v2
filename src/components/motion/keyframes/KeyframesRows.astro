---
import KeyframesIntro from "./KeyframesIntro.astro";
import KeyframesOrbit from "./KeyframesOrbit.astro";
import KeyframesNotes from "./KeyframesNotes.astro";
---

<div class="keyframes-rows">
  <KeyframesIntro />
  <div data-inview>
    <KeyframesOrbit />
  </div>
  <KeyframesNotes />
</div>

<style>
  .keyframes-rows {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-base);
    padding-inline: 18px;
    margin-bottom: 2rem;
    padding-block: 1rem 1.5rem;
    background: var(--color-surface-2);
  }
</style>
