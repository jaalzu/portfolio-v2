---
import RenderIntro from "./RenderIntro.astro";
import RenderNotes from "./RenderNotes.astro";
---

<div class="render-rows">
  <RenderIntro />
  <RenderNotes />
</div>

<style>
  .render-rows {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-base);
    padding-inline: 18px;
    padding-block: 1rem 1.5rem;
    background: var(--color-surface-2);
  }
</style>
