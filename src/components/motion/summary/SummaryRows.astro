---
import { translations } from "../../../data/translations";
import MotionBlock from "../../ui/MotionBlock.astro";

const tools: Record<string, { url: string; image: string; name: string }> = {
  motion: {
    url: "https://motion.dev",
    image: "/motion/motion.png",
    name: "Motion",
  },
  gsap: { url: "https://gsap.com", image: "/motion/gsap.ico", name: "GSAP" },
  emil: {
    url: "https://emilkowal.ski",
    image: "/motion/emil.ico",
    name: "Emil Kowalski",
  },
  josh: {
    url: "https://www.joshwcomeau.com/animation/",
    image: "/motion/josh.png",
    name: "Josh W. Comeau",
  },
};

const chip = (key: string) => {
  const x = tools[key];
  return `<a class="summary-tool link" href="${x.url}" target="_blank" rel="noopener noreferrer"><img src="${x.image}" alt="" /><span>${x.name}</span></a>`;
};

// `code` -> <code>code</code>, {motion} -> chip con logo y link
const fmt = (text: string) =>
  text
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\{(\w+)\}/g, (m, k) => (tools[k] ? chip(k) : m));

const langs = ["es", "en"] as const;
const content = langs.map((lang) => {
  const sm = translations[lang].motionPage.summary;
  return {
    lang,
    items: [...sm.points, sm.cssLimit, sm.less].map(fmt),
    outro: fmt(sm.outro),
  };
});

const titleEs = translations.es.motionPage.summary.title;
const titleEn = translations.en.motionPage.summary.title;
---

<MotionBlock id="summary" titleEs={titleEs} titleEn={titleEn}>
  <ul class="summary-rows__list">
    {content.map(({ lang, items }) =>
      items.map((html) => (
        <li class={`summary-rows__item lang-${lang}`} set:html={html} />
      )),
    )}
  </ul>

  {content.map(({ lang, outro }) => (
    <p class={`summary-rows__outro lang-${lang}`} set:html={outro} />
  ))}
</MotionBlock>

<style>
  .summary-rows__list {
    margin: 0;
    padding-left: 1.1em;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .summary-rows__item {
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: var(--font-weight-light);
  }

  .summary-rows__item::marker {
    color: var(--color-primary);
  }

  .summary-rows__outro {
    margin: 0;
    padding-top: 1rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-light);
  }

  .summary-rows__list :global(code) {
    font-family: monospace;
    font-size: 0.9em;
    color: var(--color-text-heading);
    background: var(--color-surface-3);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }

  .summary-rows__list :global(.summary-tool),
  .summary-rows__outro :global(.summary-tool) {
    display: inline;
    white-space: nowrap;
  }

  .summary-rows__list :global(.summary-tool img),
  .summary-rows__outro :global(.summary-tool img) {
    display: inline-block;
    width: 1em;
    height: 1em;
    object-fit: contain;
    vertical-align: -0.2em;
    margin-right: 0.3em;
    margin-left: 0.1em;
  }
</style>
