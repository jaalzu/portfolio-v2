---
import FollowPathExample from "./FollowPathExample.astro";
import DrawPathExample from "./DrawPathExample.astro";
import MorphExample from "./MorphExample.astro";

// Copy lives here (default lang: Spanish).
const copy = {
  es: {
    follow:
      "Un elemento puede seguir una trayectoria definida por un <code>&lt;path&gt;</code>, utilizando su geometría como recorrido.",
    draw: "Podés controlar qué parte de un trazo es visible con <code>stroke-dasharray</code> y <code>stroke-dashoffset</code>, creando el efecto de que una línea se dibuja progresivamente.",
    morph:
      "Un <code>&lt;path&gt;</code> puede transformarse entre distintas formas, permitiendo crear animaciones de morphing.",
  },
  en: {
    follow:
      "An element can follow a trajectory defined by a <code>&lt;path&gt;</code>, using its geometry as the route.",
    draw: "You can control which part of a stroke is visible with <code>stroke-dasharray</code> and <code>stroke-dashoffset</code>, creating the effect of a line being drawn progressively.",
    morph:
      "A <code>&lt;path&gt;</code> can transform between different shapes, allowing you to create morphing animations.",
  },
} as const;
---

<div class="svg-notes">
  <div class="svg-notes__item">
    <FollowPathExample />
    <p class="svg-notes__text lang-es" set:html={copy.es.follow} />
    <p class="svg-notes__text lang-en" set:html={copy.en.follow} />
  </div>

  <div class="svg-notes__item">
    <DrawPathExample />
    <p class="svg-notes__text lang-es" set:html={copy.es.draw} />
    <p class="svg-notes__text lang-en" set:html={copy.en.draw} />
  </div>

  <div class="svg-notes__item">
    <MorphExample />
    <p class="svg-notes__text lang-es" set:html={copy.es.morph} />
    <p class="svg-notes__text lang-en" set:html={copy.en.morph} />
  </div>
</div>

<style>
  .svg-notes {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .svg-notes__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .svg-notes__text {
    margin: 0;
    max-width: 44ch;
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: var(--font-weight-light);
  }

  .svg-notes__text :global(code) {
    font-family: monospace;
    font-size: 0.9em;
    color: var(--color-text-heading);
    background: var(--color-surface-3);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
  }
</style>
