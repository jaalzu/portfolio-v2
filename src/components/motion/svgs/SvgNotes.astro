---
import { translations } from "../../../data/translations";
import FollowPathExample from "./FollowPathExample.astro";
import DrawPathExample from "./DrawPathExample.astro";
import MorphExample from "./MorphExample.astro";

const t = translations.es;
const n = t.motionPage.svgNotes;
---

<div class="svg-notes">
  <div class="svg-notes__item">
    <FollowPathExample />
    <p
      class="svg-notes__text"
      data-i18n-html="motionPage.svgNotes.follow"
      set:html={n.follow}
    />
  </div>

  <div class="svg-notes__item">
    <DrawPathExample />
    <p
      class="svg-notes__text"
      data-i18n-html="motionPage.svgNotes.draw"
      set:html={n.draw}
    />
  </div>

  <div class="svg-notes__item">
    <MorphExample />
    <p
      class="svg-notes__text"
      data-i18n-html="motionPage.svgNotes.morph"
      set:html={n.morph}
    />
  </div>
</div>

<style>
  .svg-notes {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .svg-notes__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .svg-notes__text {
    margin: 0;
    max-width: 44ch;
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: var(--font-weight-light);
  }

  .svg-notes__text :global(code) {
    font-family: monospace;
    font-size: 0.9em;
    color: var(--color-text-heading);
    background: var(--color-surface-3);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
  }
</style>
