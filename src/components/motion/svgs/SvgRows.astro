---
import SvgIntro from "./SvgIntro.astro";
import SvgNotes from "./SvgNotes.astro";
---

<div class="svg-rows">
  <SvgIntro />
  <SvgNotes />
</div>

<style>
  .svg-rows {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-base);
    padding-inline: 18px;
    padding-block: 1rem 1.5rem;
    background: var(--color-surface-2);
  }
</style>
