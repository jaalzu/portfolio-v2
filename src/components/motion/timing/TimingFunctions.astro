---
import MotionBlock from "../../ui/MotionBlock.astro";
import TimingPreview from "./TimingPreview.astro";
import CubicBezier from "./cubic/CubicBezier.astro";

// Copy lives here (default lang: Spanish).
const copy = {
  es: {
    title: "Timing Functions",
    description:
      "Define cómo progresa la animación en el tiempo: acelerando, desacelerando o siguiendo una curva personalizada.",
  },
  en: {
    title: "Timing Functions",
    description:
      "Defines how the animation progresses over time: speeding up, slowing down, or following a custom curve.",
  },
} as const;

const presets = [
  { label: "Linear", x1: 0, y1: 0, x2: 1, y2: 1 },
  { label: "Ease", x1: 0.25, y1: 0.1, x2: 0.25, y2: 1 },
  { label: "Ease-in", x1: 0.42, y1: 0, x2: 1, y2: 1 },
  { label: "Ease-out", x1: 0, y1: 0, x2: 0.58, y2: 1 },
  { label: "Ease-in-out", x1: 0.42, y1: 0, x2: 0.58, y2: 1 },
];
---

<MotionBlock id="timing" titleEs={copy.es.title} titleEn={copy.en.title}>
  <section class="timing" data-timing>
    <p class="timing__description lang-es">{copy.es.description}</p>
    <p class="timing__description lang-en">{copy.en.description}</p>

    <div class="timing__presets">
      {presets.map((preset) => (
        <TimingPreview
          label={preset.label}
          x1={preset.x1}
          y1={preset.y1}
          x2={preset.x2}
          y2={preset.y2}
        />
      ))}
    </div>

    <CubicBezier />
  </section>
</MotionBlock>

<style>
  .timing {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .timing__description {
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: var(--font-weight-light);
    margin: 0;
  }

  .timing__presets {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    width: 100%;
  }
</style>
