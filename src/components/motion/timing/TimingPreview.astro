---
interface Props {
  label: string;
  x1: number;
  y1: number;
  x2: number;
  y2: number;
  duration?: number;
}

const { label, x1, y1, x2, y2, duration = 2.2 } = Astro.props;
const easing = `cubic-bezier(${x1}, ${y1}, ${x2}, ${y2})`;
---

<div
  class="timing-preview"
  data-timing-preview
  data-easing={easing}
  data-duration={duration}
>
  <div class="timing-preview__track">
    <div class="timing-preview__line" aria-hidden="true"></div>

    <span class="timing-preview__dot" data-dot></span>
  </div>

  <span class="timing-preview__label">{label}</span>
</div>

<script>
  function init() {
    const previews = document.querySelectorAll<HTMLElement>(
      "[data-timing-preview]",
    );

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (prefersReducedMotion) return;

    previews.forEach((preview) => {
      // evita enganchar dos veces el mismo elemento
      if (preview.dataset.bound === "1") return;
      preview.dataset.bound = "1";

      const dot = preview.querySelector<HTMLElement>("[data-dot]");
      const easing = preview.dataset.easing;
      const duration = Number(preview.dataset.duration) || 1.6;

      if (!dot || !easing) return;

      function play() {
        if (!dot) return;

        const dotSize = dot.getBoundingClientRect().width || 10;

        dot.getAnimations().forEach((a) => a.cancel());

        dot.animate([{ left: "0px" }, { left: `calc(100% - ${dotSize}px)` }], {
          duration: duration * 1000,
          easing,
          direction: "alternate",
          iterations: Infinity,
        });
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const running = dot.getAnimations();
              if (running.length) running.forEach((a) => a.play());
              else play();
            } else {
              dot.getAnimations().forEach((a) => a.pause());
            }
          });
        },
        { threshold: 0.2 },
      );

      observer.observe(preview);

      window.addEventListener("resize", () => {
        if (dot.getAnimations().length) play();
      });
    });
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>

<style>
  /* Layout unificado: el que antes era solo para mobile/tablet ahora aplica siempre */
  .timing-preview {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    margin-top: 0.3rem;
    width: 100%;
  }

  .timing-preview__track {
    position: relative;
    width: 100%;
    max-width: 220px;
    height: 34px;
  }

  .timing-preview__line {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 15.5px;
    border-radius: var(--radius-full);
    background: var(--color-border-soft);
  }

  .timing-preview__dot {
    position: absolute;
    left: 0;
    top: calc(50% - 7px);
    width: 14px;
    height: 14px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
  }

  .timing-preview__label {
    order: -1;
    color: var(--color-text-heading);
    font-size: var(--text-sm);
    text-align: left;
  }
</style>
