---
import { translations } from "../../../../data/translations";
const t = translations.es;
---

<div class="bezier__right">
  <span class="bezier__preview-label" data-i18n="motionPage.cubic.preview">{t.motionPage.cubic.preview}</span>

  <div class="bezier__preview-track">
    <svg
      class="bezier__preview-line"
      viewBox="0 0 100 40"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <line x1="0" y1="40" x2="100" y2="0" vector-effect="non-scaling-stroke" />
    </svg>

    <span class="bezier__preview-dot" data-dot></span>
  </div>
</div>

<style>
  .bezier__right {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  .bezier__preview-label {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .bezier__preview-track {
    position: relative;
    width: 100%;
    max-width: 187px;
    height: 225px;
  }

  .bezier__preview-line {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .bezier__preview-line line {
    stroke: var(--color-border-soft);
    stroke-width: 1.5;
  }

  .bezier__preview-dot {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 17px;
    height: 17px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    transform: translate(0, 0);
  }

  @media (max-width: 560px) {
    .bezier__right {
      width: 100%;
    }

    .bezier__preview-track {
      max-width: none;
      height: 160px;
    }
  }
</style>
