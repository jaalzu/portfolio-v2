---
// src/components/motion/cubic/BezierValues.astro
interface Props {
  x1: number;
  y1: number;
  x2: number;
  y2: number;
}

const { x1, y1, x2, y2 } = Astro.props;
---

<div class="bezier__values">
  <label class="bezier__field">
    <span>x1</span>

    <input
      data-input="x1"
      type="number"
      min="0"
      max="1"
      step="0.01"
      value={x1}
      inputmode="decimal"
      aria-label="x1"
    />
  </label>

  <label class="bezier__field">
    <span>y1</span>

    <input
      data-input="y1"
      type="number"
      step="0.01"
      value={y1}
      inputmode="decimal"
      aria-label="y1"
    />
  </label>

  <label class="bezier__field">
    <span>x2</span>

    <input
      data-input="x2"
      type="number"
      min="0"
      max="1"
      step="0.01"
      value={x2}
      inputmode="decimal"
      aria-label="x2"
    />
  </label>

  <label class="bezier__field">
    <span>y2</span>

    <input
      data-input="y2"
      type="number"
      step="0.01"
      value={y2}
      inputmode="decimal"
      aria-label="y2"
    />
  </label>
</div>

<style>
  .bezier__values {
    display: flex;
    justify-content: space-evenly;
    gap: var(--space-2);
    width: 100%;
    margin-top: var(--space-3);
  }

  .bezier__field {
    display: flex;
    flex-direction: column;
    text-align: center;
    width: 65px;
  }

  .bezier__field span {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .bezier__field input {
    width: 100%;
    min-width: 0;
    border: 1px solid var(--color-border-softer);
    border-radius: var(--radius-sm);
    background: var(--color-surface-3);
    color: var(--color-text-heading);
    font-family: monospace;
    font-size: var(--text-sm);
    outline: none;
    padding: 0.35rem 0.4rem;
    transition: border-color var(--transition-fast);
  }

  .bezier__field input:hover {
    border-color: var(--color-border);
  }

  .bezier__field input:focus-visible {
    border-color: var(--color-focus);
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  @media (max-width: 560px) {
    .bezier__values {
      flex-wrap: wrap;
    }

    .bezier__field {
      width: calc(50% - var(--space-2));
    }
  }
</style>
