---
// src/components/motion/cubic/CubicBezier.astro
import CopyButton from "../../../ui/CopyButton.astro";
import BezierGraph from "./BezierGraph.astro";
import BezierPreview from "./BezierPreview.astro";
import BezierValues from "./BezierValues.astro";
import { translations } from "../../../../data/translations";

const t = translations.es;

const initialValues = { x1: 0.25, y1: 0.1, x2: 0.25, y2: 1 };
const initialDuration = 1.8;
const initialCss = `.element {\n  transition: transform ${initialDuration}s cubic-bezier(${initialValues.x1}, ${initialValues.y1}, ${initialValues.x2}, ${initialValues.y2});\n}`;

const presets = [
  { label: "linear", x1: 0, y1: 0, x2: 1, y2: 1 },
  { label: "ease", x1: 0.25, y1: 0.1, x2: 0.25, y2: 1 },
  { label: "ease-in", x1: 0.42, y1: 0, x2: 1, y2: 1 },
  { label: "ease-out", x1: 0, y1: 0, x2: 0.58, y2: 1 },
  { label: "ease-in-out", x1: 0.42, y1: 0, x2: 0.58, y2: 1 },
];
---

<div class="bezier" data-bezier>
  <div class="bezier__header">
    <h3 class="bezier__title" data-i18n="motionPage.cubic.title">{t.motionPage.cubic.title}</h3>

    <p class="bezier__description" data-i18n="motionPage.cubic.description">
      {t.motionPage.cubic.description}
    </p>
  </div>

  <!-- ============================================================
       TOOLBAR — presets a la izquierda, Duration + Play a la derecha
       ============================================================ -->

  <div class="bezier__toolbar">
    <div class="bezier__presets">
      {presets.map((preset) => (
        <button
          class="bezier__preset"
          type="button"
          data-preset={JSON.stringify([
            preset.x1,
            preset.y1,
            preset.x2,
            preset.y2,
          ])}
        >
          {preset.label}
        </button>
      ))}
    </div>

    <div class="bezier__toolbar-right">
      <label class="bezier__duration">
        <span data-i18n="motionPage.cubic.duration">{t.motionPage.cubic.duration}</span>

        <input
          data-duration
          type="number"
          min="0.1"
          max="10"
          step="0.1"
          value={initialDuration}
          inputmode="decimal"
          aria-label="Animation duration"
        />

        <span>s</span>
      </label>

      <button
        class="bezier__play"
        type="button"
        data-play
        aria-label="Play animation"
      >
        <svg viewBox="0 0 256 256" aria-hidden="true">
          <path d="M232.4 114.49 88.32 26.35a16 16 0 0 0-16.2-.3A15.86 15.86 0 0 0 64 39.87v176.26A15.94 15.94 0 0 0 80 232a16.07 16.07 0 0 0 8.36-2.35l144.04-88.14a15.81 15.81 0 0 0 0-27.02ZM80 215.94V40l143.83 88Z" />
        </svg>
        <span data-i18n="motionPage.cubic.play">{t.motionPage.cubic.play}</span>
      </button>
    </div>
  </div>

  <div class="bezier__workspace">
    <BezierGraph />
    <BezierPreview />
  </div>

  <BezierValues
    x1={initialValues.x1}
    y1={initialValues.y1}
    x2={initialValues.x2}
    y2={initialValues.y2}
  />

  <!-- ============================================================
       CODE BLOCK — CSS generado, header chico
       ============================================================ -->

  <div class="bezier__code">
    <div class="bezier__code-header">
      <span class="bezier__code-title">css</span>

      <div class="bezier__code-copy" data-copy-wrapper>
        <CopyButton text={initialCss} label={t.motionPage.cubic.copyLabel} />
      </div>
    </div>

    <pre class="bezier__code-block"><code data-css-output>{initialCss}</code></pre>
  </div>

  <!-- ============================================================
       EXPLANATION
       ============================================================ -->

  <p class="bezier__note" data-i18n-html="motionPage.cubic.note">
    <code>cubic-bezier()</code> define cómo progresa una animación entre su
    inicio y su final. <code>x1</code> y <code>x2</code> determinan cuándo
    cambia la velocidad, mientras que <code>y1</code> y <code>y2</code>
    determinan cuánto acelera o desacelera.
  </p>
</div>

<script>
  // Nota: aunque el graph, el preview y los inputs viven en componentes
  // separados (BezierGraph / BezierPreview / BezierValues), Astro los
  // renderiza todos dentro del mismo <div data-bezier>, así que este
  // script los sigue encontrando con querySelector normal.
  const editors = document.querySelectorAll<HTMLElement>("[data-bezier]");

  editors.forEach((editor) => {
    const graph = editor.querySelector<SVGSVGElement>(".bezier__graph");
    const curve = editor.querySelector<SVGPathElement>("[data-curve]");

    const handle1 = editor.querySelector<SVGCircleElement>('[data-handle="1"]');

    const handle2 = editor.querySelector<SVGCircleElement>('[data-handle="2"]');

    const line1 = editor.querySelector<SVGLineElement>('[data-line="1"]');

    const line2 = editor.querySelector<SVGLineElement>('[data-line="2"]');

    const track = editor.querySelector<HTMLElement>(".bezier__preview-track");
    const dot = editor.querySelector<HTMLElement>("[data-dot]");

    const play = editor.querySelector<HTMLButtonElement>("[data-play]");

    const duration = editor.querySelector<HTMLInputElement>("[data-duration]");

    const codeOutput = editor.querySelector<HTMLElement>("[data-css-output]");

    const copyWrapper = editor.querySelector<HTMLElement>(
      "[data-copy-wrapper]",
    );

    const presetButtons =
      editor.querySelectorAll<HTMLButtonElement>("[data-preset]");

    if (
      !graph ||
      !curve ||
      !handle1 ||
      !handle2 ||
      !line1 ||
      !line2 ||
      !track ||
      !dot ||
      !play ||
      !duration
    ) {
      return;
    }

    const values = {
      x1: 0.25,
      y1: 0.1,
      x2: 0.25,
      y2: 1,
    };

    let activeHandle: "1" | "2" | null = null;

    const inputs = {
      x1: editor.querySelector<HTMLInputElement>('[data-input="x1"]'),
      y1: editor.querySelector<HTMLInputElement>('[data-input="y1"]'),
      x2: editor.querySelector<HTMLInputElement>('[data-input="x2"]'),
      y2: editor.querySelector<HTMLInputElement>('[data-input="y2"]'),
    };

    function clamp(value: number, min: number, max: number) {
      return Math.min(Math.max(value, min), max);
    }

    function format(value: number) {
      return Number(value.toFixed(2));
    }

    function getBezierString() {
      return `cubic-bezier(${values.x1}, ${values.y1}, ${values.x2}, ${values.y2})`;
    }

    function buildCssSnippet(seconds: number) {
      return `.element {\n  transition: transform ${seconds}s cubic-bezier(${format(values.x1)}, ${format(values.y1)}, ${format(values.x2)}, ${format(values.y2)});\n}`;
    }

    function updateInputs() {
      Object.entries(inputs).forEach(([key, input]) => {
        if (!input) return;

        input.value = String(format(values[key as keyof typeof values]));
      });
    }

    function updateCodeBlock() {
      const seconds = clamp(Number(duration.value) || 1.8, 0.1, 10);
      const snippet = buildCssSnippet(seconds);

      if (codeOutput) {
        codeOutput.textContent = snippet;
      }

      if (copyWrapper) {
        const copyButton =
          copyWrapper.querySelector<HTMLElement>("[data-copy]");

        if (copyButton) {
          copyButton.dataset.copy = snippet;
        }
      }
    }

    function updateCurve() {
      const p1x = values.x1 * 100;
      const p1y = 100 - values.y1 * 100;

      const p2x = values.x2 * 100;
      const p2y = 100 - values.y2 * 100;

      curve.setAttribute("d", `M 0 100 C ${p1x} ${p1y}, ${p2x} ${p2y}, 100 0`);

      handle1.setAttribute("cx", String(p1x));
      handle1.setAttribute("cy", String(p1y));

      handle2.setAttribute("cx", String(p2x));
      handle2.setAttribute("cy", String(p2y));

      line1.setAttribute("x2", String(p1x));
      line1.setAttribute("y2", String(p1y));

      line2.setAttribute("x2", String(p2x));
      line2.setAttribute("y2", String(p2y));

      updateInputs();
      updateCodeBlock();
    }

    function pointerToValues(event: PointerEvent) {
      if (!activeHandle) return;

      const rect = graph.getBoundingClientRect();

      const svgX = ((event.clientX - rect.left) / rect.width) * 116 - 8;
      const svgY = ((event.clientY - rect.top) / rect.height) * 116 - 8;

      const x = clamp(svgX / 100, 0, 1);
      const y = 1 - svgY / 100;

      if (activeHandle === "1") {
        values.x1 = x;
        values.y1 = y;
      } else {
        values.x2 = x;
        values.y2 = y;
      }

      updateCurve();
    }

    function startDrag(handle: SVGCircleElement, event: PointerEvent) {
      activeHandle = handle.dataset.handle === "1" ? "1" : "2";

      handle.setPointerCapture(event.pointerId);

      event.preventDefault();
    }

    function stopDrag() {
      activeHandle = null;
    }

    handle1.addEventListener("pointerdown", (event) => {
      startDrag(handle1, event);
    });

    handle2.addEventListener("pointerdown", (event) => {
      startDrag(handle2, event);
    });

    graph.addEventListener("pointermove", pointerToValues);
    graph.addEventListener("pointerup", stopDrag);
    graph.addEventListener("pointercancel", stopDrag);

    Object.entries(inputs).forEach(([key, input]) => {
      if (!input) return;

      input.addEventListener("input", () => {
        const value = Number(input.value);

        if (!Number.isFinite(value)) return;

        if (key === "x1" || key === "x2") {
          values[key] = clamp(value, 0, 1);
        } else {
          values[key] = value;
        }

        updateCurve();
      });
    });

    duration.addEventListener("input", updateCodeBlock);

    /*
     * Presets — ease, ease-in, ease-out, ease-in-out, linear
     */

    presetButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const raw = button.dataset.preset;

        if (!raw) return;

        try {
          const [x1, y1, x2, y2] = JSON.parse(raw) as number[];

          values.x1 = x1;
          values.y1 = y1;
          values.x2 = x2;
          values.y2 = y2;

          updateCurve();
        } catch {
          // ignore malformed preset
        }
      });
    });

    function keyboardMove(handle: SVGCircleElement, event: KeyboardEvent) {
      const key = handle.dataset.handle;

      if (key !== "1" && key !== "2") return;

      const step = event.shiftKey ? 0.1 : 0.01;

      const xKey = key === "1" ? "x1" : "x2";
      const yKey = key === "1" ? "y1" : "y2";

      let changed = false;

      if (event.key === "ArrowRight") {
        values[xKey] = clamp(values[xKey] + step, 0, 1);
        changed = true;
      }

      if (event.key === "ArrowLeft") {
        values[xKey] = clamp(values[xKey] - step, 0, 1);
        changed = true;
      }

      if (event.key === "ArrowUp") {
        values[yKey] += step;
        changed = true;
      }

      if (event.key === "ArrowDown") {
        values[yKey] -= step;
        changed = true;
      }

      if (changed) {
        event.preventDefault();
        updateCurve();
      }
    }

    handle1.addEventListener("keydown", (event) => {
      keyboardMove(handle1, event);
    });

    handle2.addEventListener("keydown", (event) => {
      keyboardMove(handle2, event);
    });

    function playAnimation() {
      const seconds = clamp(Number(duration.value) || 1.8, 0.1, 10);

      duration.value = String(seconds);
      updateCodeBlock();

      dot.getAnimations().forEach((animation) => {
        animation.cancel();
      });

      const dotRect = dot.getBoundingClientRect();
      const trackRect = track.getBoundingClientRect();
      const dotSize = dotRect.width || 16;

      const travelX = Math.max(trackRect.width - dotSize, 0);
      const travelY = Math.max(trackRect.height - dotSize, 0);

      dot.animate(
        [
          { transform: "translate(0, 0)" },
          { transform: `translate(${travelX}px, -${travelY}px)` },
        ],
        {
          duration: seconds * 1000,
          easing: getBezierString(),
          fill: "forwards",
        },
      );
    }

    play.addEventListener("click", playAnimation);

    updateCurve();
  });
</script>

<style>
  .bezier {
    width: 100%;
    padding-top: var(--space-5);
  }

  .bezier__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-5);
  }

  .bezier__title {
    margin: 0;
    font-weight: var(--font-weight-medium);
    padding-top: 0.5rem;
    padding-bottom: 0.25rem;
  }

  .bezier__description {
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: var(--font-weight-light);
    border-radius: var(--radius-base);
    margin-top: 5px;
    margin-bottom: 0;
  }

  /* ================================================================
     TOOLBAR — presets izq, Duration + Play der, fila propia
     ================================================================ */

  .bezier__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    width: 100%;
    border-bottom: 1px solid var(--color-border-softer);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .bezier__presets {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
  }

  .bezier__preset {
    border: none;
    background: var(--color-surface-3);

    border: 1px solid var(--color-border-softer);
    padding: 0.35rem 0.45rem;

    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-family: monospace;
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .bezier__preset:hover,
  .bezier__preset:focus-visible {
    border: 1px solid var(--color-border);
  }

  .bezier__preset:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: 2px;
  }

  .bezier__toolbar-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .bezier__duration {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.1px;
  }

  .bezier__duration input {
    width: 62px;
    padding: 0.35rem 0.4rem;
    border: 1px solid var(--color-border-softer);
    border-radius: var(--radius-sm);
    background: var(--color-surface-3);

    color: var(--color-text-heading);
    font-family: monospace;
    font-size: var(--text-sm);
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .bezier__duration input:hover {
    border-color: var(--color-border);
  }

  .bezier__duration input:focus-visible {
    border-color: var(--color-focus);
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .bezier__play {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    border: 1px solid var(--color-border-softer);
    border-radius: var(--radius-sm);
    padding: 0.35rem 0.7rem;
    background: var(--color-surface-3);
    color: var(--color-text-heading);
    font: inherit;
    font-size: var(--text-xs);
    cursor: pointer;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .bezier__play:hover {
    border-color: var(--color-primary-soft);
  }

  .bezier__play:active {
    opacity: 0.9;
  }

  .bezier__play:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .bezier__play svg {
    width: 11.5px;
    height: 11.5px;
    fill: currentColor;
  }

  /* ================================================================
     WORKSPACE — gráfico a la izquierda, preview centrado a la derecha
     ================================================================ */

  .bezier__workspace {
    display: flex;
    align-items: stretch;
    gap: var(--space-3);
    width: 100%;
  }

  /* ================================================================
     CODE BLOCK — header chico
     ================================================================ */

  .bezier__code {
    width: 100%;
    margin-top: var(--space-5);
    border: 1px solid var(--color-border-softer);
    border-radius: var(--radius-base);

    background: var(--color-surface-3);
    overflow: hidden;
  }

  .bezier__code-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-1) var(--space-2);
    border-bottom: 1px solid var(--color-border-softer);
  }

  .bezier__code-title {
    color: var(--color-text-muted);
    font-family: monospace;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .bezier__code-copy {
    position: relative;
    width: 27px;
    height: 27px;
    transform: scale(0.91);
    transform-origin: center right;
  }

  .bezier__code-block {
    margin: 0;
    padding: var(--space-3);
    overflow-x: auto;
  }

  .bezier__code-block code {
    display: block;
    color: var(--color-text);
    font-family: monospace;
    font-size: var(--text-xs);
    white-space: pre;
  }

  /* ================================================================
     NOTE
     ================================================================ */

  .bezier__note {
    width: 100%;
    margin: var(--space-5) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-base);
    font-weight: var(--font-weight-light);
    line-height: var(--leading-relaxed);
  }

  .bezier__note code {
    color: var(--color-text-heading);
    font-family: monospace;
    padding-inline: 1px;
    font-size: var(--text-base);
  }

  @media (max-width: 560px) {
    .bezier__toolbar {
      flex-wrap: wrap;
    }

    .bezier__workspace {
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bezier__play,
    .bezier__preset,
    .bezier__duration input {
      transition: none;
    }
  }
</style>
