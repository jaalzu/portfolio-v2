---
import TriggerCard from "./TriggerCard.astro";
---

<div class="triggers-group">
  <h3 class="triggers-group__title">Click</h3>
  <div class="triggers-group__cards">
    <TriggerCard label="Toggle">
      <label class="switch">
        <input type="checkbox" aria-label="Toggle" />
        <span class="slider"></span>
      </label>
    </TriggerCard>

    <TriggerCard label="Ripple">
      <button class="demo-ripple" data-toggle="ripple">
        Click
        <span class="demo-ripple__layer"></span>
        <span class="demo-ripple__layer"></span>
      </button>
    </TriggerCard>

    <TriggerCard label="Rotation">
      <button class="demo-chevron" data-toggle="simple" aria-label="Toggle">
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M6 9l6 6 6-6" />
        </svg>
      </button>
    </TriggerCard>
  </div>
</div>

<script>
  function init() {
    document
      .querySelectorAll<HTMLElement>('[data-toggle="simple"]:not([data-bound])')
      .forEach((el) => {
        el.dataset.bound = "true";
        el.addEventListener("click", () => el.classList.toggle("is-active"));
      });

    document
      .querySelectorAll<HTMLButtonElement>(
        '[data-toggle="ripple"]:not([data-bound])',
      )
      .forEach((btn) => {
        btn.dataset.bound = "true";
        const layers = btn.querySelectorAll<HTMLElement>(".demo-ripple__layer");
        let next = 0;

        btn.addEventListener("click", () => {
          const layer = layers[next];
          next = (next + 1) % layers.length;

          layer.classList.remove("is-pop");
          void layer.offsetWidth;
          layer.classList.add("is-pop");
        });

        layers.forEach((layer) => {
          layer.addEventListener("animationend", () =>
            layer.classList.remove("is-pop"),
          );
        });
      });
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .triggers-group {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: var(--space-3);
  }

  .triggers-group__title {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .triggers-group__cards {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: center;
    gap: var(--space-12);
    padding-left: var(--space-2);
    overflow: visible;
  }

  /* --- Toggle (Uiverse by gharsh11032000, adaptado a tokens) --- */
  .switch {
    position: relative;
    display: inline-flex;
    align-items: center;
    width: 44px;
    height: 22px;
    cursor: pointer;
  }

  .switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .slider {
    position: absolute;
    cursor: pointer;
    inset: 0;
    border: 2px solid var(--color-border-soft);
    border-radius: var(--radius-full);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .slider::before {
    position: absolute;
    content: "";
    height: 14px;
    width: 14px;
    left: 2px;
    bottom: 2px;
    background-color: var(--color-text-heading);
    border-radius: inherit;
    transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .switch input:checked + .slider {
    box-shadow: 0 0 12px var(--color-primary-soft);
    border-color: var(--color-primary);
  }

  .switch input:checked + .slider::before {
    transform: translateX(20px);
  }

  @media (prefers-reduced-motion: reduce) {
    .slider,
    .slider::before {
      transition: none;
    }
  }

  /* --- Ripple --- */
  .demo-ripple {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-sm);
    background: var(--color-surface-2);
    color: var(--color-text);
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
  }
  .demo-ripple__layer {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: oklch(1 0 0 / 0.5);
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
    pointer-events: none;
  }
  .demo-ripple__layer.is-pop {
    animation: ripple-burst 0.5s ease-out;
  }
  @keyframes ripple-burst {
    0% {
      transform: translate(-50%, -50%) scale(0);
      opacity: 0.6;
    }
    100% {
      transform: translate(-50%, -50%) scale(14);
      opacity: 0;
    }
  }

  /* --- Rotation --- */
  .demo-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-full);
    background: var(--color-surface-2);
    color: var(--color-text);
    cursor: pointer;
    transition: var(--transition-base);
  }
  .demo-chevron.is-active {
    transform: rotate(180deg);
  }
</style>
