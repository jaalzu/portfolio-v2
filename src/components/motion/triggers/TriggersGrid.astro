---
import TriggersHover from "./TriggersHover.astro";
import TriggersClick from "./TriggersClick.astro";
import TriggersHoverClick from "./hoverclick/TriggersHoverClick.astro";
import TriggersHoverScroll from "./TriggersHoverScroll.astro";
---

<div class="triggers-grid">
  <TriggersHover />
  <TriggersClick />
  <TriggersHoverClick />
  <TriggersHoverScroll />
</div>

<style>
  .triggers-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
</style>
