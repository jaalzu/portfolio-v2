---
---

<div class="demo-social">
  <div class="demo-social__items">
    <a
      href="#"
      class="demo-social__item demo-social__item--1"
      aria-label="Email"
    >
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 7 9 6 9-6" />
      </svg>
    </a>

    <a
      href="#"
      class="demo-social__item demo-social__item--2"
      aria-label="LinkedIn"
    >
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <rect x="4" y="4" width="16" height="16" rx="2" />
        <line x1="8" y1="11" x2="8" y2="16" />
        <line x1="8" y1="8" x2="8" y2="8" />
        <path d="M12 16v-3a2 2 0 0 1 4 0v3" />
      </svg>
    </a>

    <a
      href="#"
      class="demo-social__item demo-social__item--3"
      aria-label="GitHub"
    >
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M12 2a10 10 0 0 0-3.16 19.5c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.9-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .26.18.58.69.48A10 10 0 0 0 12 2z" />
      </svg>
    </a>
  </div>

  <button
    class="demo-social__main"
    data-toggle="group"
    data-toggle-target=".demo-social"
    aria-label="Compartir"
    aria-expanded="false"
  >
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <line x1="12" y1="5" x2="12" y2="19" />
      <line x1="5" y1="12" x2="19" y2="12" />
    </svg>
  </button>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-toggle="group"]')
    .forEach((el) => {
      const selector = el.dataset.toggleTarget;
      const target = selector ? el.closest<HTMLElement>(selector) : el;

      if (!target) return;

      el.addEventListener("click", () => {
        const isOpen = target.classList.contains("is-active");

        if (isOpen) {
          target.classList.remove("is-active");
          target.classList.add("is-closing");
          el.setAttribute("aria-expanded", "false");

          window.setTimeout(() => {
            target.classList.remove("is-closing");
          }, 500);
        } else {
          target.classList.remove("is-closing");
          target.classList.add("is-active");
          el.setAttribute("aria-expanded", "true");
        }
      });
    });
</script>

<style>
  .demo-social {
    /* Abanico hacia arriba: los 3 items salen por encima del botón */
    --menu-distance-x: 54px;
    --menu-distance-side-y: -46px;
    --menu-distance-top-y: -80px;

    --menu-open-duration: 420ms;
    --menu-close-duration: 360ms;
    --menu-stagger: 100ms;

    position: relative;
    width: 44px;
    height: 44px;
    margin-bottom: 54px;
  }

  .demo-social__main {
    position: relative;
    z-index: 2;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 44px;
    height: 44px;

    border: 1px solid var(--color-border-soft);
    border-radius: 50%;

    background: var(--color-surface-2);
    color: var(--color-text);

    cursor: pointer;

    /* Capa de composición propia: evita que el navegador redondee
       el trazo del ícono en sub-píxeles distintos frame a frame
       mientras rota/traslada, que es lo que se veía como un
       "salto" de tamaño en el ícono a ciertos niveles de zoom. */
    will-change: transform;
    backface-visibility: hidden;

    transition:
      transform 250ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 120ms ease,
      border-color 120ms ease,
      color 120ms ease;
  }

  .demo-social.is-active .demo-social__main {
    transform: rotate(45deg);
    background: var(--color-primary);
    color: var(--color-text-heading);
    border-color: var(--color-primary);
  }

  /*
   * CLOSE IMPACT
   *
   * El botón recibe el "golpe" de los 3 items volviendo: se empuja
   * hacia abajo y rebota de vuelta a su posición, un solo impacto.
   */
  /*
   * CLOSE IMPACT
   *
   * translateY va ANTES de rotate en la lista de transforms: así el
   * desplazamiento ocurre en el eje vertical de pantalla (recto hacia
   * abajo), sin mezclarse con el eje ya rotado. Un rebote leve, no
   * exagerado.
   */
  .demo-social.is-closing .demo-social__main {
    transition: none;
    animation: demo-social-bounce 480ms ease-out forwards;
  }

  @keyframes demo-social-bounce {
    0% {
      transform: translateY(0) rotate(45deg);
    }
    30% {
      transform: translateY(4px) rotate(20deg);
    }
    100% {
      transform: translateY(0) rotate(0deg);
    }
  }

  .demo-social__items {
    position: absolute;
    top: 50%;
    left: 50%;

    width: 0;
    height: 0;
  }
  .demo-social__item {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--color-border-soft);
    background: var(--color-surface-2);
    color: var(--color-text);
    text-decoration: none;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.72);
    transition:
      transform var(--menu-open-duration) cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 120ms ease;
    pointer-events: none;
  }

  .demo-social__item svg {
    opacity: 0;
    filter: blur(4px);

    transition:
      opacity 180ms ease,
      filter 180ms ease;
  }

  /*
   * OPEN — abanico hacia arriba
   *
   * 0ms   → Email     (arriba-izquierda)
   * 40ms  → LinkedIn  (arriba-centro, el más alto)
   * 80ms  → GitHub    (arriba-derecha)
   */
  .demo-social.is-active .demo-social__item {
    opacity: 1;
    pointer-events: auto;

    transition:
      transform var(--menu-open-duration) cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 180ms ease,
      filter 180ms ease;
  }

  .demo-social.is-active .demo-social__item--1 {
    opacity: 1;
    pointer-events: auto;
    transform: translate(
        calc(-50% - var(--menu-distance-x)),
        calc(-50% + var(--menu-distance-side-y))
      )
      scale(1);
    transition-delay: 0ms;
  }

  .demo-social.is-active .demo-social__item--2 {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, calc(-50% + var(--menu-distance-top-y))) scale(1);
    transition-delay: var(--menu-stagger);
  }

  .demo-social.is-active .demo-social__item--3 {
    opacity: 1;
    pointer-events: auto;
    transform: translate(
        calc(-50% + var(--menu-distance-x)),
        calc(-50% + var(--menu-distance-side-y))
      )
      scale(1);
    transition-delay: calc(var(--menu-stagger) * 2);
  }

  .demo-social.is-active .demo-social__item svg {
    opacity: 1;
    filter: blur(0);

    transition-delay: 120ms;
  }

  /*
   * CLOSE
   *
   * Los 3 items vuelven a su lugar de origen todos juntos y rápido
   * (sin stagger). Posición y opacidad duran lo mismo para que se
   * los vea deslizarse hacia el centro, no desaparecer de golpe.
   */
  .demo-social.is-closing .demo-social__item {
    opacity: 0;
    pointer-events: none;

    transform: translate(-50%, -50%);

    transition:
      transform 220ms ease-out,
      opacity 220ms ease-out;
  }
</style>
