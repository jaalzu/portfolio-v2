---
// Copy lives here (default lang: Spanish).
const copy = {
  es: {
    title: "Scroll",
    phrases: [
      "Scrolleá sobre mí",
      "Un tonto en movimiento vale más que un genio en reposo.",
    ],
  },
  en: {
    title: "Scroll",
    phrases: [
      "Scroll on me",
      "A fool in motion is better than a genius at rest.",
    ],
  },
} as const;
---

<div class="triggers-group">
  <h3 class="triggers-group__title lang-es">{copy.es.title}</h3>
  <h3 class="triggers-group__title lang-en">{copy.en.title}</h3>

  <div class="scroll-zone">
    {copy.es.phrases.map((phraseEs, slide) => {
      const phraseEn = copy.en.phrases[slide] ?? phraseEs;
      return (
        <div class="scroll-zone__slide">
          <span class="scroll-zone__text lang-es">
            {phraseEs.split(" ").map((word, i) => (
              <span class="scroll-zone__word" style={`--i:${i}`}>
                {word}
              </span>
            ))}
          </span>
          <span class="scroll-zone__text lang-en">
            {phraseEn.split(" ").map((word, i) => (
              <span class="scroll-zone__word" style={`--i:${i}`}>
                {word}
              </span>
            ))}
          </span>
        </div>
      );
    })}
  </div>
</div>

<style>
  .triggers-group {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: var(--space-3);
  }

  .triggers-group__title {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .scroll-zone {
    --h: 99px;
    height: var(--h);
    width: 100%;
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    overscroll-behavior-y: auto;
    scrollbar-width: none;
  }
  .scroll-zone::-webkit-scrollbar {
    display: none;
  }

  .scroll-zone__slide {
    height: var(--h);
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  /* Más chico y con wrap: la frase larga entra en 2-3 líneas */
  .scroll-zone__text {
    font-size: clamp(1.2rem, 2.2vw, 1.375rem);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-heading);
    line-height: 1.35;
    max-width: 35ch;
    text-wrap: balance;
    text-align: center;
  }

  .scroll-zone__word {
    display: inline-block;
    margin-right: 0.3em;
  }

  /* Aparición progresiva: cada palabra entra con un pequeño delay */
  @supports (animation-timeline: view()) {
    .scroll-zone__word {
      opacity: 0;
      animation: word-in 1ms linear both;
      animation-timeline: view(block);
      animation-range: entry 10% entry 90%;
    }
    /* El stagger se aplica al rango, no a un delay en segundos */
    .scroll-zone__word {
      animation-range: entry calc(10% + var(--i) * 3%) entry
        calc(40% + var(--i) * 3%);
    }
  }

  @keyframes word-in {
    from {
      opacity: 0;
      transform: translateY(0.4em);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Sin soporte de scroll-timeline o con reduced-motion: todo visible */
  @supports not (animation-timeline: view()) {
    .scroll-zone__word {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-zone__word {
      opacity: 1;
      animation: none;
    }
  }
</style>
