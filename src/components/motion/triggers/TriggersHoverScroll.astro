---
// Copy lives here (default lang: Spanish).
const copy = {
  es: {
    title: "Scroll",
    phrases: [
      "Scrolleá sobre mí",
      "Un tonto en movimiento vale más que un genio en reposo.",
    ],
  },
  en: {
    title: "Scroll",
    phrases: [
      "Scroll on me",
      "A fool in motion is better than a genius at rest.",
    ],
  },
} as const;
---

<div class="triggers-group">
  <h3 class="triggers-group__title lang-es">{copy.es.title}</h3>
  <h3 class="triggers-group__title lang-en">{copy.en.title}</h3>

  <div class="scroll-zone" data-scroll-zone>
    {copy.es.phrases.map((phraseEs, slide) => {
      const phraseEn = copy.en.phrases[slide] ?? phraseEs;
      return (
        <div class:list={["scroll-zone__slide", slide === 0 && "is-in"]}>
          <span class="scroll-zone__text lang-es">
            {phraseEs.split(" ").map((word, i) => (
              <span class="scroll-zone__word" style={`--i:${i}`}>
                {word}
              </span>
            ))}
          </span>
          <span class="scroll-zone__text lang-en">
            {phraseEn.split(" ").map((word, i) => (
              <span class="scroll-zone__word" style={`--i:${i}`}>
                {word}
              </span>
            ))}
          </span>
        </div>
      );
    })}
  </div>
</div>

<style>
  .triggers-group {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: var(--space-3);
  }

  .triggers-group__title {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .scroll-zone {
    --h: 99px;
    height: var(--h);
    width: 100%;
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    overscroll-behavior-y: auto;
    scrollbar-width: none;
  }
  .scroll-zone::-webkit-scrollbar {
    display: none;
  }

  .scroll-zone__slide {
    height: var(--h);
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  /* Más chico y con wrap: la frase larga entra en 2-3 líneas */
  .scroll-zone__text {
    font-size: clamp(1.2rem, 2.2vw, 1.375rem);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-heading);
    line-height: 1.35;
    max-width: 35ch;
    text-wrap: balance;
    text-align: center;
  }

  .scroll-zone__word {
    display: inline-block;
    margin-right: 0.3em;
    opacity: 1;
    transform: none;
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
    transition-delay: calc(var(--i, 0) * 35ms);
  }

  /* Solo se oculta cuando el JS ya enganchó el observer.
     Sin JS (o con reduced-motion) todo queda visible: nunca desaparece. */
  .scroll-zone.is-js .scroll-zone__slide:not(.is-in) .scroll-zone__word {
    opacity: 0;
    transform: translateY(0.4em);
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-zone__word {
      opacity: 1 !important;
      transform: none !important;
      transition: none;
    }
  }
</style>

<script>
  function initScrollZones() {
    document
      .querySelectorAll<HTMLElement>("[data-scroll-zone]:not([data-bound])")
      .forEach((zone) => {
        (zone as HTMLElement).dataset.bound = "1";
        zone.classList.add("is-js");
        const slides = Array.from(
          zone.querySelectorAll<HTMLElement>(".scroll-zone__slide"),
        );
        if (!slides.length) return;
        // El primero arranca visible para evitar FOUC; el observer corrige.
        slides[0].classList.add("is-in");

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              (entry.target as HTMLElement).classList.toggle(
                "is-in",
                entry.isIntersecting,
              );
            });
          },
          { root: zone, threshold: 0.6 },
        );
        slides.forEach((slide) => io.observe(slide));
      });
  }

  initScrollZones();
  document.addEventListener("astro:page-load", initScrollZones);
  document.addEventListener("astro:after-swap", initScrollZones);
</script>
