---
import { translations } from "../../../data/translations";

const t = translations.es.motionPage.scrollTrigger;
const phrases = [
  { key: "motionPage.scrollTrigger.first", text: t.first },
  { key: "motionPage.scrollTrigger.second", text: t.second },
];
---

<div class="triggers-group">
  <h3 class="triggers-group__title" data-i18n="motionPage.scrollTrigger.title">
    {t.title}
  </h3>

  <div class="scroll-zone">
    {phrases.map((p) => (
      <div class="scroll-zone__slide">
        <span class="scroll-zone__text" data-i18n={p.key}>
          {p.text.split(" ").map((word, i) => (
            <span class="scroll-zone__word" style={`--i:${i}`}>
              {word}
            </span>
          ))}
        </span>
      </div>
    ))}
  </div>
</div>

<style>
  .triggers-group {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: var(--space-3);
  }

  .triggers-group__title {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .scroll-zone {
    --h: 99px;
    height: var(--h);
    width: 100%;
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
  }
  .scroll-zone::-webkit-scrollbar {
    display: none;
  }

  .scroll-zone__slide {
    height: var(--h);
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  /* Más chico y con wrap: la frase larga entra en 2-3 líneas */
  .scroll-zone__text {
    font-size: clamp(1rem, 2.2vw, 1.375rem);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-heading);
    line-height: 1.35;
    max-width: 28ch;
    text-wrap: balance;
    text-align: center;
  }

  .scroll-zone__word {
    display: inline-block;
    margin-right: 0.3em;
  }

  /* Aparición progresiva: cada palabra entra con un pequeño delay */
  @supports (animation-timeline: view()) {
    .scroll-zone__word {
      opacity: 0;
      animation: word-in 1ms linear both;
      animation-timeline: view(block);
      animation-range: entry 10% entry 90%;
    }
    /* El stagger se aplica al rango, no a un delay en segundos */
    .scroll-zone__word {
      animation-range: entry calc(10% + var(--i) * 3%) entry
        calc(40% + var(--i) * 3%);
    }
  }

  @keyframes word-in {
    from {
      opacity: 0;
      transform: translateY(0.4em);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Sin soporte de scroll-timeline o con reduced-motion: todo visible */
  @supports not (animation-timeline: view()) {
    .scroll-zone__word {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-zone__word {
      opacity: 1;
      animation: none;
    }
  }
</style>
