---
// Copy lives here (default lang: Spanish).
const copy = {
  es: {
    description:
      "Las animaciones necesitan algo que las dispare. Algunos de los más comunes son <code>hover</code>, <code>click</code>, <code>focus</code> y <code>scroll</code>.",
  },
  en: {
    description:
      "Animations need something to trigger them. Some of the most common ones are <code>hover</code>, <code>click</code>, <code>focus</code>, and <code>scroll</code>.",
  },
} as const;
---

<div class="triggers-intro">
  <p
    class="triggers-intro__description lang-es"
    set:html={copy.es.description}
  />
  <p
    class="triggers-intro__description lang-en"
    set:html={copy.en.description}
  />
</div>

<style>
  .triggers-intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .triggers-intro__description {
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: var(--font-weight-light);
    margin: 0;
  }

  .triggers-intro__description :global(code) {
    font-family: monospace;
    font-size: 0.9em;
    color: var(--color-text-heading);
    background: var(--color-surface-3);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }
</style>
