---
import TriggersIntro from "./TriggersIntro.astro";
import TriggersGrid from "./TriggersGrid.astro";
---

<div class="triggers-rows">
  <TriggersIntro />
  <TriggersGrid />
</div>

<style>
  .triggers-rows {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-base);
    padding-inline: 18px;
    padding-block: 1rem 1.5rem;
    background: var(--color-surface-2);
  }
</style>
