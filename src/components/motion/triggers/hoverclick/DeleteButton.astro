<button class="delete-btn" type="button">
  <span class="delete-btn__text">Delete</span>
  <span class="delete-btn__icon">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
    >
      <path d="M24 20.188l-8.315-8.209 8.2-8.282-3.697-3.697-8.212 8.318-8.31-8.203-3.666 3.666 8.321 8.24-8.206 8.313 3.666 3.666 8.237-8.318 8.285 8.203z" />
    </svg>
  </span>
</button>

<style>
  .delete-btn {
    position: relative;
    width: 150px;
    height: 50px;
    cursor: pointer;
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    background: transparent;
    /* background: var(--color-surface-3); */
    border-radius: 5px;
    box-shadow: 1px 1px 3px rgba(0, 0, 0, 0.15);
    overflow: hidden;
  }

  .delete-btn,
  .delete-btn__text,
  .delete-btn__icon {
    transition: 200ms;
  }

  .delete-btn__text {
    transform: translateX(35px);
    color: white;
    font-weight: bold;
  }

  .delete-btn__icon {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: 40px;
    display: flex;

    align-items: center;
    justify-content: center;
  }

  .delete-btn svg {
    width: 14px;
    fill: #fa0000;
  }

  .delete-btn:hover {
    background: transparent;
  }

  .delete-btn:hover .delete-btn__text {
    color: transparent;
  }

  .delete-btn__icon::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: #e6e3e32c;
    transition: 200ms;
  }

  .delete-btn:hover .delete-btn__icon {
    width: 100%;
    padding-left: 6px;
  }

  .delete-btn:hover .delete-btn__icon::before {
    opacity: 0;
  }

  .delete-btn:focus {
    outline: none;
  }

  .delete-btn:active .delete-btn__icon svg {
    transform: scale(0.8);
  }
</style>
