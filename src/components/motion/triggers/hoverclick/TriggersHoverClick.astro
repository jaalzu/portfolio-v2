---
import TriggerCard from "../TriggerCard.astro";
import TabsSliding from "./TabsSliding.astro";
import DeleteButton from "./DeleteButton.astro";
---

<div class="triggers-group">
  <h3 class="triggers-group__title">Hover + Click</h3>
  <div class="triggers-group__cards">
    <TriggerCard label="Tabs">
      <TabsSliding />
    </TriggerCard>

    <TriggerCard label="Delete">
      <DeleteButton />
    </TriggerCard>
  </div>
</div>

<style>
  .triggers-group {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: var(--space-3);
  }

  .triggers-group__title {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .triggers-group__cards {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: center;
    gap: var(--space-12);
    padding-left: var(--space-2);
  }
</style>
