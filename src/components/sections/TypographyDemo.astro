---
---
<div class="typo-demo" id="typoDemo" data-mode="after">
  <div class="typo-demo__toolbar">
    <div class="typo-demo__control">
      <button type="button" class="typo-demo__single" id="typoToggle" aria-pressed="true" aria-label="Cambiar entre antes y después">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8h12M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 3l5 5-5 5" stroke="currentColor" stroke-width="1.2" opacity="0.35" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <span class="typo-demo__state" id="typoState">Después</span>
    </div>
  </div>

  <div class="typo-demo__stage">
    <p class="demo-label">Mercado cripto · Tiempo real</p>
    <h3 class="demo-heading">Cifras estables que no saltan cuando el mercado se mueve</h3>
    <p class="demo-body">Precios de monedas virtuales actualizados en vivo. Con cifras tabulares la columna se mantiene estable; sin ellas, cada tick desplaza el layout.</p>
    <div class="demo-live" aria-live="polite">
      <div class="demo-live__row">
        <span class="demo-pair">BTC / USD</span>
        <span class="demo-leader" aria-hidden="true"></span>
        <span class="demo-price-wrap">
          <strong class="demo-num" data-base="68432">$68,432.00</strong>
          <span class="demo-delta"></span>
        </span>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  function initTypoDemo() {
    const demo = document.getElementById('typoDemo');
    if (!demo || demo.dataset.bound === "1") return;
    demo.dataset.bound = "1";

    const btn = document.getElementById('typoToggle');
    const stateLabel = document.getElementById('typoState');
    const stage = demo.querySelector('.typo-demo__stage');

    // --- Lock container height so switching mode never shifts layout ---
    function lockHeight() {
      if (!stage) return;
      const original = demo.dataset.mode;

      // disable transitions + remove min-height while we measure, so the
      // measurement itself is instant and never painted to the screen
      stage.classList.add('no-transition');
      stage.style.minHeight = '0px';

      demo.dataset.mode = 'after';
      const afterH = stage.scrollHeight;
      demo.dataset.mode = 'before';
      const beforeH = stage.scrollHeight;
      demo.dataset.mode = original || 'after';

      stage.style.minHeight = Math.max(afterH, beforeH) + 'px';

      // re-enable transitions on the next frame, after the browser has
      // already painted the final state once
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          stage.classList.remove('no-transition');
        });
      });
    }

    lockHeight();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(lockHeight);
    }
    let resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(lockHeight, 150);
    });

    // --- Toggle ---
    let fadeTimer = null;
    function setMode(mode) {
      if (demo.dataset.mode === mode) return;
      if (stage) {
        stage.style.opacity = '0.35';
        stage.style.transform = 'translateY(2px)';
        clearTimeout(fadeTimer);
      }
      demo.dataset.mode = mode;

      const isAfter = mode === 'after';
      if (btn) btn.setAttribute('aria-pressed', String(isAfter));
      if (stateLabel) {
        stateLabel.style.opacity = '0';
        setTimeout(function () {
          stateLabel.textContent = isAfter ? 'Después' : 'Antes';
          stateLabel.style.opacity = '1';
        }, 90);
      }

      if (stage) {
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            stage.style.opacity = '1';
            stage.style.transform = 'translateY(0)';
          });
        });
        fadeTimer = setTimeout(function () {
          stage.style.opacity = '';
          stage.style.transform = '';
        }, 200);
      }
    }

    if (btn) {
      btn.addEventListener('click', function () {
        const next = demo.dataset.mode === 'after' ? 'before' : 'after';
        setMode(next);
      });
    }

    // --- Ticker ---
    const nums = demo.querySelectorAll('.demo-num');
    const deltas = demo.querySelectorAll('.demo-delta');
    const prevVals = Array.from(nums).map(function (el) { return parseFloat((el.getAttribute('data-base') || '0').replace(',', '')); });
    let tick = 0;
    setInterval(function () {
      tick++;
      nums.forEach(function (el, i) {
        const base = parseFloat(el.getAttribute('data-base') || '1000');
        const isBTC = base > 10000;
        const jitter = isBTC ? (Math.random() * 600 - 300) + Math.sin(tick / 3) * 120 : (Math.random() * 80 - 40);
        const val = Math.max(0, base + jitter + Math.sin(tick / 5 + i) * (isBTC ? 80 : 20));
        const formatted = '$' + val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const prev = prevVals[i];
        const deltaEl = deltas[i];
        el.textContent = formatted;
        if (val > prev) {
          el.classList.remove('down'); el.classList.add('up');
          if (deltaEl) { deltaEl.textContent = '▲'; deltaEl.className = 'demo-delta up'; }
        } else if (val < prev) {
          el.classList.remove('up'); el.classList.add('down');
          if (deltaEl) { deltaEl.textContent = '▼'; deltaEl.className = 'demo-delta down'; }
        }
        prevVals[i] = val;
      });
    }, 750);
  }
  initTypoDemo();
  document.addEventListener('astro:page-load', initTypoDemo);
  document.addEventListener('astro:after-swap', initTypoDemo);
</script>

<style>
  .typo-demo { border: none; border-radius: var(--radius-base); overflow: hidden; background: transparent; }
  .typo-demo__toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-4);
    padding: 10px 12px;
    flex-wrap: wrap;
  }
  .typo-demo__control { display: inline-flex; align-items: center; gap: 10px; }
  .typo-demo__single {
    appearance: none;
    border: 1px solid oklch(1 0 0 / 0.12);
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: var(--radius-full);
    cursor: pointer;
    color: oklch(0.15 0 0);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1), background 140ms ease, opacity 140ms ease, box-shadow 140ms ease;
    will-change: transform;
    flex-shrink: 0;
  }
  .typo-demo__single:hover { opacity: 0.92; }
  .typo-demo__single:active { transform: scale(0.94); box-shadow: none; }
  .typo-demo__single:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .typo-demo__state {
    display: inline-block;
    width: 68px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-surface);
    opacity: 1;
    transition: opacity 120ms ease;
  }

  .typo-demo__stage {
    padding: var(--space-5) var(--space-6) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: opacity 140ms ease, transform 160ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }
  .typo-demo__stage.no-transition { transition: none !important; }

  .demo-label {
    margin: 0;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: letter-spacing 140ms ease, opacity 140ms ease, transform 140ms ease;
  }
  .demo-heading {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(1.25rem, 1rem + 1.6vw, 1.85rem);
    font-weight: 700;
    line-height: 1.20;
    letter-spacing: -0.02em;
    color: var(--color-surface);
    text-wrap: balance;
    transition: letter-spacing 140ms ease, line-height 140ms ease, max-width 160ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .demo-body {
    margin: 0;
    max-width: 35ch;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
    text-wrap: pretty;
    transition: line-height 140ms ease, max-width 160ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .demo-live { display: flex; flex-direction: column; gap: 8px; margin-top: var(--space-3); padding-top: var(--space-3); }
  .demo-live__row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .demo-pair {
    display: inline-block;
    font-size: var(--text-sm);
    line-height: 1;
    color: var(--color-text-muted);
    font-weight: 400;
    flex-shrink: 0;
    transition: color 200ms ease, font-weight 200ms ease;
  }
  .demo-leader {
    flex: 1;
    min-width: 16px;
    align-self: stretch;
    border-bottom: 1px dotted oklch(1 0 0 / 0.14);
    margin-bottom: 5px;
    transition: border-color 200ms ease;
  }
  .demo-price-wrap { display: inline-flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .demo-num {
    display: inline-block;
    font-size: var(--text-base);
    line-height: 1;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    color: var(--color-surface);
    min-width: 7.5ch;
    text-align: right;
    border-radius: 6px;
    contain: layout style;
    padding: 2px 6px;
    background: transparent;
    transition: letter-spacing 140ms ease, font-variant-numeric 140ms ease, color 140ms ease, background 140ms ease;
  }
  .demo-num.up { color: oklch(0.72 0.16 145); }
  .demo-num.down { color: oklch(0.62 0.20 25); }
  .demo-delta { font-size: 11px; font-weight: 700; min-width: 12px; text-align: center; line-height: 1; transition: color 140ms ease; }
  .demo-delta.up { color: oklch(0.72 0.16 145); }
  .demo-delta.down { color: oklch(0.62 0.20 25); }

  .typo-demo[data-mode="before"] .demo-label { letter-spacing: 0; text-transform: none; font-weight: 400; }
  .typo-demo[data-mode="before"] .demo-heading { text-wrap: initial; line-height: 1.05; letter-spacing: 0; max-width: none; }
  .typo-demo[data-mode="before"] .demo-body { text-wrap: initial; line-height: 1.22; max-width: none; }
  .typo-demo[data-mode="before"] .demo-num { font-variant-numeric: proportional-nums; letter-spacing: 0; background: oklch(1 0 0 / 0.035); }
  .typo-demo[data-mode="before"] .demo-pair { color: var(--color-surface); font-weight: 700; }
  .typo-demo[data-mode="before"] .demo-leader { border-color: transparent; }

  @media (max-width: 560px) {
    .typo-demo__toolbar { flex-direction: column; align-items: flex-start; }
  }
</style>