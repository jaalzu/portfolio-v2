---
import CopyButton from "../ui/CopyButton.astro";
// ↑ ajustá la ruta según dónde viva CopyButton

export interface Props {
  id: string;
  title?: string;
  description?: string;
  titleKey?: string;
  descKey?: string;
  titleEs?: string;
  titleEn?: string;
  descriptionEs?: string;
  descriptionEn?: string;
  mutedDesc?: boolean;
  mutedFrame?: boolean;
}
const {
  id,
  title,
  description,
  titleKey,
  descKey,
  titleEs,
  titleEn,
  descriptionEs,
  descriptionEn,
  mutedDesc = false,
  mutedFrame = false,
} = Astro.props;

// Co-located copy: if titleEs/titleEn provided, render dual DOM.
// Otherwise fall back to legacy title + data-i18n (motion pages).
const hasLocalTitle = titleEs !== undefined || titleEn !== undefined;
const hasLocalDesc = descriptionEs !== undefined || descriptionEn !== undefined;
const hasTitleText = (title ?? titleEs ?? titleEn) !== undefined;
---

{hasTitleText && (
  <div class="skill-meta" {id}>
    <h2 class="skill-meta__title">
      <span class="skill-meta__title-text">
        {hasLocalTitle ? (
          <>
            <span class="lang-es">{titleEs ?? title}</span>
            <span class="lang-en">{titleEn ?? title}</span>
          </>
        ) : (
          <span data-i18n={titleKey}>{title}</span>
        )}
      </span>
      <span class="skill-meta__divider" aria-hidden="true"></span>
      <CopyButton anchor={id} inline />
    </h2>
    {(description ?? descriptionEs ?? descriptionEn) &&
      (hasLocalDesc ? (
        <>
          <p
            class:list={[
              "skill-meta__desc",
              "lang-es",
              { "skill-meta__desc--muted": mutedDesc },
            ]}
          >
            {descriptionEs ?? description}
          </p>
          <p
            class:list={[
              "skill-meta__desc",
              "lang-en",
              { "skill-meta__desc--muted": mutedDesc },
            ]}
          >
            {descriptionEn ?? description}
          </p>
        </>
      ) : (
        <p
          class:list={[
            "skill-meta__desc",
            { "skill-meta__desc--muted": mutedDesc },
          ]}
          data-i18n={descKey}
        >
          {description}
        </p>
      ))}
  </div>
)}

<div
  class:list={["skill-block-frame", { "skill-block-frame--muted": mutedFrame }]}
  id={!hasTitleText ? id : undefined}
>
  <div class="skill-block">
    <slot />
  </div>
</div>

<style>
  .skill-meta {
    margin-bottom: var(--space-6);
    padding-inline: var(
      --card-inset
    ); /* iguala el inset de skill-block-frame */
    scroll-margin-top: var(
      --space-6
    ); /* el título no queda pegado arriba al abrir el link */
  }
  .skill-meta__title {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    margin: 0 0 var(--space-6);
    font-family: var(--font-family-enfasis);
    font-style: italic;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-medium);
    letter-spacing: normal;
    color: var(--color-text-heading);
    line-height: var(--leading-tight);
    text-align: left;
  }
  .skill-meta__title-text {
    flex: 0 1 auto;
    min-width: 0;
    overflow-wrap: break-word;
    text-wrap: balance;
  }
  .skill-meta__title :global(.copy-btn--inline) {
    flex-shrink: 0;
    align-self: center;
  }
  .skill-hash {
    opacity: 0.6;
    font-weight: var(--font-weight-regular);
    margin-right: 0.2em;
  }
  .skill-meta__divider {
    flex: 1 1 24px;
    height: 1px;
    background: color-mix(in oklch, var(--color-border-soft) 45%, transparent);
    margin-left: 0.8rem;
    min-width: 24px;
  }
  @media (max-width: 560px) {
    .skill-meta__divider {
      min-width: 12px;
    }
  }
  .skill-meta__desc {
    margin: var(--space-4) 0 0;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    max-width: 66ch;
    font-weight: var(--font-weight-regular);
    text-wrap: pretty;
  }
  .skill-meta__desc--muted {
    opacity: 0.9;
  }

  /* SkillSection.astro */
  .skill-block-frame {
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-base);
    padding: var(--card-inset);
    margin-bottom: var(--space-24);
    overflow: hidden;
  }
  .skill-block-frame--muted {
    opacity: 0.9;
  }
  .skill-block-frame--muted .skill-block {
    border-style: dashed;
  }

  .skill-block {
    border: none;
    border-radius: var(--radius-inner);
    padding: 0;
  }

  .skill-block:has(.skill-block--placeholder) {
    padding: var(--space-6);
  }
</style>
