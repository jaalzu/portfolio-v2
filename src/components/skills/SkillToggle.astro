---
export interface Props {
  id?: string;
  leftLabel?: string;
  rightLabel?: string;
  checked?: boolean;
  class?: string;
}

const {
  id = "skillToggle",
  leftLabel = "before",
  rightLabel = "after",
  checked = false,
  class: className = "",
} = Astro.props;
---

<div
  class:list={["wrench-toggle", className]}
  data-toggle-container={id}
  data-checked={checked ? "true" : "false"}
>
  <span class="wrench-label wrench-label--left">{leftLabel}</span>

  <button
    type="button"
    id={id}
    class="wrench-btn"
    aria-label={`${leftLabel} / ${rightLabel}`}
    aria-pressed={checked ? "true" : "false"}
  >
    <svg
      viewBox="0 0 256 256"
      fill="currentColor"
      aria-hidden="true"
      class="wrench-icon"
    >
      <path d="M226.76,69a8,8,0,0,0-12.84-2.88l-40.3,37.19-17.23-3.7-3.7-17.23,37.19-40.3A8,8,0,0,0,187,29.24,72,72,0,0,0,88,96,72.34,72.34,0,0,0,94,124.94L33.79,177c-.15.12-.29.26-.43.39a32,32,0,0,0,45.26,45.26c.13-.13.27-.28.39-.42L131.06,162A72,72,0,0,0,232,96,71.56,71.56,0,0,0,226.76,69ZM160,152a56.14,56.14,0,0,1-27.07-7,8,8,0,0,0-9.92,1.77L67.11,211.51a16,16,0,0,1-22.62-22.62L109.18,133a8,8,0,0,0,1.77-9.93,56,56,0,0,1,58.36-82.31l-31.2,33.81a8,8,0,0,0-1.94,7.1L141.83,108a8,8,0,0,0,6.14,6.14l26.35,5.66a8,8,0,0,0,7.1-1.94l33.81-31.2A56.06,56.06,0,0,1,160,152Z"></path>
    </svg>
  </button>

  <span class="wrench-label wrench-label--right">{rightLabel}</span>
</div>
<script>
  import { safeAnimate, springs } from "../../lib/motion-tokens";

  function initWrenchToggles() {
    const wraps = document.querySelectorAll<HTMLElement>(
      "[data-toggle-container]",
    );
    wraps.forEach((wrap) => {
      if (wrap.dataset.bound === "1") return;
      wrap.dataset.bound = "1";
      const btn = wrap.querySelector<HTMLButtonElement>("button");
      if (!btn) return;

      const sync = (isGood: boolean) => {
        wrap.setAttribute("data-checked", String(isGood));
        btn.setAttribute("aria-pressed", String(isGood));
        btn.setAttribute("aria-checked", String(isGood));
        // CSS handles label color/opacity via [data-checked] — no inline style
        btn.dispatchEvent(
          new CustomEvent("skill-toggle", {
            detail: { checked: isGood, id: btn.id },
            bubbles: true,
          }),
        );
      };

      const getChecked = () => wrap.getAttribute("data-checked") === "true";

      btn.addEventListener("click", () => {
        sync(!getChecked());
      });

      btn.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          sync(!getChecked());
        }
      });

      btn.addEventListener("pointerdown", () => {
        safeAnimate(btn, { scale: 0.98 }, springs.press);
      });

      btn.addEventListener("pointerup", () => {
        safeAnimate(btn, { scale: 1 }, springs.release);
      });

      btn.addEventListener("pointerleave", () => {
        safeAnimate(btn, { scale: 1 }, springs.release);
      });
    });
  }

  initWrenchToggles();
  document.addEventListener("astro:page-load", initWrenchToggles);
  document.addEventListener("astro:after-swap", initWrenchToggles);
</script>

<style>
  .wrench-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-full);
    padding: 4px 4px;
    width: 100%;
    max-width: 250px;
    margin-inline: auto;
  }
  .wrench-label {
    font-size: var(--text-base);
    user-select: none;
    pointer-events: none;
    text-align: center;
    border: 1px solid var(--color-border-soft);
    padding: 6px;
    border-radius: var(--radius-full);
    flex: 1;
    transition:
      color var(--transition-fast),
      opacity var(--transition-fast);
  }

  .wrench-toggle:not([data-checked="true"]) .wrench-label--left {
    color: var(--color-text-heading);
    font-weight: var(--font-weight-semibold);
    opacity: 1;
  }

  .wrench-toggle:not([data-checked="true"]) .wrench-label--right {
    color: var(--color-text-muted);
    font-weight: var(--font-weight-regular);
    opacity: 0.5;
  }

  .wrench-toggle[data-checked="true"] .wrench-label--left {
    color: var(--color-text-muted);
    font-weight: var(--font-weight-regular);
    opacity: 0.5;
  }

  .wrench-toggle[data-checked="true"] .wrench-label--right {
    color: var(--color-text-heading);
    font-weight: var(--font-weight-semibold);
    opacity: 1;
  }

  .wrench-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--color-border-soft);
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    outline: none;
    flex-shrink: 0;
    color: var(--color-text-heading);
    transition:
      border-color var(--transition-base),
      color var(--transition-base);
  }

  .wrench-btn:hover {
    border-color: var(--color-border);
  }

  .wrench-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .wrench-icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    transition: transform 140ms cubic-bezier(0.22, 1, 0.36, 1);
  }
</style>
