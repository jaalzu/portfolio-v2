---
import SkillToggle from "./SkillToggle.astro";
---

<div class="typo-demo" id="typoDemo" data-mode="before">
  <div class="typo-demo__stage">
    <p class="demo-label">LIVE MARKET DATA</p>

    <h3 class="demo-heading">
      Real-time data without the visual noise
    </h3>

    <p class="demo-body">
      Prices update live. Good typography keeps the hierarchy clear and numbers steady.
    </p>

    <div class="demo-live" aria-live="polite">
      <div class="demo-live__row">
        <span class="demo-pair">BTC</span>

        <span
          class="demo-leader"
          aria-hidden="true"
        ></span>

        <span class="demo-price-wrap">
          <strong
            class="demo-num"
            data-base="68432"
          >
            $68,432.00
          </strong>

          <span class="demo-delta"></span>
        </span>
      </div>
    </div>
  </div>

  <div class="typo-demo__toolbar">
    <SkillToggle id="typoToggle" leftLabel="bad ui" rightLabel="good ui" />
  </div>
</div>

<script is:inline>
  function initTypoDemo() {
    const demo = document.getElementById("typoDemo");

    if (!demo || demo.dataset.bound === "1") {
      return;
    }

    demo.dataset.bound = "1";

    const btn = document.getElementById("typoToggle");
    const buttonLabel = document.getElementById("typoButtonLabel");
    const stage = demo.querySelector(".typo-demo__stage");

    function lockHeight() {
      if (!stage) {
        return;
      }

      const original = demo.dataset.mode;

      stage.classList.add("no-transition");
      stage.style.minHeight = "0px";

      demo.dataset.mode = "after";
      const afterH = stage.scrollHeight;

      demo.dataset.mode = "before";
      const beforeH = stage.scrollHeight;

      demo.dataset.mode = original || "before";

      const max = Math.max(afterH, beforeH);
      stage.style.minHeight = Math.max(max + 36, 260) + "px";

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          stage.classList.remove("no-transition");
        });
      });
    }

    lockHeight();

    if (document.fonts?.ready) {
      document.fonts.ready.then(lockHeight);
    }

    let resizeTimer;

    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(lockHeight, 150);
    });

    let fadeTimer = null;

    function setMode(mode) {
      if (demo.dataset.mode === mode) {
        return;
      }

      clearTimeout(fadeTimer);

      if (stage) {
        stage.style.opacity = "0.62";
      }

      demo.dataset.mode = mode;

      const isAfter = mode === "after";

      if (btn && btn.getAttribute("aria-checked") !== String(isAfter)) {
        btn.setAttribute("aria-checked", String(isAfter));
        const container = btn.closest("[data-toggle-container]");
        if (container) {
          container.setAttribute("data-checked", String(isAfter));
        }
      }

      if (stage) {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            stage.style.opacity = "1";
          });
        });

        fadeTimer = setTimeout(() => {
          stage.style.opacity = "";
        }, 260);
      }
    }

    if (btn) {
      btn.addEventListener("skill-toggle", (e) => {
        const isAfter = e.detail ? e.detail.checked : btn.getAttribute("aria-checked") === "true";
        setMode(isAfter ? "after" : "before");
      });
    }

    const nums = demo.querySelectorAll(".demo-num");
    const deltas = demo.querySelectorAll(".demo-delta");

    const prevVals = Array.from(nums).map((el) => {
      return parseFloat(
        (el.getAttribute("data-base") || "0")
          .replace(",", "")
      );
    });

    let tick = 0;

    setInterval(() => {
      tick++;

      nums.forEach((el, i) => {
        const base = parseFloat(
          el.getAttribute("data-base") || "1000"
        );

        const isBTC = base > 10000;

        const jitter = isBTC
          ? Math.random() * 600 -
            300 +
            Math.sin(tick / 3) * 120
          : Math.random() * 80 - 40;

        const val = Math.max(
          0,
          base +
            jitter +
            Math.sin(tick / 5 + i) *
              (isBTC ? 80 : 20)
        );

        const formatted =
          "$" +
          val.toLocaleString("en-US", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
          });

        const prev = prevVals[i];
        const deltaEl = deltas[i];

        el.textContent = formatted;

        if (val > prev) {
          el.classList.remove("down");
          el.classList.add("up");

          if (deltaEl) {
            deltaEl.textContent = "▲";
            deltaEl.className = "demo-delta up";
          }
        } else if (val < prev) {
          el.classList.remove("up");
          el.classList.add("down");

          if (deltaEl) {
            deltaEl.textContent = "▼";
            deltaEl.className = "demo-delta down";
          }
        }

        prevVals[i] = val;
      });
    }, 750);
  }

  initTypoDemo();

  document.addEventListener(
    "astro:page-load",
    initTypoDemo
  );

  document.addEventListener(
    "astro:after-swap",
    initTypoDemo
  );
</script>

<style>
  .typo-demo {
    position: relative;
    border: none;
    border-radius: var(--radius-base);
    overflow: hidden;
    background: transparent;
  }

  .typo-demo__stage {
    width: min(100%, 560px);
    margin-inline: auto;
    min-height: 260px;
    /* MORE centered — strong inline padding, button untouched */
    padding: var(--space-2) var(--space-17) var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    text-align: left;
    transition: opacity 220ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity;
  }

  .typo-demo__stage.no-transition {
    transition: none !important;
  }

  .typo-demo__toolbar {
    width: 100%;
    padding: var(--space-1);
    padding-top: 2px;
    margin-top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border-top: 1px solid var(--color-border-soft);
  }

  .typo-demo__action {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 160px;
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-inner);
    background: transparent;
    color: var(--color-surface);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1;
    text-align: center;
    cursor: pointer;
    transition:
      background 140ms ease,
      border-color 140ms ease,
      transform 120ms
        cubic-bezier(0.22, 1, 0.36, 1);
  }

  .typo-demo[data-mode="before"] .typo-demo__action {
    background: var(--color-surface);
    color: oklch(0.15 0 0);
    border-color: var(--color-surface);
  }

  .typo-demo__action:active {
    transform: scale(0.99);
  }

  .typo-demo__action:focus-visible {
    outline: 2px solid
      var(--color-primary);
    outline-offset: 2px;
  }

  .demo-label {
    margin: 0;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: font-size 140ms ease, letter-spacing 140ms ease;
  }

  .demo-heading {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(
      1.25rem,
      1rem + 1.6vw,
      1.85rem
    );
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-surface);
    text-wrap: balance;
    transition: letter-spacing 220ms cubic-bezier(0.22, 1, 0.36, 1), line-height 220ms ease, max-width 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .demo-body {
    margin: 0;
    max-width: 42ch;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
    text-wrap: pretty;
    transition: letter-spacing 220ms cubic-bezier(0.22, 1, 0.36, 1), line-height 220ms ease, max-width 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .demo-live {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: var(--space-3);
    padding-top: var(--space-3);
  }

  .demo-live__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .demo-pair {
    display: inline-block;
    flex-shrink: 0;
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: 1;
    color: var(--color-text-muted);
  }

  .demo-leader {
    display: none;
  }

  .demo-status {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-inner);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    position: relative;
    overflow: hidden;
  }

  .demo-status__icon {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: opacity 180ms ease, transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .demo-status__icon--bad {
    opacity: 1;
    transform: scale(1);
    color: oklch(0.62 0.20 25);
  }

  .demo-status__icon--good {
    opacity: 0;
    transform: scale(0.7);
    color: oklch(0.72 0.16 145);
  }

  .typo-demo[data-mode="after"] .demo-status__icon--bad {
    opacity: 0;
    transform: scale(0.7);
  }

  .typo-demo[data-mode="after"] .demo-status__icon--good {
    opacity: 1;
    transform: scale(1);
  }

  .demo-price-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    margin-left: auto;
  }

  .demo-num {
    display: inline-block;
    min-width: 7.5ch;
    padding: 0;
    text-align: right;
    border-radius: 0;
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--color-surface);
    background: transparent;
    contain: layout style;
    transition: letter-spacing 220ms cubic-bezier(0.22, 1, 0.36, 1), background 220ms ease;
  }

  .demo-num.up,
  .demo-delta.up {
    color: oklch(0.72 0.16 145);
  }

  .demo-num.down,
  .demo-delta.down {
    color: oklch(0.62 0.20 25);
  }

  .demo-delta {
    min-width: 12px;
    text-align: center;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
  }

  .typo-demo[data-mode="before"]
    .demo-label {
    font-size: 9px;
    letter-spacing: 0.04em;
  }

  .typo-demo[data-mode="before"]
    .demo-heading {
    max-width: none;
    text-wrap: initial;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .typo-demo[data-mode="before"]
    .demo-body {
    max-width: none;
    text-wrap: initial;
    line-height: 1.22;
  }

  .typo-demo[data-mode="before"]
    .demo-num {
    font-variant-numeric: proportional-nums;
    letter-spacing: 0;
    background: transparent;
  }

  @media (max-width: 560px) {
    .typo-demo__stage {
      padding: var(--space-5) var(--space-6);
      min-height: 240px;
    }
  }
</style>
