---
// AccessibilityDemo.astro
import ToggleCard from "../ToggleCard.astro";
import { translations } from "../../../data/translations";
const t = translations.es;
---

<ToggleCard id="a11yToggle" leftLabel="before" rightLabel="after" stageClass="a11y-demo__stage">
  <form class="wd-form" novalidate>
    <div class="wd-field">
      <label class="wd-field__label" for="wd-wallet" data-i18n="skillsPage.a11yDemo.walletLabel">{t.skillsPage.a11yDemo.walletLabel}</label>
      <input class="wd-field__input" id="wd-wallet" name="wallet" type="text" autocomplete="off" placeholder={t.skillsPage.a11yDemo.walletPlaceholder} data-i18n-attr="placeholder:skillsPage.a11yDemo.walletPlaceholder" />
      <p class="wd-field__error" id="wd-wallet-error"></p>
    </div>

    <div class="wd-field">
      <label class="wd-field__label" for="wd-amount" data-i18n="skillsPage.a11yDemo.amountLabel">{t.skillsPage.a11yDemo.amountLabel}</label>
      <input class="wd-field__input" id="wd-amount" name="amount" type="text" inputmode="decimal" autocomplete="off" placeholder={t.skillsPage.a11yDemo.amountPlaceholder} data-i18n-attr="placeholder:skillsPage.a11yDemo.amountPlaceholder" />
      <p class="wd-field__error" id="wd-amount-error"></p>
    </div>

    <button class="wd-submit" type="submit" data-i18n="skillsPage.a11yDemo.submit">{t.skillsPage.a11yDemo.submit}</button>
  </form>

 
  <div class="wd-toast" role="alert" aria-live="assertive">
    <span class="wd-toast__icon" aria-hidden="true"></span>
    <span class="wd-toast__text"></span>
  </div>
</ToggleCard>

<script>
  import { safeAnimate, springs } from "../../../lib/motion-tokens";
  import { translations } from "../../../data/translations";

  const CHECK_ICON = `<svg viewBox="0 0 256 256" width="16" height="16" aria-hidden="true"><rect width="256" height="256" fill="none"/><polyline points="40 144 96 200 224 72" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/></svg>`;

  function getLang(): "es" | "en" {
    return document.documentElement.getAttribute("data-lang") === "en" ? "en" : "es";
  }
  function tA11y() {
    return translations[getLang()].skillsPage.a11yDemo;
  }

  function initWithdrawDemo() {
    document.querySelectorAll<HTMLElement>(".a11y-demo__stage").forEach((stage) => {
      if (stage.dataset.bound === "1") return;
      stage.dataset.bound = "1";

      const card = stage.closest<HTMLElement>("[data-toggle-card]");
      const form = stage.querySelector<HTMLFormElement>(".wd-form");
      const toast = stage.querySelector<HTMLElement>(".wd-toast");
      let toastTimer: ReturnType<typeof setTimeout> | null = null;
      let toastVisible = false;

      // Requisitos simples a propósito: el foco del demo es a11y, no validación real.
      const fields = [
        {
          input: "#wd-wallet",
          error: "#wd-wallet-error",
          validate: (v: string) => v.trim().length >= 6,
          get fullError() { return tA11y().errors.wallet; },
        },
        {
          input: "#wd-amount",
          error: "#wd-amount-error",
          validate: (v: string) => {
            const n = Number(v.trim().replace(",", "."));
            return !Number.isNaN(n) && n > 0;
          },
          get fullError() { return tA11y().errors.amount; },
        },
      ];

      function isAfter() {
        return card?.dataset.mode === "after";
      }

     function showToast(message: string, variant: "error" | "success" = "error") {
  if (!toast) return;
  if (toastTimer) clearTimeout(toastTimer);

  const iconEl = toast.querySelector<HTMLElement>(".wd-toast__icon");
  const textEl = toast.querySelector<HTMLElement>(".wd-toast__text");
  if (iconEl) iconEl.innerHTML = variant === "success" ? CHECK_ICON : "";
  if (textEl) textEl.textContent = message;

  toast.classList.toggle("wd-toast--success", variant === "success");
  toast.classList.add("is-visible");

 safeAnimate(
  toast,
  { opacity: [0, 1], y: [-8, 0], scale: [0.98, 1] },
  springs.reveal
);
console.log("animate called", toast, springs.reveal);

  toastTimer = setTimeout(() => hideToast(), 2600);
}
function hideToast() {
  if (!toast || !toast.classList.contains("is-visible")) return;

  safeAnimate(
    toast,
    { opacity: 0, y: -8, scale: 0.98 },
    { type: "tween", duration: 0.18, ease: "easeIn" }
  )?.finished?.then(() => toast.classList.remove("is-visible"));
}

      function setFieldError(field: (typeof fields)[number], hasError: boolean) {
        const input = stage.querySelector<HTMLInputElement>(field.input);
        const error = stage.querySelector<HTMLElement>(field.error);
        if (!input || !error) return;

        if (!hasError) {
          input.classList.remove("is-invalid");
          error.textContent = "";
          error.classList.remove("is-visible");
          input.removeAttribute("aria-invalid");
          input.removeAttribute("aria-describedby");
          return;
        }

        if (isAfter()) {
          input.classList.add("is-invalid");
          error.textContent = field.fullError;
          error.classList.add("is-visible");
          input.setAttribute("aria-invalid", "true");
          input.setAttribute("aria-describedby", error.id);
        }
      }

      form?.addEventListener("submit", (e) => {
        e.preventDefault();

        let allValid = true;

        fields.forEach((field) => {
          const input = stage.querySelector<HTMLInputElement>(field.input);
          const valid = input ? field.validate(input.value) : false;
          if (!valid) allValid = false;
          setFieldError(field, !valid);
        });

        if (!allValid) {
          if (isAfter()) {
            const invalidInput = stage.querySelector<HTMLInputElement>(".wd-field__input.is-invalid");
            invalidInput?.focus({ preventScroll: true });
          } else {
            showToast(tA11y().toasts.invalid, "error");
          }
          return;
        }

        showToast(tA11y().toasts.success, "success");
        form.reset();
      });

      fields.forEach((field) => {
        const input = stage.querySelector<HTMLInputElement>(field.input);
        input?.addEventListener("input", () => {
          if (field.validate(input.value)) {
            setFieldError(field, false);
          }
        });
      });

      card?.addEventListener("toggle-card:mode-change", () => {
        fields.forEach((field) => setFieldError(field, false));
        hideToast();
      });

      // Keep visible errors in sync when language changes
      const onLangChange = () => {
        fields.forEach((field) => {
          const error = stage.querySelector<HTMLElement>(field.error);
          if (error?.classList.contains("is-visible")) {
            error.textContent = field.fullError;
          }
        });
        const visibleToast = stage.querySelector<HTMLElement>(".wd-toast.is-visible .wd-toast__text");
        if (visibleToast && toast?.classList.contains("is-visible")) {
          // heuristics: keep success vs error based on class
          const isSuccess = toast.classList.contains("wd-toast--success");
          visibleToast.textContent = isSuccess ? tA11y().toasts.success : tA11y().toasts.invalid;
        }
      };
      document.addEventListener("langchange", onLangChange);
    });
  }

  initWithdrawDemo();
  document.addEventListener("astro:page-load", initWithdrawDemo);
  document.addEventListener("astro:after-swap", initWithdrawDemo);
</script>

<style>
  :global(.a11y-demo__stage) {
    padding: var(--space-12) var(--space-17);
    display: flex;
    justify-content: center;
    position: relative;
  }

  .wd-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
    max-width: 340px;

    margin-inline: auto;
    padding-block: var(--space-6);
  }

  .wd-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .wd-field__label {
    font-size: var(--text-sm);
    color: var(--color-text);
    font-weight: var(--font-weight-semibold);
  }

  .wd-field__input {
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-inner);
    padding: var(--space-3) var(--space-3);
    font-size: var(--text-sm);
    background: transparent;
    color: var(--color-text-heading);
    outline: none;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .wd-field__input:focus-visible {
    border-color: var(--color-text-muted);
    box-shadow: 0 0 0 2px color-mix(in oklch, var(--color-text-muted) 25%, transparent);
  }

  .wd-field__input.is-invalid {
    border-color: var(--color-red-soft);
  }

  .wd-field__input.is-invalid:focus-visible {
    border-color: var(--color-red-soft);
  }

  .wd-field__error {
    margin: 0;
    height: calc(var(--text-xs) * var(--leading-normal));
   font-size: calc(var(--text-xs) + 1.9px);
    line-height: var(--leading-normal);
    color: var(--color-red);
    opacity: 0;
    letter-spacing: 0.2px;
    overflow: hidden;
    transition: opacity var(--transition-fast);
  }

  .wd-field__error.is-visible {
    opacity: var(--opacity-full);
  }

  .wd-submit {
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-full);
    padding: var(--space-3) ;
    font-size: var(--text-md);
    color: var(--color-surface-1);
    background: var(--color-text-heading);
    cursor: pointer;
    width: 100%;
    transition: border-color var(--transition-base);
  }

  .wd-submit:hover {
    background: rgba(255, 255, 255, 0.87);
    border-color: var(--color-border);
  }

  .wd-submit:focus-visible {
    outline: 2px solid var(--color-text-heading);
    outline-offset: 2px;
  }

 .wd-toast {
  position: absolute;
  top: var(--space-3);
  right: var(--space-4);
  display: flex;
  align-items: center;
  gap: var(--space-2);
  background: transparent;
  border: 1px solid var(--color-border-soft);
  border-radius: var(--radius-sm);
  padding: var(--space-2) var(--space-2);
  font-size: var(--text-sm);
  color: var(--color-text-heading);
  box-shadow: var(--shadow-sm);
  opacity: 0;
  pointer-events: none;
}

.wd-toast.is-visible {
  pointer-events: auto;
}

.wd-toast__icon {
  display: inline-flex;
  flex-shrink: 0;
}

.wd-toast--success .wd-toast__icon {
  color: var(--color-green);
}

.wd-toast--success {
  border-color: var(--color-border-soft);
}

  @media (max-width: 560px) {
    :global(.a11y-demo__stage) {
      padding: var(--space-8) var(--space-4);
    }
  }
</style>