---
// TokenUIDemo.astro
---

<div class="tk-demo">
  <div class="tk-demo__stage" id="tk-stage">
    <button class="tk-info-btn" type="button" id="tk-info-btn" aria-pressed="false" aria-label="Mostrar tokens">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"></circle>
        <line x1="12" y1="11" x2="12" y2="16"></line>
        <circle cx="12" cy="7.5" r="0.5" fill="currentColor" stroke="none"></circle>
      </svg>
    </button>

    <!-- MOBILE: leyenda — siempre en el flujo, controlada solo por opacity -->
    <div class="tk-mobile-legend" id="tk-mobile-legend" aria-hidden="true">
      <span class="tk-legend-item"><span class="tk-token-badge tk-legend-dot">1</span>text-heading</span>
      <span class="tk-legend-item"><span class="tk-token-badge tk-legend-dot">2</span>text-base</span>
      <span class="tk-legend-item"><span class="tk-token-badge tk-legend-dot">3</span>primary</span>
      <span class="tk-legend-item"><span class="tk-token-badge tk-legend-dot">4</span>surface-1</span>
      <span class="tk-legend-item"><span class="tk-token-badge tk-legend-dot">5</span>radius</span>
      <span class="tk-legend-item"><span class="tk-token-badge tk-legend-dot">6</span>icon-neutral</span>
      <span class="tk-legend-item"><span class="tk-token-badge tk-legend-dot">7</span>rating</span>
    </div>

    <div class="tk-card" id="tk-card">
      <div class="tk-card__media">
        <div class="tk-card__track" id="tk-track">
          <img class="tk-card__image" src="./portft1.webp" alt="" aria-hidden="true" />
          <img class="tk-card__image" src="./sky.png" alt="" aria-hidden="true" />
          <img class="tk-card__image" src="./train-city.jpg" alt="" aria-hidden="true" />
        </div>

        <button class="tk-card__arrow tk-card__arrow--prev" type="button" id="tk-prev" aria-label="Foto anterior">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
        </button>
        <button class="tk-card__arrow tk-card__arrow--next" type="button" id="tk-next" data-token="arrow" aria-label="Foto siguiente">
          <svg class="tk-card__arrow-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 6l6 6-6 6"></path>
          </svg>
        </button>

        <span class="tk-token-badge tk-token-badge--arrow">6</span>
      </div>

      <div class="tk-card__content" data-token="content">
        <span class="tk-token-badge tk-token-badge--content">4</span>

        <h3 class="tk-card__title" data-token="title">
          <span class="tk-token-badge tk-token-badge--title">1</span>
          <span class="tk-card__title-text">Diseño consistente</span>
        </h3>

        <p class="tk-card__text" data-token="text-body">
          <span class="tk-token-badge tk-token-badge--textbody">2</span>
          Cambiá los tokens de abajo y mirá cómo reacciona toda la card a la vez.
        </p>

        <div class="tk-card__footer">
          <div class="tk-card__profile">
            <div class="tk-card__avatar" data-token="avatar">
              <span class="tk-token-badge tk-token-badge--avatar">3</span>
            </div>
            <div class="tk-card__profile-text">
              <span class="tk-card__name">Javier Alzú</span>
              <span class="tk-card__rating-row">
                <span class="tk-token-badge tk-token-badge--rating">7</span>
                <span class="tk-card__rating" data-token="stars" aria-label="5 de 5 estrellas">
                  <svg viewBox="0 0 20 20" width="12" height="12"><path fill="currentColor" d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6z"/></svg>
                  <svg viewBox="0 0 20 20" width="12" height="12"><path fill="currentColor" d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6z"/></svg>
                  <svg viewBox="0 0 20 20" width="12" height="12"><path fill="currentColor" d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6z"/></svg>
                  <svg viewBox="0 0 20 20" width="12" height="12"><path fill="currentColor" d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6z"/></svg>
                  <svg viewBox="0 0 20 20" width="12" height="12"><path fill="currentColor" d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6z"/></svg>
                </span>
              </span>
            </div>
          </div>

          <button class="tk-card__button" type="button" data-token="button">
            <span class="tk-token-badge tk-token-badge--button">5</span>
            Reservar
          </button>
        </div>
      </div>
    </div>

    <div class="tk-annot-layer" id="tk-annot-layer" aria-hidden="true">
      <svg class="tk-annot-svg" id="tk-annot-svg"></svg>
    </div>
  </div>

  <div class="tk-demo__toolbar" id="tk-toolbar">
    <div class="tk-toolbar-group">
      <label class="tk-picker" data-tooltip="surface-1">
        <input type="color" class="tk-picker__input" data-token="bg" value="#131415" aria-label="Elegir color de superficie" />
        <span class="tk-picker__swatch"></span>
      </label>
      <label class="tk-picker" data-tooltip="primary">
        <input type="color" class="tk-picker__input" data-token="primary" value="#e08a5c" aria-label="Elegir color primario" />
        <span class="tk-picker__swatch"></span>
      </label>
      <label class="tk-picker" data-tooltip="text-heading">
        <input type="color" class="tk-picker__input" data-token="text" value="#f7f8f8" aria-label="Elegir color de texto" />
        <span class="tk-picker__swatch"></span>
      </label>
    </div>

    <div class="tk-toolbar-group">
      <input type="range" class="tk-slider tk-slider--a" id="tk-radius-slider" min="0" max="2" step="0.01" value="0.375" aria-label="Radio de borde" data-tooltip-prefix="radius" />
    </div>

    <div class="tk-toolbar-group">
      <input type="range" class="tk-slider tk-slider--b" id="tk-fontsize-slider" min="0" max="2" step="0.01" value="1" aria-label="Tamaño de fuente" data-tooltip-prefix="font" />
    </div>

    <div class="tk-tooltip" id="tk-tooltip">
      <span id="tk-tooltip-text"></span><span class="tk-tooltip__value" id="tk-tooltip-value"></span>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    function initTokensDemo(demo) {
      if (demo.dataset.bound === "1") return;
      demo.dataset.bound = "1";

      var LINE_SHORTEN = 30;
      var RADIUS_RANGE = { min: 0, max: 32 };
      var FONT_RANGE = { min: 0.95, max: 1.4 };

      function lerp(range, t) {
        return range.min + (range.max - range.min) * (t / 2);
      }

      // "shorten" opcional: sobreescribe LINE_SHORTEN para esa anotación puntual
      var ANNOTATIONS = [
        { selector: '[data-token="title"]', side: "left", label: "text-heading", shorten: 46 },
        { selector: '[data-token="text-body"]', side: "left", label: "text-base", shorten: 46 },
        { selector: '[data-token="avatar"]', side: "left", label: "primary" },
        { selector: '[data-token="content"]', side: "right", label: "surface-1", edgeInset: 30 },
        { selector: '[data-token="button"]', side: "right", label: "radius" },
        { selector: '[data-token="arrow"]', side: "right", label: "icon-neutral" },
        { selector: '[data-token="stars"]', side: "left", label: "rating" }
      ];

      var card = demo.querySelector("#tk-card");
      var stage = demo.querySelector("#tk-stage");
      var infoBtn = demo.querySelector("#tk-info-btn");
      var layer = demo.querySelector("#tk-annot-layer");
      var svg = demo.querySelector("#tk-annot-svg");
      var toolbar = demo.querySelector("#tk-toolbar");
      var tooltip = demo.querySelector("#tk-tooltip");
      var tooltipText = demo.querySelector("#tk-tooltip-text");
      var tooltipValue = demo.querySelector("#tk-tooltip-value");
      if (!card || !stage || !infoBtn || !layer || !svg || !toolbar || !tooltip || !tooltipText || !tooltipValue) return;

      var built = ANNOTATIONS.map(function (cfg) {
        var line = document.createElementNS("http://www.w3.org/2000/svg", "line");
        line.setAttribute("class", "tk-annot-line");
        svg.appendChild(line);

        var label = document.createElement("span");
        label.className = "tk-annot-label";
        label.textContent = cfg.label;
        layer.appendChild(label);

        return { cfg: cfg, line: line, label: label };
      });

      var annotationsActive = false;

      function positionAnnotations() {
        var stageRect = stage.getBoundingClientRect();
        var edgeMargin = 16;

        built.forEach(function (item) {
          var cfg = item.cfg;
          var target = card.querySelector(cfg.selector);
          if (!target) return;

          var t = target.getBoundingClientRect();
          var targetX;
          if (cfg.edgeInset != null) {
            targetX = cfg.side === "right"
              ? t.right - cfg.edgeInset - stageRect.left
              : t.left + cfg.edgeInset - stageRect.left;
          } else {
            targetX = t.left + t.width / 2 - stageRect.left;
          }
          var targetY = t.top + t.height / 2 - stageRect.top;

          var l = item.label.getBoundingClientRect();
          var labelX = cfg.side === "left" ? edgeMargin : stageRect.width - l.width - edgeMargin;
          var dyOffset = cfg.dy || 0;
          var rawY = targetY - l.height / 2 + dyOffset;
          var labelY = Math.max(0, Math.min(stageRect.height - l.height, rawY));

          item.label.style.left = labelX + "px";
          item.label.style.top = labelY + "px";

          var startX = cfg.side === "left" ? labelX + l.width : labelX;
          var startY = labelY + l.height / 2;
          var dx = targetX - startX;
          var dy = targetY - startY;
          var dist = Math.hypot(dx, dy) || 1;
          var shorten = cfg.shorten != null ? cfg.shorten : LINE_SHORTEN;
          var ratio = Math.max(0, (dist - shorten) / dist);

          item.line.setAttribute("x1", String(startX));
          item.line.setAttribute("y1", String(startY));
          item.line.setAttribute("x2", String(startX + dx * ratio));
          item.line.setAttribute("y2", String(startY + dy * ratio));
        });
      }

      infoBtn.addEventListener("click", function () {
        annotationsActive = !annotationsActive;
        infoBtn.setAttribute("aria-pressed", String(annotationsActive));
        stage.classList.toggle("is-annotating", annotationsActive);
        if (annotationsActive) positionAnnotations();
      });
      window.addEventListener("resize", function () {
        if (annotationsActive) positionAnnotations();
      });

      var track = demo.querySelector("#tk-track");
      var slideCount = track ? track.children.length : 1;
      var slideIndex = 0;

      function goToSlide(i) {
        slideIndex = (i + slideCount) % slideCount;
        if (track) track.style.transform = "translateX(-" + (slideIndex * (100 / slideCount)) + "%)";
      }

      var prevBtn = demo.querySelector("#tk-prev");
      var nextBtn = demo.querySelector("#tk-next");
      if (prevBtn) prevBtn.addEventListener("click", function () { goToSlide(slideIndex - 1); });
      if (nextBtn) nextBtn.addEventListener("click", function () { goToSlide(slideIndex + 1); });

      var tooltipHasAppeared = false;

      function positionTooltip(target) {
        var tb = toolbar.getBoundingClientRect();
        var r = target.getBoundingClientRect();
        tooltip.style.left = (r.left + r.width / 2 - tb.left) + "px";
        tooltip.style.top = (r.top - tb.top) + "px";
      }

      function revealTooltip(target) {
        positionTooltip(target);
        tooltip.style.transition = tooltipHasAppeared ? "none" : "opacity 0.15s ease";
        tooltip.style.opacity = tooltipHasAppeared ? "1" : "0.96";
        tooltip.classList.add("is-visible");
        if (!tooltipHasAppeared) {
          requestAnimationFrame(function () { tooltip.style.opacity = "1"; });
          tooltipHasAppeared = true;
        }
      }

      function showStaticTooltip(target, text) {
        tooltipText.textContent = text;
        tooltipValue.textContent = "";
        revealTooltip(target);
      }

      function showValueTooltip(target, prefix, value) {
        tooltipText.textContent = prefix;
        tooltipValue.textContent = value;
        tooltipValue.classList.remove("tk-pop");
        void tooltipValue.offsetWidth;
        tooltipValue.classList.add("tk-pop");
        revealTooltip(target);
      }

      function hideTooltip() {
        tooltip.classList.remove("is-visible");
      }

      var PICKER_VARS = { bg: "--tk-bg", primary: "--tk-primary", text: "--tk-text" };

      demo.querySelectorAll(".tk-picker").forEach(function (picker) {
        var input = picker.querySelector(".tk-picker__input");
        var swatch = picker.querySelector(".tk-picker__swatch");
        var label = picker.dataset.tooltip || "";
        var cssVar = PICKER_VARS[input.dataset.token];

        swatch.style.background = input.value;

        input.addEventListener("input", function () {
          swatch.style.background = input.value;
          if (cssVar) card.style.setProperty(cssVar, input.value);
          if (annotationsActive) positionAnnotations();
          showStaticTooltip(picker, label);
        });

        picker.addEventListener("pointerenter", function () { showStaticTooltip(picker, label); });
        picker.addEventListener("focusin", function () { showStaticTooltip(picker, label); });
        picker.addEventListener("pointerleave", hideTooltip);
        picker.addEventListener("focusout", hideTooltip);
      });

      function bindSlider(id, range, cssVar, format) {
        var slider = demo.querySelector("#" + id);
        if (!slider) return;

        var prefix = (slider.dataset.tooltipPrefix || "") + ": ";

        function currentValue() {
          return lerp(range, Number(slider.value));
        }

        function apply() {
          card.style.setProperty(cssVar, format(currentValue()));
          if (annotationsActive) positionAnnotations();
        }
        apply();

        slider.addEventListener("input", function () {
          apply();
          showValueTooltip(slider, prefix, format(currentValue()));
        });
        slider.addEventListener("pointerenter", function () { showValueTooltip(slider, prefix, format(currentValue())); });
        slider.addEventListener("focusin", function () { showValueTooltip(slider, prefix, format(currentValue())); });
        slider.addEventListener("pointerleave", hideTooltip);
        slider.addEventListener("focusout", hideTooltip);
      }

      bindSlider("tk-radius-slider", RADIUS_RANGE, "--tk-radius", function (v) { return v.toFixed(0) + "px"; });
      bindSlider("tk-fontsize-slider", FONT_RANGE, "--tk-title-size", function (v) { return v.toFixed(2) + "rem"; });
    }

    function boot() {
      document.querySelectorAll(".tk-demo").forEach(function (el) {
        initTokensDemo(el);
      });
    }

    boot();
    document.addEventListener("astro:page-load", boot);
    document.addEventListener("astro:after-swap", boot);
  })();
</script>

<style>
  .tk-demo {
    position: relative;
    border-radius: var(--radius-base);
    overflow: hidden;
    margin: calc(var(--card-inset) * -1);
    width: calc(100% + var(--card-inset) * 2);
    --tk-toolbar-control-h: 44px;
    --tk-slider-gold: #d4a139;
    --tk-slider-teal: #4fa3a0;
  }

  .tk-demo__stage {
    position: relative;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    padding: var(--space-12) var(--space-6);
  }

  .tk-info-btn {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-soft);
    background: var(--color-surface-1);
    color: var(--color-text-muted);
    cursor: pointer;
    overflow: visible;
    transition: transform 0.15s ease-out, color 0.15s ease-out, border-color 0.15s ease-out;
  }
  .tk-info-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: currentColor;
    opacity: 0;
    filter: blur(2px);
    transition: opacity 0.15s ease-out;
    pointer-events: none;
    z-index: -1;
  }
  .tk-info-btn:hover { color: var(--color-text-heading); border-color: var(--color-border); }
  .tk-info-btn:active { transform: scale(0.97); }
  .tk-info-btn:active::before { opacity: 0.12; }
  .tk-info-btn[aria-pressed="true"] {
    color: var(--color-text-heading);
    border-color: var(--color-border);
    background: var(--color-surface-2);
  }

  :global(.tk-annot-line) { stroke: currentColor; stroke-width: 1.5; opacity: 0; transition: opacity 0.15s ease; }
  .tk-demo__stage.is-annotating :global(.tk-annot-line) { opacity: 0.5; }

  :global(.tk-annot-label) {
    position: absolute;
    opacity: 0;
    transition: opacity 0.15s ease;
    padding: 3px 8px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-soft);
    background: var(--color-surface-1);
    font-size: var(--text-xs);
    font-family: monospace;
    color: var(--color-text-heading);
    white-space: nowrap;
  }
  .tk-demo__stage.is-annotating :global(.tk-annot-label) { opacity: 0.75; }

  .tk-annot-layer { position: absolute; inset: 0; z-index: 15; pointer-events: none; }
  .tk-annot-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; color: var(--color-text-heading); }

  .tk-mobile-legend { display: none; }
  .tk-token-badge { display: none; }

  /* ---- Card ---- */
  .tk-card {
    --tk-bg: #131415;
    --tk-primary: #e08a5c;
    --tk-text: #f7f8f8;
    --tk-radius: 12px;
    --tk-title-size: 1.125rem;
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 350px;
    height: 350px;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-base);
    overflow: hidden;
    background: var(--tk-bg);
  }

  .tk-card__media { position: relative; flex-shrink: 0; height: 150px; overflow: hidden; }
  .tk-card__track { display: flex; height: 100%; width: 300%; transform: translateX(0%); transition: transform 0.35s ease; }

  /* imagen ligeramente más ancha + margen negativo: elimina la rendija
     de subpíxel entre slides causada por el redondeo de 33.333% */
  .tk-card__image {
    display: block;
    width: calc(33.334% + 1px);
    margin-right: -1px;
    height: 100%;
    object-fit: cover;
    flex-shrink: 0;
    transform: translateZ(0);
  }

  .tk-card__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border: none;
    border-radius: var(--radius-full);
    background: color-mix(in oklch, var(--color-surface-2) 70%, transparent);
    color: var(--color-text-heading);
    cursor: pointer;
    overflow: visible;
    transition: transform 0.15s ease-out, background-color 0.15s ease-out;
  }
  .tk-card__arrow::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: currentColor;
    opacity: 0;
    filter: blur(2px);
    transition: opacity 0.15s ease-out;
    pointer-events: none;
    z-index: -1;
  }
  .tk-card__arrow:hover { background: color-mix(in oklch, var(--color-surface-2) 90%, transparent); }
  .tk-card__arrow:active { transform: translateY(-50%) scale(0.97); }
  .tk-card__arrow:active::before { opacity: 0.12; }
  .tk-card__arrow--prev { left: var(--space-2); }
  .tk-card__arrow--next { right: var(--space-2); }

  .tk-card__content {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    margin-top: -17px;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-6) var(--space-4) var(--space-8);
    background: var(--tk-bg);
  }

  .tk-card__title {
    position: relative;
    margin: 0;
    display: flex;
    align-items: center;
    font-weight: var(--font-weight-semibold);
    transition: font-size var(--transition-base), color var(--transition-base);
  }

  .tk-card__title-text {
    font-size: var(--tk-title-size);
    color: var(--tk-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .tk-card__text {
    position: relative;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--tk-text);
    opacity: var(--opacity-medium);
    padding-bottom: .5rem;
    line-height: var(--leading-normal);
  }

  .tk-card__footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-6);
  }

  .tk-card__profile { display: flex; align-items: center; gap: var(--space-2); min-width: 0; }
  .tk-card__avatar { position: relative; width: 26px; height: 26px; flex-shrink: 0; border-radius: var(--radius-full); background: var(--tk-primary); }
  .tk-card__profile-text { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .tk-card__name { font-size: var(--text-xs); font-weight: var(--font-weight-semibold); color: var(--tk-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tk-card__rating-row { position: relative; display: inline-flex; align-items: center; }
  .tk-card__rating { display: inline-flex; align-items: center; gap: 1px; color: var(--color-warning); }

  .tk-card__button {
    position: relative;
    flex-shrink: 0;
    border: none;
    border-radius: var(--tk-radius);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-surface-1);
    background: var(--tk-primary);
    cursor: pointer;
    transition: filter var(--transition-fast), border-radius var(--transition-base);
  }
  .tk-card__button:hover { filter: brightness(1.1); }
  .tk-card__button:focus-visible { outline: 2px solid var(--tk-primary); outline-offset: 2px; }

  .tk-demo__toolbar {
    position: relative;
    width: 100%;
    min-height: 67px;
    padding: var(--space-3) var(--space-2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    border-top: 1px solid var(--color-border-soft);
    background: var(--color-surface-2);
  }

  .tk-toolbar-group {
    display: flex;
