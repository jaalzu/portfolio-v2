---
// DesignTokensDemo.astro
---

<div class="tk-demo">
  <div class="tk-demo__stage" id="tk-stage">
    <button class="tk-info-btn" type="button" id="tk-info-btn" aria-pressed="false" aria-label="Mostrar tokens">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"></circle>
        <line x1="12" y1="11" x2="12" y2="16"></line>
        <circle cx="12" cy="7.5" r="0.5" fill="currentColor" stroke="none"></circle>
      </svg>
    </button>

    <div class="tk-card" id="tk-card">
      <span class="tk-card__badge" data-token="badge">Disponible</span>

      <img class="tk-card__image" src="./portft1.webp" alt="" aria-hidden="true" />

      <div class="tk-card__content" data-token="content">
        <h3 class="tk-card__title" data-token="title">Diseño consistente</h3>
        <p class="tk-card__text">Cambiá los tokens de abajo y mirá cómo reacciona toda la card a la vez.</p>

        <div class="tk-card__footer">
          <div class="tk-card__profile">
            <div class="tk-card__avatar" data-token="avatar"></div>
            <div class="tk-card__profile-text">
              <span class="tk-card__name">Javier Alzú</span>
              <span class="tk-card__rating" aria-label="5 de 5 estrellas">
                <svg viewBox="0 0 20 20" width="12" height="12"><path fill="currentColor" d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6z"/></svg>
                <svg viewBox="0 0 20 20" width="12" height="12"><path fill="currentColor" d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6z"/></svg>
                <svg viewBox="0 0 20 20" width="12" height="12"><path fill="currentColor" d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6z"/></svg>
                <svg viewBox="0 0 20 20" width="12" height="12"><path fill="currentColor" d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6z"/></svg>
                <svg viewBox="0 0 20 20" width="12" height="12"><path fill="currentColor" d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6z"/></svg>
              </span>
            </div>
          </div>

          <button class="tk-card__button" type="button" data-token="button">Reservar</button>
        </div>
      </div>
    </div>

    <!-- capa de anotaciones: vive en el padre, siempre en el DOM, solo cambia opacity -->
    <div class="tk-annot-layer" id="tk-annot-layer" aria-hidden="true">
      <svg class="tk-annot-svg" id="tk-annot-svg">
        <defs>
          <marker id="tk-arrowhead" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" fill="currentColor"></path>
          </marker>
        </defs>
        <line class="tk-annot-line" data-for="content"></line>
        <line class="tk-annot-line" data-for="title"></line>
        <line class="tk-annot-line" data-for="avatar"></line>
        <line class="tk-annot-line" data-for="badge"></line>
        <line class="tk-annot-line" data-for="button"></line>
      </svg>

      <span class="tk-annot-label" data-anchor="content" data-side="left">--tk-bg</span>
      <span class="tk-annot-label" data-anchor="title" data-side="left">--tk-text</span>
      <span class="tk-annot-label" data-anchor="avatar" data-side="left">--tk-primary</span>
      <span class="tk-annot-label" data-anchor="badge" data-side="right">--tk-primary</span>
      <span class="tk-annot-label" data-anchor="button" data-side="right">--tk-primary</span>
    </div>
  </div>

  <div class="tk-demo__toolbar" id="tk-toolbar">
    <label class="tk-picker" data-tooltip="bg">
      <input type="color" class="tk-picker__input" data-token="bg" value="#08090a" aria-label="Elegir color de fondo" />
      <span class="tk-picker__swatch"></span>
    </label>

    <label class="tk-picker" data-tooltip="primary">
      <input type="color" class="tk-picker__input" data-token="primary" value="#e08a5c" aria-label="Elegir color primario" />
      <span class="tk-picker__swatch"></span>
    </label>

    <label class="tk-picker" data-tooltip="text">
      <input type="color" class="tk-picker__input" data-token="text" value="#f7f8f8" aria-label="Elegir color de texto" />
      <span class="tk-picker__swatch"></span>
    </label>

    <div class="tk-slider-wrap">
      <input
        type="range"
        class="tk-slider"
        id="tk-radius-slider"
        min="0" max="2" step="1" value="1"
        aria-label="Radio de borde"
        data-tooltip-prefix="radius"
      />
    </div>

    <div class="tk-slider-wrap">
      <input
        type="range"
        class="tk-slider"
        id="tk-fontsize-slider"
        min="0" max="2" step="1" value="1"
        aria-label="Tamaño de fuente"
        data-tooltip-prefix="font"
      />
    </div>

    <div class="tk-tooltip" id="tk-tooltip"></div>
  </div>
</div>

<script>
  import { initTokensDemo } from "./TokenUIDemo.client";

  function boot() {
    document.querySelectorAll<HTMLElement>(".tk-demo").forEach(initTokensDemo);
  }

  boot();
  document.addEventListener("astro:page-load", boot);
  document.addEventListener("astro:after-swap", boot);
</script>

<style>
  .tk-demo {
    position: relative;
    border-radius: var(--radius-base);
    overflow: hidden;
    margin: calc(var(--card-inset) * -1);
    width: calc(100% + var(--card-inset) * 2);
  }

  .tk-demo__stage {
    position: relative;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    padding: var(--space-12) var(--space-6);
  }

  .tk-info-btn {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-soft);
    background: var(--color-surface-1);
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .tk-info-btn:hover {
    color: var(--color-text-heading);
    border-color: var(--color-border);
  }

  .tk-info-btn[aria-pressed="true"] {
    color: var(--color-text-heading);
    border-color: var(--color-border);
    background: var(--color-surface-2);
  }

  /* ---- capa de anotaciones ---- */
  .tk-annot-layer {
    position: absolute;
    inset: 0;
    z-index: 15;
    pointer-events: none;
  }

  .tk-annot-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    color: var(--color-text-muted);
  }

  .tk-annot-line {
    stroke: currentColor;
    stroke-width: 1.5;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .tk-demo__stage.is-annotating .tk-annot-line {
    opacity: 0.85;
  }

  .tk-annot-label {
    position: absolute;
    opacity: 0;
    transition: opacity 0.15s ease;
    padding: 3px 8px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-soft);
    background: var(--color-surface-1);
    font-size: var(--text-xs);
    font-family: monospace;
    color: var(--color-text-heading);
    white-space: nowrap;
  }

  .tk-demo__stage.is-annotating .tk-annot-label {
    opacity: 1;
  }

  /* ---- Card ---- */
  .tk-card {
    --tk-bg: #08090a;
    --tk-primary: #e08a5c;
    --tk-text: #f7f8f8;
    --tk-radius: 12px;
    --tk-title-size: 1.125rem;

    position: relative;
    width: 100%;
    max-width: 350px;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-base);
    overflow: hidden;
    background: var(--tk-bg);
  }

  .tk-card__badge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 1;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    padding: 2px var(--space-2);
    border-radius: var(--tk-radius);
    color: var(--tk-primary);
    background: color-mix(in oklch, var(--tk-primary) 20%, oklch(0 0 0 / 0.55));
    backdrop-filter: blur(4px);
    white-space: nowrap;
    transition: border-radius var(--transition-base), color var(--transition-base);
  }

  .tk-card__image {
    display: block;
    width: 100%;
    height: 150px;
    object-fit: cover;
    border-radius: var(--radius-base) var(--radius-base) 0 0;
  }

  .tk-card__content {
    position: relative;
    margin-top: -17px;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-6) var(--space-4);
    background: var(--tk-bg);
  }

  .tk-card__title {
    margin: 0;
    font-size: var(--tk-title-size);
    font-weight: var(--font-weight-semibold);
    color: var(--tk-text);
    transition: font-size var(--transition-base), color var(--transition-base);
  }

  .tk-card__text {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--tk-text);
    opacity: var(--opacity-medium);
    padding-bottom: .5rem;
    line-height: var(--leading-normal);
  }

  .tk-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-6);
  }

  .tk-card__profile {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .tk-card__avatar {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: var(--tk-primary);
  }

  .tk-card__profile-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .tk-card__name {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--tk-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tk-card__rating {
    display: inline-flex;
    gap: 1px;
    color: var(--color-warning);
  }

  .tk-card__button {
    flex-shrink: 0;
    border: none;
    border-radius: var(--tk-radius);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-surface-1);
    background: var(--tk-primary);
    cursor: pointer;
    transition: filter var(--transition-fast), border-radius var(--transition-base);
  }

  .tk-card__button:hover {
    filter: brightness(1.1);
  }

  .tk-card__button:focus-visible {
    outline: 2px solid var(--tk-primary);
    outline-offset: 2px;
  }

  /* ---- Toolbar ---- */
  .tk-demo__toolbar {
    position: relative; /* ancla el tooltip */
    width: 100%;
    min-height: 64px;
    padding: var(--space-2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-5);
    border-top: 1px solid var(--color-border-soft);
    background: var(--color-surface-2);
  }

  .tk-picker {
    display: flex;
    align-items: center;
    cursor: pointer;
  }

  .tk-picker__input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .tk-picker__swatch {
    width: 22px;
    height: 22px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-soft);
    flex-shrink: 0;
    transition: border-color var(--transition-fast);
  }

  .tk-picker:hover .tk-picker__swatch {
    border-color: var(--color-border);
  }

  .tk-picker__input:focus-visible + .tk-picker__swatch {
    outline: 2px solid var(--color-text-heading);
    outline-offset: 2px;
  }

  /* ---- Sliders (reemplazan los botones cíclicos) ---- */
  .tk-slider-wrap {
    display: flex;
    align-items: center;
  }

  .tk-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 72px;
    height: 4px;
    border-radius: var(--radius-full);
    background: var(--color-border-soft);
    cursor: pointer;
  }

  .tk-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 14px;
    height: 14px;
    border-radius: var(--radius-full);
    background: var(--color-text-heading);
    border: 2px solid var(--color-surface-2);
    box-shadow: 0 0 0 1px var(--color-border-soft);
    cursor: pointer;
  }

  .tk-slider::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border-radius: var(--radius-full);
    background: var(--color-text-heading);
    border: 2px solid var(--color-surface-2);
    box-shadow: 0 0 0 1px var(--color-border-soft);
    cursor: pointer;
  }

  .tk-slider:focus-visible {
    outline: 2px solid var(--color-text-heading);
    outline-offset: 3px;
  }

  /* ---- Tooltip compartido ---- */
  .tk-tooltip {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 30;
    transform: translate(-50%, calc(-100% - 10px));
    padding: 3px 8px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-soft);
    background: var(--color-surface-1);
    font-size: var(--text-xs);
    font-family: monospace;
    color: var(--color-text-heading);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
  }

  .tk-tooltip.is-visible {
    opacity: 1;
  }

  @media (max-width: 560px) {
    .tk-demo__stage {
      padding: var(--space-6) var(--space-4);
    }
  }

  /* ---- mobile: sin cálculo de posición para las anotaciones ---- */
  @media (max-width: 640px) {
    .tk-demo__stage.is-annotating {
      flex-direction: column;
      gap: var(--space-4);
    }

    .tk-annot-svg {
      display: none;
    }

    .tk-annot-layer {
      position: static;
      display: none;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-2);
    }

    .tk-demo__stage.is-annotating .tk-annot-layer {
      display: flex;
    }

    .tk-annot-label {
      position: static;
    }
  }
</style>