---
import "./morphing-demo.css";
---

<div class="morph-wrap" id="morph-root">
  <div class="morph-footer">
    <p class="morph-hint" data-i18n="skillsPage.upcoming.hint">Seguime en mis redes para enterarte</p>
    <div class="morph-links">
      <a
        href="https://github.com/jaalzu"
        class="morph-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
      <a
        href="https://www.linkedin.com/in/javier-alz%C3%BA-332ab2261/"
        class="morph-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </a>
    </div>
  </div>

  <div class="morph-main">
    <svg
      id="morph-svg"
      viewBox="0 0 256 256"
      width="56"
      height="56"
      fill="currentColor"
      class="morph-icon"
      aria-hidden="true"
    >
      <path id="morph-path" fill-rule="nonzero"></path>
    </svg>
    <span
      id="morph-label"
      class="morph-label morph-label--in"
      aria-live="polite"
    ></span>
  </div>
</div>

<script>
  import "./morphingDemo";
</script>
