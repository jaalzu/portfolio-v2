---
import "./morphing-demo.css";
import GithubIcon from "../../../icons/GithubIcon.astro";
import Icon from "../../../icons/Icon.astro";
import SpinnerCycler from "./SpinnerCycler.tsx";
---

<div class="morph-wrap" id="morph-root">
  <div class="morph-footer">
    <p class="morph-title" data-i18n="skillsPage.upcoming.title">Trabajando en nuevas skills</p>
    <p class="morph-hint" data-i18n="skillsPage.upcoming.hint">Seguime para no perdértelo.</p>
    <div class="morph-links">
      <a
        href="https://github.com/jaalzu"
        class="morph-link morph-link--icon"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
      >
        <GithubIcon size={22} />
      </a>
      <a
        href="https://www.linkedin.com/in/javier-alz%C3%BA-332ab2261/"
        class="morph-link morph-link--icon"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
      >
        <Icon name="linkedin" size={22} />
      </a>
    </div>
  </div>

  <SpinnerCycler client:load />
</div>
