---
// TokenUICard.astro
// Markup de la card + carrusel + badges numerados de mobile.
// Los data-token="..." son los anchors que usa el script de TokenUIDemo.astro
// para posicionar las líneas de desktop.
import "./token-card.css";

// Copy lives here (default lang: Spanish). No import from translations.
const copy = {
  es: {
    cardTitle: "Diseño consistente",
    cardText:
      "Cambiá los tokens de abajo y mirá cómo reacciona toda la card a la vez.",
    button: "Reservar",
    ratingLabel: "5 de 5 estrellas",
    prevLabel: "Foto anterior",
    nextLabel: "Foto siguiente",
  },
  en: {
    cardTitle: "Consistent design",
    cardText:
      "Change the tokens below and watch the whole card react at once.",
    button: "Reserve",
    ratingLabel: "5 out of 5 stars",
    prevLabel: "Previous photo",
    nextLabel: "Next photo",
  },
} as const;
---

<div class="tk-card" id="tk-card">
  <div class="tk-card__media">
    <div class="tk-card__track" id="tk-track">
      <img
        class="tk-card__image"
        src="./skills/demo/portft1.webp"
        alt=""
        aria-hidden="true"
      />
      <img
        class="tk-card__image"
        src="./skills/demo/win50.webp"
        alt=""
        aria-hidden="true"
      />
      <img
        class="tk-card__image"
        src="./skills/demo/windows_xp_35.webp"
        alt=""
        aria-hidden="true"
      />
    </div>

    <button
      class="tk-card__arrow tk-card__arrow--prev"
      type="button"
      id="tk-prev"
      aria-label={copy.es.prevLabel}
      data-aria-es={copy.es.prevLabel}
      data-aria-en={copy.en.prevLabel}
    >
      <svg
        viewBox="0 0 24 24"
        width="14"
        height="14"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M15 18l-6-6 6-6"></path>
      </svg>
    </button>
    <button
      class="tk-card__arrow tk-card__arrow--next"
      type="button"
      id="tk-next"
      data-token="arrow"
      aria-label={copy.es.nextLabel}
      data-aria-es={copy.es.nextLabel}
      data-aria-en={copy.en.nextLabel}
    >
      <svg
        class="tk-card__arrow-icon"
        viewBox="0 0 24 24"
        width="14"
        height="14"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M9 6l6 6-6 6"></path>
      </svg>
    </button>

    <span class="tk-token-badge tk-token-badge--arrow">6</span>
  </div>

  <div class="tk-card__content" data-token="content">
    <span class="tk-token-badge tk-token-badge--content">4</span>

    <h3 class="tk-card__title" data-token="title">
      <span class="tk-token-badge tk-token-badge--title">1</span>
      <span class="tk-card__title-text">
        <span class="lang-es">{copy.es.cardTitle}</span>
        <span class="lang-en">{copy.en.cardTitle}</span>
      </span>
    </h3>

    <p class="tk-card__text" data-token="text-body">
      <span class="tk-token-badge tk-token-badge--textbody">2</span>
      <span>
        <span class="lang-es">{copy.es.cardText}</span>
        <span class="lang-en">{copy.en.cardText}</span>
      </span>
    </p>

    <div class="tk-card__footer">
      <div class="tk-card__profile">
        <div class="tk-card__avatar" data-token="avatar">
          <span class="tk-token-badge tk-token-badge--avatar">3</span>
        </div>
        <div class="tk-card__profile-text">
          <span class="tk-card__name">Javier Alzú</span>
          <span class="tk-card__rating-row">
            <span class="tk-token-badge tk-token-badge--rating">7</span>
            <span
              class="tk-card__rating"
              data-token="stars"
              aria-label={copy.es.ratingLabel}
              data-aria-es={copy.es.ratingLabel}
              data-aria-en={copy.en.ratingLabel}
            >
              <svg viewBox="0 0 20 20" width="12" height="12">
                <path
                  fill="currentColor"
                  d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6z"
                />
              </svg>
              <svg viewBox="0 0 20 20" width="12" height="12">
                <path
                  fill="currentColor"
                  d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6z"
                />
              </svg>
              <svg viewBox="0 0 20 20" width="12" height="12">
                <path
                  fill="currentColor"
                  d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6z"
                />
              </svg>
              <svg viewBox="0 0 20 20" width="12" height="12">
                <path
                  fill="currentColor"
                  d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6z"
                />
              </svg>
              <svg viewBox="0 0 20 20" width="12" height="12">
                <path
                  fill="currentColor"
                  d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6z"
                />
              </svg>
            </span>
          </span>
        </div>
      </div>

      <button class="tk-card__button" type="button" data-token="button">
        <span class="tk-token-badge tk-token-badge--button">5</span>
        <span>
          <span class="lang-es">{copy.es.button}</span>
          <span class="lang-en">{copy.en.button}</span>
        </span>
      </button>
    </div>
  </div>
</div>

<script>
  import { resolveLang, rootLang } from "../../../../lib/lang";

  function currentTkCardLang(): "es" | "en" {
    try {
      const stored = localStorage.getItem("lang");
      if (stored === "en" || stored === "es") return stored;
    } catch {
      // private mode — fall through to root/browser detection
    }
    if (document.documentElement.hasAttribute("data-lang")) return rootLang();
    return resolveLang();
  }

  function syncTkCardLang(lang: "es" | "en") {
    const isEn = lang === "en";
    document
      .querySelectorAll(".tk-card [data-aria-es]")
      .forEach((el) => {
        const value =
          el.getAttribute(isEn ? "data-aria-en" : "data-aria-es") ?? "";
        if (value) el.setAttribute("aria-label", value);
      });
  }

  syncTkCardLang(currentTkCardLang());

  document.addEventListener("langchange", (e) => {
    syncTkCardLang((e as CustomEvent<{ lang: "es" | "en" }>).detail.lang);
  });
  document.addEventListener("astro:page-load", () => {
    syncTkCardLang(currentTkCardLang());
  });
  document.addEventListener("astro:after-swap", () => {
    syncTkCardLang(currentTkCardLang());
  });
</script>
