---
 // TokenUIToolbar.astro
// Pickers de color, sliders continuos, y el tooltip compartido (texto + valor animado).
import { translations } from "../../../../data/translations";
const t = translations.es;
---

<div class="tk-demo__toolbar" id="tk-toolbar">
  <div class="tk-toolbar-group">
    <label class="tk-picker" data-tooltip="surface-1">
      <input type="color" class="tk-picker__input" data-token="bg" value="#131415" aria-label={t.skillsPage.tokenDemo.toolbar.surface} data-i18n-attr="aria-label:skillsPage.tokenDemo.toolbar.surface" />
      <span class="tk-picker__swatch"></span>
    </label>
    <label class="tk-picker" data-tooltip="primary">
      <input type="color" class="tk-picker__input" data-token="primary" value="#e08a5c" aria-label={t.skillsPage.tokenDemo.toolbar.primary} data-i18n-attr="aria-label:skillsPage.tokenDemo.toolbar.primary" />
      <span class="tk-picker__swatch"></span>
    </label>
    <label class="tk-picker" data-tooltip="text-heading">
      <input type="color" class="tk-picker__input" data-token="text" value="#f7f8f8" aria-label={t.skillsPage.tokenDemo.toolbar.textHeading} data-i18n-attr="aria-label:skillsPage.tokenDemo.toolbar.textHeading" />
      <span class="tk-picker__swatch"></span>
    </label>
  </div>

  <div class="tk-toolbar-group">
    <input type="range" class="tk-slider tk-slider--a" id="tk-radius-slider" min="0" max="2" step="0.01" value="0.375" aria-label={t.skillsPage.tokenDemo.toolbar.radius} data-i18n-attr="aria-label:skillsPage.tokenDemo.toolbar.radius" data-tooltip-prefix="radius" />
  </div>

  <div class="tk-toolbar-group">
    <input type="range" class="tk-slider tk-slider--b" id="tk-fontsize-slider" min="0" max="2" step="0.01" value="1" aria-label={t.skillsPage.tokenDemo.toolbar.fontSize} data-i18n-attr="aria-label:skillsPage.tokenDemo.toolbar.fontSize" data-tooltip-prefix="font" />
  </div>

  <div class="tk-tooltip" id="tk-tooltip">
    <span id="tk-tooltip-text"></span><span class="tk-tooltip__value" id="tk-tooltip-value"></span>
  </div>
</div>

<style>
  .tk-demo__toolbar {
    position: relative;
    width: 100%;
    min-height: 67px;
    padding: var(--space-3) var(--space-2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    border-top: 1px solid var(--color-border-soft);
    background: var(--color-surface-2);
  }

  .tk-toolbar-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    height: var(--tk-toolbar-control-h, 44px);
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-base);
    background: var(--color-surface-1);
    box-sizing: border-box;
  }

  .tk-picker { display: flex; align-items: center; cursor: pointer; }
  .tk-picker__input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .tk-picker__swatch { width: 22px; height: 22px; border-radius: var(--radius-full); border: 1px solid var(--color-border-soft); flex-shrink: 0; transition: border-color var(--transition-fast); }
  .tk-picker:hover .tk-picker__swatch { border-color: var(--color-border); }
  .tk-picker__input:focus-visible + .tk-picker__swatch { outline: 2px solid var(--color-text-heading); outline-offset: 2px; }

  .tk-slider { -webkit-appearance: none; appearance: none; width: 84px; height: 4px; border-radius: var(--radius-full); background: var(--color-border-soft); cursor: pointer; }
  .tk-slider--a { accent-color: var(--tk-slider-gold, #d4a139); }
  .tk-slider--b { accent-color: var(--tk-slider-teal, #4fa3a0); }
  .tk-slider--a::-webkit-slider-thumb, .tk-slider--b::-webkit-slider-thumb {
    -webkit-appearance: none; width: 14px; height: 14px; border-radius: var(--radius-full);
    border: 2px solid var(--color-surface-1); box-shadow: 0 0 0 1px var(--color-border-soft); cursor: pointer;
  }
  .tk-slider--a::-webkit-slider-thumb { background: var(--tk-slider-gold, #d4a139); }
  .tk-slider--b::-webkit-slider-thumb { background: var(--tk-slider-teal, #4fa3a0); }
  .tk-slider--a::-moz-range-thumb, .tk-slider--b::-moz-range-thumb {
    width: 14px; height: 14px; border-radius: var(--radius-full);
    border: 2px solid var(--color-surface-1); box-shadow: 0 0 0 1px var(--color-border-soft); cursor: pointer;
  }
  .tk-slider--a::-moz-range-thumb { background: var(--tk-slider-gold, #d4a139); }
  .tk-slider--b::-moz-range-thumb { background: var(--tk-slider-teal, #4fa3a0); }
  .tk-slider:focus-visible { outline: 2px solid var(--color-text-heading); outline-offset: 3px; }

  .tk-tooltip {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 30;
    transform: translate(-50%, calc(-100% - 10px));
    padding: 3px 8px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-soft);
    background: var(--color-surface-1);
    font-size: var(--text-xs);
    font-family: monospace;
    color: var(--color-text-heading);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
  }
  .tk-tooltip.is-visible { opacity: 1; }

  @keyframes tk-value-pop {
    from { transform: translateY(-7px); opacity: 0; filter: blur(3px); }
    to   { transform: translateY(0);    opacity: 1; filter: blur(0); }
  }
  .tk-tooltip__value { display: inline-block; }
  .tk-tooltip__value.tk-pop {
    animation: tk-value-pop 0.16s cubic-bezier(0.22, 1.15, 0.36, 1);
  }
</style>