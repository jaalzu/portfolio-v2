---
import ToggleCard from "../../ToggleCard.astro";
import "./typography-demo.css";

// Copy lives here (default lang: Spanish). No import from translations.
const copy = {
  es: {
    label: "DATOS DE MERCADO EN VIVO",
    heading: "Datos en tiempo real sin ruido visual",
    body: "Los precios se actualizan en vivo. Una buena tipografía mantiene la jerarquía clara y los números estables.",
  },
  en: {
    label: "LIVE MARKET DATA",
    heading: "Real-time data without the visual noise",
    body: "Prices update live. Good typography keeps the hierarchy clear and numbers steady.",
  },
} as const;
---

<ToggleCard id="typoToggle" stageClass="typo-demo__stage">
  <p class="demo-label">
    <span class="lang-es">{copy.es.label}</span>
    <span class="lang-en">{copy.en.label}</span>
  </p>

  <h3 class="demo-heading">
    <span class="lang-es">{copy.es.heading}</span>
    <span class="lang-en">{copy.en.heading}</span>
  </h3>

  <p class="demo-body">
    <span class="lang-es">{copy.es.body}</span>
    <span class="lang-en">{copy.en.body}</span>
  </p>

  <div class="demo-live" aria-live="polite">
    <div class="demo-live__row">
      <span class="demo-pair">BTC</span>
      <span class="demo-leader" aria-hidden="true"></span>
      <span class="demo-price-wrap">
        <strong class="demo-num" data-base="68432">$68,432.00</strong>
        <span class="demo-delta"></span>
      </span>
    </div>
  </div>
</ToggleCard>

<script src="./typographyDemo.js"></script>
