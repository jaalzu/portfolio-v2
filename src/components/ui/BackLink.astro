---
export interface Props {
  href?: string;
  label?: string;
}
const { href = "/", label = "Volver" } = Astro.props;
---

<a {href} class="back-link" aria-label="Volver al inicio">
  <img
    src="/arrow-bend-up-left.svg"
    alt=""
    aria-hidden="true"
    width="16"
    height="16"
    class="back-link__arrow"
  />
  <span class="back-link__text" data-i18n="skills.back">
    {label}
  </span>
</a>

<style>
  .back-link {
    position: fixed;
    top: calc(6rem + var(--space-10) + 0.4rem);
    left: max(1rem, calc((100vw - var(--content-max-width)) / 2 - 210px));
    z-index: 5;
    display: inline-flex;
    align-items: center;
    margin: 0;
    opacity: 1;
    gap: 5px;
    text-decoration: none;
    font-size: var(--text-base);
    color: var(--color-text-heading);
    transition:
      opacity 400ms ease,
      color var(--transition-fast);
  }
  .back-link__arrow {
    width: 18px;
    height: 18px;
    opacity: 1;
    flex-shrink: 0;
    margin-top: -2px;
    filter: invert(1) brightness(1);
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast);
  }
  .back-link__text {
    font-style: italic;
    line-height: 1;
    margin-top: -2px;
    opacity: 1;
    transition: opacity var(--transition-fast);
  }
  .back-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .back-link.is-scrolled {
    opacity: 0.55;
  }
  .back-link.is-scrolled:hover,
  .back-link.is-scrolled:focus-visible {
    opacity: 1;
  }
  @media (max-width: 1100px) {
    .back-link {
      position: static;
      margin-top: 2rem;
      margin-bottom: 4rem;
    }
  }
  @media (max-width: 768px) {
    .back-link {
      margin-top: 3.5rem;
      margin-bottom: calc(var(--space-6) + var(--space-4));
    }
  }
</style>

<script>
  if (!(window as any).__backLinkScrollInit) {
    (window as any).__backLinkScrollInit = true;
    const update = () => {
      document
        .querySelectorAll(".back-link")
        .forEach((el) =>
          el.classList.toggle("is-scrolled", window.scrollY > 24),
        );
    };
    window.addEventListener("scroll", update, { passive: true });
    document.addEventListener("astro:page-load", update);
    update();
  }
</script>
