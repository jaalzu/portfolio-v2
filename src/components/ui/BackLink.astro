---
export interface Props {
  href?: string;
  label?: string;
  labelEs?: string;
  labelEn?: string;
}

// Copy lives here (default lang: Spanish). Taken from translations.ts skills.back.
const copy = {
  es: { label: "Inicio", aria: "Volver al inicio" },
  en: { label: "Home", aria: "Back to home" },
} as const;

const { href = "/", label, labelEs, labelEn } = Astro.props;

const textEs = labelEs ?? label ?? copy.es.label;
const textEn = labelEn ?? label ?? copy.en.label;
---

<a
  {href}
  class="back-link"
  aria-label={copy.es.aria}
  data-aria-es={copy.es.aria}
  data-aria-en={copy.en.aria}
>
  <img
    src="/arrow-bend-up-left.svg"
    alt=""
    aria-hidden="true"
    width="16"
    height="16"
    class="back-link__arrow"
  />
  <span class="back-link__text lang-es">
    {textEs}
  </span>
  <span class="back-link__text lang-en">
    {textEn}
  </span>
</a>

<style>
  .back-link {
    position: fixed;
    top: calc(6rem + var(--space-10) + 0.4rem);
    left: max(1rem, calc((100vw - var(--content-max-width)) / 2 - 210px));
    z-index: 5;
    display: inline-flex;
    align-items: center;
    margin: 0;
    opacity: 1;
    gap: 5px;
    text-decoration: none;
    font-size: var(--text-base);
    color: var(--color-text-heading);
    transition:
      opacity 400ms ease,
      color var(--transition-fast);
  }
  .back-link__arrow {
    width: 18px;
    height: 18px;
    opacity: 1;
    flex-shrink: 0;
    margin-top: -2px;
    filter: invert(1) brightness(1);
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast);
  }
  .back-link__text {
    font-style: italic;
    line-height: 1;
    margin-top: -2px;
    opacity: 1;
    transition: opacity var(--transition-fast);
  }
  .back-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .back-link.is-scrolled {
    opacity: 0.55;
  }
  .back-link.is-scrolled:hover,
  .back-link.is-scrolled:focus-visible {
    opacity: 1;
  }
  @media (max-width: 1100px) {
    .back-link {
      position: static;
      margin-top: 2rem;
      margin-bottom: 4rem;
    }
  }
  @media (max-width: 768px) {
    .back-link {
      margin-top: 3.5rem;
      margin-bottom: calc(var(--space-6) + var(--space-4));
    }
  }
</style>

<script>
  if (!(window as any).__backLinkScrollInit) {
    (window as any).__backLinkScrollInit = true;
    const update = () => {
      document
        .querySelectorAll(".back-link")
        .forEach((el) =>
          el.classList.toggle("is-scrolled", window.scrollY > 24),
        );
    };
    window.addEventListener("scroll", update, { passive: true });
    document.addEventListener("astro:page-load", update);
    update();
  }
</script>

<script>
  import { resolveLang, rootLang } from "../../lib/lang";

  function syncBackLinkLang(lang: "es" | "en") {
    const isEn = lang === "en";
    document.querySelectorAll(".back-link").forEach((el) => {
      const aria =
        el.getAttribute(isEn ? "data-aria-en" : "data-aria-es") ?? "";
      if (aria) el.setAttribute("aria-label", aria);
    });
  }

  function currentLang(): "es" | "en" {
    try {
      const stored = localStorage.getItem("lang");
      if (stored === "en" || stored === "es") return stored;
    } catch {
      // private mode — fall through to root/browser detection
    }
    if (document.documentElement.hasAttribute("data-lang")) return rootLang();
    return resolveLang();
  }

  syncBackLinkLang(currentLang());

  document.addEventListener("langchange", (e) => {
    const lang = (e as CustomEvent<{ lang: "es" | "en" }>).detail.lang;
    syncBackLinkLang(lang);
  });
  document.addEventListener("astro:page-load", () => {
    syncBackLinkLang(currentLang());
  });
  document.addEventListener("astro:after-swap", () => {
    syncBackLinkLang(currentLang());
  });
</script>
