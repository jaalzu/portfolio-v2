<button
  id="lang-toggle"
  class="lang-toggle"
  type="button"
  aria-label="Switch language / Cambiar idioma"
>
  <span class="lang-toggle__option" data-lang-option="es">ES</span>
  <span class="lang-toggle__sep">/</span>
  <span class="lang-toggle__option" data-lang-option="en">EN</span>
</button>

<style>
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 8px 10px;
    margin: -8px -12px;
    border: none;
    background: transparent;
    cursor: pointer;
    font-size: var(--text-xs);
  }

  @media (max-width: 768px) {
    .lang-toggle {
      padding: 4px 16px;
      margin: -12px -16px;
      min-height: 44px;
      min-width: 44px;
      justify-content: center;
    }
  }

  .lang-toggle:focus,
  .lang-toggle:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .lang-toggle__sep {
    color: var(--color-text-muted);
    opacity: var(--opacity-muted);
    transition: opacity var(--transition-fast);
  }

  .lang-toggle:hover .lang-toggle__sep {
    opacity: var(--opacity-full);
  }

  .lang-toggle__option {
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  /* no hover on text — keep muted */
  .lang-toggle__option:hover {
    color: var(--color-text-muted);
  }

  /* Idioma activo resaltado — more white (no primary) */
  :global(html:not([data-lang="en"])) .lang-toggle__option[data-lang-option="es"],
  :global(html[data-lang="en"]) .lang-toggle__option[data-lang-option="en"] {
         color: var(--color-text);
    opacity: var(--opacity-full);
  }


</style>

<script>
  import { rootLang, applyLangToRoot, persistLang } from "../../lib/lang";

  function initLangToggle() {
    const toggle = document.getElementById("lang-toggle");
    if (!toggle || toggle.dataset.bound === "1") return;
    toggle.dataset.bound = "1";
    toggle.addEventListener("click", () => {
      // Single place allowed to persist: explicit user choice wins
      // over future browser-language changes.
      const next = rootLang() === "es" ? "en" : "es";
      applyLangToRoot(next);
      persistLang(next);
      document.dispatchEvent(new CustomEvent("langchange", { detail: { lang: next } }));
    });
  }
  initLangToggle();
  document.addEventListener("astro:page-load", initLangToggle);
  document.addEventListener("astro:after-swap", initLangToggle);
</script>