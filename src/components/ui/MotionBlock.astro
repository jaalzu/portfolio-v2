---
import MotionTitle from "./MotionTitle.astro";

interface Props {
  id: string;
  titleEs: string;
  titleEn: string;
  /** false → sin marco/bg. */
  card?: boolean;
}
const { id, titleEs, titleEn, card = true } = Astro.props;
---

<div
  class:list={["motion-block", { "motion-block--card": card }]}
  id={id}
  data-reveal
>
  <MotionTitle titleEs={titleEs} titleEn={titleEn} />
  <slot />
</div>

<style>
  .motion-block {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-bottom: 2rem;
    scroll-margin-top: var(--space-6);
  }

  .motion-block--card {
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-base);
    padding-inline: 18px;
    padding-block: 1rem 1.5rem;
    background: var(--color-surface-2);
  }

  /* Descripción compartida por todos los bloques */
  .motion-block :global(.motion-desc) {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: var(--font-weight-light);
  }

  .motion-block :global(.motion-desc code) {
    font-family: monospace;
    font-size: 0.9em;
    color: var(--color-text-heading);
    background: var(--color-surface-3);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }
</style>
