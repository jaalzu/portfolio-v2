---
import CopyButton from "./CopyButton.astro";

interface Props {
  titleEs: string;
  titleEn: string;

  id?: string;
}
const { titleEs, titleEn, id } = Astro.props;
---

<div class="motion-title" id={id}>
  <h2 class="motion-title__text">
    <span class="lang-es">{titleEs}</span>
    <span class="lang-en">{titleEn}</span>
  </h2>
  <CopyButton anchor={id ?? true} inline />
</div>

<style>
  .motion-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    scroll-margin-top: var(--space-6);
  }

  .motion-title__text {
    margin: 0;
    min-width: 0;
    flex: 0 1 auto;
    font-family: var(--font-family-enfasis);
    font-size: var(--text-title);
    font-weight: var(--font-weight-medium);
    letter-spacing: normal;
    color: var(--color-text-heading);
    text-wrap: balance;
  }

  .motion-title :global(.copy-btn--inline) {
    flex-shrink: 0;
    align-self: center;
    transform: translateY(-3px);
  }
</style>
