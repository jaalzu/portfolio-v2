---

interface Props {
	title?: string;
	marked?: boolean;
	class?: string;
	i18nKey?: string;
}

const { title, marked = false, class: className = "", i18nKey } = Astro.props;
---

<section class:list={["section", className]}>
  {
    title && (
      <h2 class="section__title">
        <span class="section__title-text" data-i18n={i18nKey}>{title}</span>
        <span class="section__title-divider" aria-hidden="true"></span>
      </h2>
    )
  }
  <div class="section__content">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-12);
  }


  @media (max-width: 768px) {
    .section {
      padding-block: var(--space-6);
    }

    .section:first-child {
      padding-top: var(--space-2);
    }
  }
 .section__content {
    display: flow-root;
  }
 

  .section__title {
    display: flex;
    align-items: center;
    font-size: var(--text-sm);
        color: var(--color-text);
  }

  .section__title-text {
    flex-shrink: 0;
  }

  .section__title-divider {
    flex: 1;
    height: 1px;
    background: color-mix(in oklch, var(--color-border-soft) 40%, transparent);
    margin-left: 0.8rem;
  }
 
</style>