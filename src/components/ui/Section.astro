---
import Icon from "../icons/Icon.astro";

interface Props {
	title?: string;
	marked?: boolean;
	class?: string;
	i18nKey?: string;
}

const { title, marked = false, class: className = "", i18nKey } = Astro.props;
---

<section class:list={["section", className]}>
  {
    title && (
      <h2 class="section__title">
        <span class="section__title-text" data-i18n={i18nKey}>{title}</span>
        <span class="section__title-divider" aria-hidden="true"></span>
      </h2>
    )
  }
  <div class="section__content">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-12);
  }

  .section:first-child {
    padding-top: var(--space-4);
  }

  @media (max-width: 768px) {
    .section {
      padding-block: var(--space-6);
    }

    .section:first-child {
      padding-top: var(--space-2);
    }
  }

  .section__content {
    display: flow-root;
    padding-inline: 3px;
  }

  .section__title {
    display: flex;
    align-items: center;
    margin: 0 0 var(--space-4);
    font-size: var(--text-md);
    font-weight: var(--font-weight-medium);
        color: var(--color-text-heading);

  }

  .section__title-text {
    flex-shrink: 0;
  }

  .section__title-divider {
    flex: 1;
    height: 1px;
    background: color-mix(in oklch, var(--color-border-soft) 45%, transparent);
    margin-left: 0.8rem;
    min-width: 24px;
  }

  :global(.section__mark) {
    align-self: flex-start;
    margin-left: 4px;
    color: var(--color-primary);
  }
</style>