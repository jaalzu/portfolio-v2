---
interface Props {
  title?: string;
  marked?: boolean;
  class?: string;
  i18nKey?: string;
  index?: number;
}

const { title, class: className = "", i18nKey, index = 0 } = Astro.props;
---

<section class:list={["section", className]}>
  {title && (
    <h2 class="section__title reveal" style={`--i: ${index}`}>
      <span class="section__title-text" data-i18n={i18nKey}>
        {title}
      </span>
      <span class="section__title-divider" aria-hidden="true"></span>
    </h2>
  )}
  <div class="section__content">
    <slot />
  </div>
</section>

<style>
  @keyframes revealUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .reveal {
    opacity: 0;
    animation: revealUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(650ms + var(--i, 0) * 110ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
      opacity: 1;
    }
  }

  :global(html.no-home-intro .reveal) {
    animation: none !important;
    opacity: 1 !important;
  }

  .section {
    padding-block: var(--space-12);
  }

  @media (max-width: 768px) {
    .section {
      padding-block: var(--space-6);
    }

    .section:first-child {
      padding-top: var(--space-2);
    }
  }
  .section__content {
    display: flow-root;
  }

  .section__title {
    z-index: 1;

    display: flex;
    align-items: center;
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .section__title-text {
    flex-shrink: 0;
  }

  .section__title-divider {
    flex: 1;
    height: 1px;
    margin-left: 0.8rem;
  }
</style>
