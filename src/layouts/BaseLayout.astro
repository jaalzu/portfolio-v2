---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portfolio javalzu" } = Astro.props;
---

<!doctype html>
<html lang="es" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="image" content="/og.png" />
    <meta property="og:image" content="/og.png" />
    <title>{title}</title>
    <link
      rel="preload"
      href="/fonts/geist-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/newsreader-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <ClientRouter />

    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="0bc7277c-a5a1-4bfb-992c-7592f80b5dce"
    ></script>
    <!-- Early lang init: manual choice wins, else follow browser, default es.
         Never writes to localStorage — only the toggle button persists. -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("lang");
          const nav = navigator.language || "es";
          const lang =
            stored === "en" || stored === "es"
              ? stored
              : nav.toLowerCase().indexOf("en") === 0
                ? "en"
                : "es";
          document.documentElement.setAttribute("data-lang", lang);
          document.documentElement.lang = lang;
        } catch {
          // private mode etc. — keep Spanish default
        }
      })();
    </script>
    <script>
      document.addEventListener("astro:before-swap", (event) => {
        if (sessionStorage.getItem("home-intro-played") === "1") {
          event.newDocument.documentElement.classList.add("no-home-intro");
        }
      });
    </script>
  </head>
  <body>
    <div class="top-fade" aria-hidden="true" transition:persist></div>

    <slot />

    <script>
      import { initInView } from "../script/inView";
      document.addEventListener("astro:page-load", initInView);
    </script>
  </body>
</html>
