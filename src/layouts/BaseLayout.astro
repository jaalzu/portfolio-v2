---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portfolio javalzu" } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="image" content="/og.png" />
    <meta property="og:image" content="/og.png" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
    <script is:inline>
      (() => {
        const ORDER = ["/", "/skills", "/skills/"];
        const normalize = (p) => (p.length > 1 && p.endsWith("/") ? p.slice(0, -1) : p || "/");
        const getDir = (from, to) => {
          const a = ORDER.indexOf(normalize(from));
          const b = ORDER.indexOf(normalize(to));
          if (a !== -1 && b !== -1) return b > a ? "forward" : "back";
          return "forward";
        };
        const safeSet = (dir) => {
          document.documentElement.dataset.direction = dir;
          try { sessionStorage.setItem("vt-direction", dir); } catch {}
        };
        try {
          const saved = sessionStorage.getItem("vt-direction");
          if (saved) document.documentElement.dataset.direction = saved;
        } catch {}

        document.addEventListener("click", (e) => {
          const a = e.target.closest("a[href]");
          if (!a) return;
          const href = a.getAttribute("href");
          if (!href || href.startsWith("#") || href.startsWith("mailto:") || href.startsWith("tel:")) return;
          if (a.target === "_blank" || a.hasAttribute("download")) return;
          if (/^https?:\/\//.test(href)) {
            try { if (new URL(href).origin !== location.origin) return; } catch { return; }
          }
          let toPath;
          try { toPath = new URL(href, location.origin).pathname; } catch { return; }
          if (normalize(toPath) === normalize(location.pathname)) return;
          const dir = getDir(location.pathname, toPath);
          safeSet(dir);
        }, { capture: true });

        document.addEventListener("astro:before-preparation", (ev) => {
          const to = ev.to || ev.detail?.to;
          if (!to) return;
          let toPath;
          try { toPath = new URL(to, location.origin).pathname; } catch { return; }
          safeSet(getDir(location.pathname, toPath));
        });

        window.addEventListener("popstate", () => {
          const dir = normalize(location.pathname) === "/" ? "back" : "forward";
          try {
            const pending = sessionStorage.getItem("vt-direction");
            if (pending !== dir) safeSet(dir);
          } catch { safeSet(dir); }
        });
      })();
    </script>
  </body>
  <style is:global>
    /* Evita flash/spark: aisla el par y asegura fondo consistente */
    ::view-transition-group(root) {
      animation-duration: 260ms;
      animation-timing-function: cubic-bezier(0.33, 0, 0.67, 1);
    }
    ::view-transition-image-pair(root) {
      isolation: isolate;
    }
    html::view-transition-old(root),
    html::view-transition-new(root) {
      mix-blend-mode: normal;
      background: var(--color-bg);
      /* evita que browser aplique fade por defecto además del slide */
      animation-fill-mode: both;
    }

    /* FALLBACK inicial = forward */
    html:not([data-direction])::view-transition-old(root) {
      animation-name: slide-out-left;
      animation-duration: 260ms;
      animation-timing-function: cubic-bezier(0.33, 0, 0.67, 1);
      animation-fill-mode: both;
    }
    html:not([data-direction])::view-transition-new(root) {
      animation-name: slide-in-right;
      animation-duration: 260ms;
      animation-timing-function: cubic-bezier(0.33, 0, 0.67, 1);
      animation-fill-mode: both;
    }
    /* FORWARD: home -> skills */
    html[data-direction="forward"]::view-transition-old(root) {
      animation-name: slide-out-left;
      animation-duration: 260ms;
      animation-timing-function: cubic-bezier(0.33, 0, 0.67, 1);
      animation-fill-mode: both;
    }
    html[data-direction="forward"]::view-transition-new(root) {
      animation-name: slide-in-right;
      animation-duration: 260ms;
      animation-timing-function: cubic-bezier(0.33, 0, 0.67, 1);
      animation-fill-mode: both;
    }
    /* BACK: skills -> home (inversa) */
    html[data-direction="back"]::view-transition-old(root) {
      animation-name: slide-out-right;
      animation-duration: 260ms;
      animation-timing-function: cubic-bezier(0.33, 0, 0.67, 1);
      animation-fill-mode: both;
    }
    html[data-direction="back"]::view-transition-new(root) {
      animation-name: slide-in-left;
      animation-duration: 260ms;
      animation-timing-function: cubic-bezier(0.33, 0, 0.67, 1);
      animation-fill-mode: both;
    }

    @keyframes slide-out-left {
      from { opacity: 1; transform: translateX(0); }
      to { opacity: 0; transform: translateX(-18px); }
    }
    @keyframes slide-in-right {
      from { opacity: 0; transform: translateX(18px); }
      to { opacity: 1; transform: translateX(0); }
    }
    @keyframes slide-out-right {
      from { opacity: 1; transform: translateX(0); }
      to { opacity: 0; transform: translateX(18px); }
    }
    @keyframes slide-in-left {
      from { opacity: 0; transform: translateX(-18px); }
      to { opacity: 1; transform: translateX(0); }
    }

    @media (prefers-reduced-motion: reduce) {
      ::view-transition-old(root),
      ::view-transition-new(root),
      ::view-transition-group(root) {
        animation: none !important;
        animation-duration: 0.01ms !important;
      }
    }
  </style>
</html>