---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/home/ProjectCard.astro";
import SkillItem from "../components/home/SkillItem.astro";
import Section from "../components/ui/Section.astro";
import Footer from "../components/home/Footer.astro";
import Hero from "../components/home/Hero.astro";
import AboutMe from "../components/home/AboutMe.astro";

import I18nSync from "../components/I18nSync.astro";
import { translations } from "../data/translations";

const t = translations.es;

const projects = [
  {
    title: "TratoLibre",
    githubUrl: "https://github.com/jaalzu/tratolibre",
    liveUrl: "https://tratolibre.vercel.app/",
  },
  {
    title: "PickYourColor",
    githubUrl: "https://github.com/jaalzu/PickYourColory",
    liveUrl:
      "https://pick-your-color.vercel.app/?colors=000000-FFFFFF-92b9b9-6420c2-cecece",
  },
  {
    title: "JavaCourses",
    githubUrl: "https://github.com/jaalzu/courses-webapp",
    liveUrl: "https://courses-webapp-delta.vercel.app/login",
  },
];
---

<BaseLayout title="Javier Alzú">
  <I18nSync />
  <main class="page">
    <Section>
      <Hero t={t} />
    </Section>

    <Section
      title={t.sections.projects}
      i18nKey="sections.projects"
      marked
      class="projects-section"
      index={0}
    >
      <div class="projects-grid">
        <SkillItem
          title={t.motionPromo.title}
          subtitle={t.motionPromo.subtitle}
          titleKey="motionPromo.title"
          subtitleKey="motionPromo.subtitle"
          href="/motion"
          index={0}
        />
        <SkillItem
          title={t.skillsPromo.title}
          subtitle={t.skillsPromo.subtitle}
          titleKey="skillsPromo.title"
          subtitleKey="skillsPromo.subtitle"
          href="/skills"
          index={1}
        />
        {projects.map((project, i) => (
          <ProjectCard
            title={project.title}
            description={t.projects[i]}
            i18nKey={`projects.${i}`}
            githubUrl={project.githubUrl}
            liveUrl={project.liveUrl}
            index={i + 2}
          />
        ))}
      </div>
    </Section>

    <Section
      title={t.sections.aboutMe}
      i18nKey="sections.aboutMe"
      marked
      class="about-section"
      index={1}
    >
      <AboutMe texts={t.about} province={t.province} />
    </Section>
  </main>
  <Footer coverSrc="./portft1.webp" email="javieralzuu@gmail.com" />

  <script>
    document.addEventListener("astro:page-load", () => {
      sessionStorage.setItem("home-intro-played", "1");
    });
  </script>
</BaseLayout>

<style>
  .page {
    max-width: var(--content-max-width);
    margin-inline: auto;
  }

  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
    margin-bottom: var(--space-8);
  }

  @media (max-width: 768px) {
    .page {
      padding-inline: calc(var(--space-4) + var(--space-1));
    }

    .projects-grid {
      margin-bottom: var(--space-4);
    }
  }

  :global(.about-section) {
    padding-bottom: 0 !important;
    margin-bottom: 0;
  }
  :global(.about-section .section__content) {
    margin-bottom: 0;
    padding-bottom: 0;
  }
</style>
