---
import BaseLayout from "../layouts/BaseLayout.astro";
import Banner from "../components/Banner.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import GithubIcon from "../components/GithubIcon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TechBadge from "../components/TechBadge.astro";
import Section from "../components/Section.astro";
import Footer from "../components/Footer.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import LanguageToggle from "../components/LanguageToggle.astro";
 
 const projects = [
  {
    title: "PickYourColor",
    description: "Una forma interactiva de elegir tus colores y fuentes en tiempo real.",
    imageSrc: "/projects/pyk.svg",
    githubUrl: "https://github.com/jaalzu/PickYourColory",
    liveUrl: "https://pick-your-color.vercel.app/?colors=000000-FFFFFF-92b9b9-6420c2-cecece",
  },
  {
    title: "JavaCourses",
    description: "Un marketplace de artículos nuevos y usados con chat integrado.",
    imageSrc: "/projects/java.svg",
    githubUrl: "https://github.com/jaalzu/courses-webapp",
    liveUrl: "https://courses-webapp-delta.vercel.app/login",
  },
  {
    title: "TratoLibre",
    description: "Una forma interactiva de elegir tus colores y fuentes en tiempo real.",
    imageSrc: "/projects/tl.svg",
    githubUrl: "https://github.com/jaalzu/tratolibre",
    liveUrl: "https://tratolibre.vercel.app/",
  },
 
];

const techStack = [
  { name: "HTML", icon: "html5" },
  { name: "CSS", icon: "css" },
  { name: "Javascript", icon: "javascript" },
  { name: "Git", icon: "git" },
  { name: "Figma", icon: "figma" },
  { name: "Tailwind", icon: "tailwind" },
  { name: "React", icon: "react" },
  { name: "Next.js", icon: "nextjs" },
  { name: "TypeScript", icon: "typescript" },
  { name: "Astro", icon: "astro" },
];

const journey = [
  {
    year: "2021",
    text: "Started learning programming fundamentals with PSeInt, eventually moving into Python and SQL.",
  },
  {
    year: "2022",
    text: "I got into web development with HTML and CSS.",
  },
{
  year: "2023",
  text: "Learned to build interactive experiences with JavaScript while exploring UI/UX principles.",
},
{
  year: "2024",
  text: "Started building real applications with React, exploring new tools and development practices.",
},
  {
    year: "2025 - ∞",
    text: "I kept building, breaking, fixing, and learning, constantly pushing myself to become a better software developer.",
  },
];
---

<BaseLayout title="Javier Alzú — Frontend Developer">
  <main class="page">
    <Section>
      <div class="top-bar">
        <LanguageToggle />
        <ThemeToggle />
      </div>
 
      <Banner
        name="Javier Alzú"
        role="Chaco, Argentina"
        coverSrc="./portft1.webp"
        avatarSrc="/java2.jpg"
      />
 
      <div class="about">
        <p class="about__bio">
         Software developer focused on <strong>building</strong> for the frontend. I create <strong>web applications</strong>, <strong>landing pages</strong>, and <strong>interfaces</strong> for digital products within the modern JavaScript ecosystem.  Self-taught, driven by curiosity and challenges.
        </p>
        <p class="about__bio">
          Most of my journey has been built independently, and now I'm looking to bring that experience into a team, collaborate with great people, and build bigger products together. You can reach me via{" "}
          <a href="mailto:javieralzuu@gmail.com" class="about__email-link">
            <Icon name="mail-outline" size={14} class="about__at-icon" />email
          </a>.
        </p>
 
        <div class="about__actions">
          <Button href="https://www.linkedin.com/in/javier-alz%C3%BA-332ab2261/" variant="icon" ariaLabel="LinkedIn" target="_blank" data-tooltip="LinkedIn">
            <Icon name="linkedin" size={28} />
          </Button>
          <Button href="https://github.com/jaalzu" variant="icon" class="tab-btn" ariaLabel="GitHub" target="_blank" data-tooltip="GitHub">
            <GithubIcon />
          </Button>
          <Button href="/cv.pdf" variant="icon" ariaLabel="Descargar CV" data-tooltip="CV" download="Javier-Alzu-CV.pdf">
            <Icon name="document" size={26} />
          </Button>
        </div>
      </div>
    </Section>
 
    <Section title="Projects" marked class="projects-section">
      <div class="projects-grid">
        {
          projects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              imageSrc={project.imageSrc}
              githubUrl={project.githubUrl}
              liveUrl={project.liveUrl}
            />
          ))
        }
      </div>
    </Section>
 
    <Section title="Tech stack" marked class="tech-section">
      <div class="tech-grid">
        {techStack.map((tech) => <TechBadge name={tech.name} icon={tech.icon} />)}
      </div>
    </Section>
 
    <Section title="Journey" marked class="journey-section">
      <ol class="journey">
        {
          journey.map((item) => (
            <li class="journey__item">
              <span class="journey__year">{item.year}</span>
              <p class="journey__text">{item.text}</p>
            </li>
          ))
        }
      </ol>
    </Section>
 
    <Footer coverSrc="./portft1.webp" email="javieralzuu@gmail.com" />
  </main>
</BaseLayout>
 
<style>
  .page {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
 
  .top-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
 
  .about {
    padding-block: var(--space-8) ;
 
  }
 
  .about__bio {
    margin: 0 0 var(--space-6);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-text);
  }
 
  .about__bio strong {
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
  }
 
  .about__email-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    vertical-align: middle;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, currentColor 35%, transparent);
    text-underline-offset: 2px;
    transition: text-decoration-color var(--transition-fast);
  }
 
  .about__email-link:hover {
    text-decoration-color: currentColor;
  }
 
  .about__at-icon {
    color: var(--color-primary);
  }
 
  .about__actions {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    margin-top: var(--space-16);
  }
 
  /* Gap botones de contacto → heading "Projects" (Figma: ~73px) */
  .projects-section {
    padding-top: var(--space-16);
  }
 
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    /* Gap entre cards (Figma: ~62px horizontal / ~14px vertical) */
    column-gap: var(--space-12);
    row-gap: var(--space-4);
    margin-bottom: 5rem;
  }
 
  /* Gap cards → heading "Tech stack" (Figma: gap generoso, ~espacio de sección completo) */
 
 
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-16) var(--space-12);
    width: calc(100% + var(--space-4) * 2);
    margin-inline: calc(var(--space-4) * -1);
    margin-bottom: 5rem;
  }
 
  .journey {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
 
  .journey__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-6);
  }
 
  .journey__year {
    flex-shrink: 0;
    width: 96px;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }
 
  .journey__text {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }
 
  @media (max-width: 560px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
 
    .tech-grid {
      grid-template-columns: repeat(3, 1fr);
    }
 
    .journey__item {
      flex-direction: column;
      gap: var(--space-1);
    }
  }
</style>