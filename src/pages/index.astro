---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/home/ProjectCard.astro";
import SkillItem from "../components/home/SkillItem.astro";
import Section from "../components/ui/Section.astro";
import Footer from "../components/home/Footer.astro";
import Hero from "../components/home/Hero.astro";
import AboutMe from "../components/home/AboutMe.astro";

import I18nSync from "../components/I18nSync.astro";

// Page-level copy (default lang: Spanish).
// Section / card copy will move into those components next;
// Hero + AboutMe already own their copy.
const copy = {
  es: {
    projectsTitle: "Proyectos",
    aboutTitle: "Mas sobre mi",
    motionTitle: "Web Motion",
    motionSub: "Principios de animaciones web",
    skillsTitle: "Skills",
    skillsSub: "Una colección de skills para mejorar tus interfaces.",
    projects: [
      "Marketplace para comprar y vender artículos nuevos y usados.",
      "Una forma interactiva de elegir tus colores y fuentes en tiempo real.",
      "Plataforma privada para la gestión de cursos, alumnos y contenidos.",
    ],
  },
  en: {
    projectsTitle: "Projects",
    aboutTitle: "About Me",
    motionTitle: "Web Motion",
    motionSub: "Principles of web animations",
    skillsTitle: "Skills",
    skillsSub: "A collection of skills to improve your interfaces.",
    projects: [
      "Modern marketplace for buying and selling new and second-hand items.",
      "An interactive way to pick your colors and fonts in real time.",
      "Private platform to manage courses, students, and content.",
    ],
  },
} as const;

const projects = [
  {
    title: "TratoLibre",
    githubUrl: "https://github.com/jaalzu/tratolibre",
    liveUrl: "https://tratolibre.vercel.app/",
  },
  {
    title: "PickYourColor",
    githubUrl: "https://github.com/jaalzu/PickYourColory",
    liveUrl:
      "https://pick-your-color.vercel.app/?colors=000000-FFFFFF-92b9b9-6420c2-cecece",
  },
  {
    title: "JavaCourses",
    githubUrl: "https://github.com/jaalzu/courses-webapp",
    liveUrl: "https://courses-webapp-delta.vercel.app/login",
  },
];
---

<BaseLayout title="Javier Alzú">
  <I18nSync />
  <main class="page">
    <Section>
      <Hero />
    </Section>

    <Section
      titleEs={copy.es.projectsTitle}
      titleEn={copy.en.projectsTitle}
      marked
      class="projects-section"
      index={0}
    >
      <div class="projects-grid">
        <SkillItem
          titleEs={copy.es.motionTitle}
          titleEn={copy.en.motionTitle}
          subtitleEs={copy.es.motionSub}
          subtitleEn={copy.en.motionSub}
          href="/motion"
          index={0}
        />
        <SkillItem
          titleEs={copy.es.skillsTitle}
          titleEn={copy.en.skillsTitle}
          subtitleEs={copy.es.skillsSub}
          subtitleEn={copy.en.skillsSub}
          href="/skills"
          index={1}
        />
        {projects.map((project, i) => (
          <ProjectCard
            title={project.title}
            descriptionEs={copy.es.projects[i]}
            descriptionEn={copy.en.projects[i]}
            githubUrl={project.githubUrl}
            liveUrl={project.liveUrl}
            index={i + 2}
          />
        ))}
      </div>
    </Section>

    <Section
      titleEs={copy.es.aboutTitle}
      titleEn={copy.en.aboutTitle}
      marked
      class="about-section"
      index={1}
    >
      <AboutMe />
    </Section>
  </main>
  <Footer coverSrc="./portft1.webp" email="javieralzuu@gmail.com" />

  <script>
    document.addEventListener("astro:page-load", () => {
      sessionStorage.setItem("home-intro-played", "1");
    });
  </script>
</BaseLayout>

<style>
  .page {
    max-width: var(--content-max-width);
    margin-inline: auto;
  }

  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
    margin-bottom: var(--space-8);
  }

  @media (max-width: 768px) {
    .page {
      padding-inline: calc(var(--space-4) + var(--space-1));
    }

    .projects-grid {
      margin-bottom: var(--space-4);
    }
  }

  :global(.about-section) {
    padding-bottom: 0 !important;
    margin-bottom: 0;
  }
  :global(.about-section .section__content) {
    margin-bottom: 0;
    padding-bottom: 0;
  }
</style>
