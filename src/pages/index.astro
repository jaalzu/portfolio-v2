---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/home/ProjectCard.astro";
import SkillItem from "../components/home/SkillItem.astro";
import Section from "../components/ui/Section.astro";
import Footer from "../components/home/Footer.astro";
import Hero from "../components/home/Hero.astro";
import AboutMe from "../components/home/AboutMe.astro";

import I18nSync from "../components/I18nSync.astro";
import { translations } from "../data/translations";

const t = translations.es;

const projects = [
	{
		title: "TratoLibre",
		imageSrc: "/projects/tl.svg",
		githubUrl: "https://github.com/jaalzu/tratolibre",
		liveUrl: "https://tratolibre.vercel.app/",
	},
	{
		title: "PickYourColor",
		imageSrc: "/projects/pyk.svg",
		githubUrl: "https://github.com/jaalzu/PickYourColory",
		liveUrl:
			"https://pick-your-color.vercel.app/?colors=000000-FFFFFF-92b9b9-6420c2-cecece",
	},
	{
		title: "JavaCourses",
		imageSrc: "/projects/java.svg",
		githubUrl: "https://github.com/jaalzu/courses-webapp",
		liveUrl: "https://courses-webapp-delta.vercel.app/login",
	},
];


---

<BaseLayout title="Javier Alzú">
  <I18nSync />
  <main class="page">
    <Section>
      <Hero t={t} />
    </Section>

    <Section title={t.sections.projects} i18nKey="sections.projects" marked class="projects-section">
      <div class="projects-grid">
        {
          projects.map((project, i) => (
            <ProjectCard
              title={project.title}
              description={t.projects[i]}
              i18nKey={`projects.${i}`}
              imageSrc={project.imageSrc}
              githubUrl={project.githubUrl}
              liveUrl={project.liveUrl}
            />
          ))
        }
      </div>
    </Section>

    <Section title={t.sections.techStack} i18nKey="sections.techStack" marked class="tech-section">
      <div class="skills-grid">
        <SkillItem
          title={t.skillsPromo.title}
          subtitle={t.skillsPromo.subtitle}
          href="/skills"
        />
      </div>
    </Section>

   <Section title={t.sections.aboutMe} i18nKey="sections.aboutMe" marked class="about-section">
  <AboutMe texts={t.about} />
</Section>

  </main>
  <Footer coverSrc="./portft1.webp" email="javieralzuu@gmail.com" />
</BaseLayout>

<style>
  .page {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    column-gap: var(--space-4);
    row-gap: var(--space-4);
    margin-bottom: var(--space-16);
  }

  .skills-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  @media (max-width: 768px) {
    .page {
      padding-inline: calc(var(--space-4) + var(--space-1));
    }

    .projects-grid {
      margin-bottom: var(--space-6);
    }

    .skills-grid {
      margin-bottom: var(--space-4);
    }
  }

  @media (max-width: 560px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>