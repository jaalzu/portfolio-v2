---
// src/pages/motion.astro
// Orquestador: solo arma el layout y compone las secciones de src/components/motion/.
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import BackLink from "../components/ui/BackLink.astro";
import SkillSection from "../components/skills/SkillSection.astro";
import I18nSync from "../components/I18nSync.astro";
import { translations } from "../data/translations";

import Principles from "../components/motion/intro/Principles.astro";
import TimingRows from "../components/motion/timing/TimingRows.astro";
import LinksDemo from "../components/motion/LinksDemo.astro";
import ButtonsDemo from "../components/motion/ButtonsDemo.astro";
import CardFlipDemo from "../components/motion/CardFlipDemo.astro";
import CopyDemo from "../components/motion/CopyDemo.astro";

const t = translations.es;
---

<BaseLayout title="Motion Design — Javier Alzú">
  <I18nSync />
  <main class="page">
    <Section>
      <BackLink />

      <div class="skills-header">
        <h1 class="skills-header__title" data-i18n="motionPage.title">
          {t.motionPage.title}
        </h1>
        <p class="skills-header__intro" data-i18n="motionPage.subtitle">
          {t.motionPage.subtitle}
        </p>
      </div>
    </Section>

    <Section>
      <!-- Principios: sin header de SkillSection, la descripción vive dentro del mismo
           contenedor que las tarjetas (ver PrinciplesGrid.astro) -->
      <div id="principles">
        <Principles />
      </div>

      <div id="timing">
        <TimingRows />
      </div>

      <!-- <SkillSection
        id="buttons"
        title={t.motionPage.buttons.title}
        description={t.motionPage.buttons.description}
        titleKey="motionPage.buttons.title"
        descKey="motionPage.buttons.description"
      >
        <ButtonsDemo />
      </SkillSection> -->

      <!-- Card flip: no va dentro de SkillSection en el original, se mantiene igual -->
      <!-- <CardFlipDemo /> -->

      <!-- <SkillSection
        id="copy-action"
        title={t.motionPage.copyAction.title}
        description={t.motionPage.copyAction.description}
        titleKey="motionPage.copyAction.title"
        descKey="motionPage.copyAction.description"
      >
        <CopyDemo />
      </SkillSection> -->
    </Section>
  </main>
</BaseLayout>

<style>
  .page {
    max-width: var(--content-max-width);
    margin-inline: auto;
    overflow: hidden;
  }

  .skills-header__title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
    color: var(--color-text-heading);
    text-wrap: balance;
  }

  .skills-header__intro {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--font-weight-light);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    text-wrap: pretty;
  }

  @media (max-width: 768px) {
    .page {
      padding-inline: calc(var(--space-4) + var(--space-1));
    }
    .skills-header__title {
      margin-bottom: var(--space-2);
    }
  }
</style>
