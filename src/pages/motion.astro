---
// src/pages/motion.astro
// Orquestador: solo arma el layout y compone las secciones de src/components/motion/.
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import BackLink from "../components/ui/BackLink.astro";
import KeyframesRows from "../components/motion/keyframes/KeyframesRows.astro";
import I18nSync from "../components/I18nSync.astro";
import { translations } from "../data/translations";
import TriggersRows from "../components/motion/triggers/TriggersRows.astro";
import Principles from "../components/motion/intro/Principles.astro";
import TimingRows from "../components/motion/timing/TimingRows.astro";
import SvgRows from "../components/motion/svgs/SvgRows.astro";
import ShowcaseRows from "../components/motion/complex/ShowcaseRows.astro";
import SummaryRows from "../components/motion/summary/SummaryRows.astro";
const t = translations.es;
---

<BaseLayout title="Motion Design — Javier Alzú">
  <I18nSync />
  <main class="page">
    <Section>
      <BackLink />

      <div class="skills-header">
        <h1 class="skills-header__title" data-i18n="motionPage.title">
          {t.motionPage.title}
        </h1>
        <p class="skills-header__intro" data-i18n="motionPage.subtitle">
          {t.motionPage.subtitle}
        </p>
      </div>
    </Section>

    <Section>
      <div id="principles" data-reveal>
        <Principles />
      </div>

      <div id="timing" data-reveal>
        <TimingRows />
      </div>

      <div id="triggers" data-reveal>
        <TriggersRows />
      </div>

      <div id="keyframes" data-reveal>
        <KeyframesRows />
      </div>

      <div id="svg" data-reveal>
        <SvgRows />
      </div>

      <div id="showcase" data-reveal>
        <ShowcaseRows />
      </div>

      <div id="summary" data-reveal>
        <SummaryRows />
      </div>
    </Section>
  </main>
</BaseLayout>

<style>
  .page {
    max-width: var(--content-max-width);
    margin-inline: auto;
    overflow: hidden;
    margin-bottom: 6rem;
  }

  .skills-header__title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-family-enfasis);
    font-style: italic;
    font-size: var(--text-xl);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-tight);
    letter-spacing: normal;
    color: var(--color-text-heading);
    text-wrap: balance;
  }

  .skills-header__intro {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--font-weight-light);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    text-wrap: pretty;
  }

  @media (max-width: 768px) {
    .page {
      padding-inline: calc(var(--space-4) + var(--space-1));
    }
    .skills-header__title {
      margin-bottom: var(--space-2);
    }
  }
</style>
