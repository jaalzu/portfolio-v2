---
// src/pages/motion.astro
// Orquestador: solo arma el layout y compone las secciones de src/components/motion/.
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import BackLink from "../components/ui/BackLink.astro";
import KeyframesRows from "../components/motion/keyframes/KeyframesRows.astro";
import I18nSync from "../components/I18nSync.astro";
import TriggersRows from "../components/motion/triggers/TriggersRows.astro";
import Principles from "../components/motion/intro/Principles.astro";
import TimingRows from "../components/motion/timing/TimingRows.astro";
import SvgRows from "../components/motion/svgs/SvgRows.astro";
import ShowcaseRows from "../components/motion/complex/ShowcaseRows.astro";
import SummaryRows from "../components/motion/summary/SummaryRows.astro";

// Copy lives here (default lang: Spanish). Taken from translations.ts motionPage.
const copy = {
  es: {
    title: "Principios de Animación Web",
    subtitle: "Una guía rápida e interactiva para aprender.",
  },
  en: {
    title: "Principles of Web Animation",
    subtitle: "A fast and interactive way to learn.",
  },
} as const;
---

<BaseLayout title="Motion Design — Javier Alzú">
  <I18nSync />
  <main class="page">
    <Section>
      <BackLink />

      <div class="skills-header">
        <h1 class="skills-header__title">
          <span class="lang-es">{copy.es.title}</span>
          <span class="lang-en">{copy.en.title}</span>
        </h1>
        <p class="skills-header__intro">
          <span class="lang-es">{copy.es.subtitle}</span>
          <span class="lang-en">{copy.en.subtitle}</span>
        </p>
      </div>
    </Section>

    <Section>
      <Principles />
      <TimingRows />
      <TriggersRows />
      <KeyframesRows />
      <SvgRows />
      <ShowcaseRows />
      <SummaryRows />
    </Section>
  </main>
</BaseLayout>

<style>
  .page {
    position: relative;
    max-width: var(--content-max-width);
    margin-inline: auto;
    overflow: visible;
    margin-bottom: 6rem;
  }
  [data-reveal] {
    scroll-margin-top: var(--space-6);
  }
  .skills-header__title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-family-enfasis);
    font-style: italic;
    font-size: var(--text-xl);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-tight);
    letter-spacing: normal;
    color: var(--color-text-heading);
    text-wrap: balance;
  }

  .skills-header__intro {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--font-weight-light);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    text-wrap: pretty;
  }

  @media (max-width: 768px) {
    .page {
      padding-inline: calc(var(--space-4) + var(--space-1));
    }
    .skills-header__title {
      margin-bottom: var(--space-2);
    }
  }
  /* Compensa el BackLink fijo (fuera del flujo) en desktop */
  @media (min-width: 1101px) {
    .page {
      padding-top: 6rem;
    }
  }
</style>
