---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import BackLink from "../components/ui/BackLink.astro";
import GithubIcon from "../components/icons/GithubIcon.astro";
import CopyCommand from "../components/skills/CopyCommand.astro";
import SkillSection from "../components/skills/SkillSection.astro";
import TypographyDemo from "../components/skills/demos/typography/TypographyDemo.astro";
import AccessibilityDemo from "../components/skills/demos/accesibility/AccessibilityDemo.astro";
import TokenDemo from "../components/skills/demos/token/TokenDemo.astro";
import MorphingDemo from "../components/skills/demos/morph/MorphingDemo.astro";
import I18nSync from "../components/I18nSync.astro";

// Copy lives here (default lang: Spanish). Taken from translations.ts skillsPage.
const copy = {
  es: {
    title: "Agentic Skills",
    subtitle: "Skills prácticas para mejores interfaces.",
    typography: {
      title: "Fundamentos de Tipografía",
      description:
        "El texto es el corazón de cada interfaz. Construye o audita tu tipografía para fortalecer la legibilidad, la jerarquía, la accesibilidad y la consistencia visual, ofreciendo así mejores experiencias de usuario.",
    },
    accessibility: {
      title: "Accesibilidad — Foco y Feedback",
      description:
        "Tu web tiene que ser accesible para todos, sin excepciones. Construí o auditá el foco visible, los errores anunciados a tiempo y el feedback en vivo de tu interfaz.",
    },
    designTokens: {
      title: "Fundamentos de Tokens",
      description:
        "Un diseño no es consistente porque se vea bien una vez, sino porque todo viene de la misma fuente. Tocá un token y mirá cómo cambian varios componentes a la vez.",
    },
  },
  en: {
    title: "Agentic Skills",
    subtitle: "Practical skills for better interfaces.",
    typography: {
      title: "Typography Foundation",
      description:
        "Text is at the heart of every interface. Build or audit your typography to strengthen legibility, hierarchy, accessibility and visual consistency for better user experiences.",
    },
    accessibility: {
      title: "Accessibility — Focus & Feedback",
      description:
        "Your site needs to be accessible to everyone, no exceptions. Build or audit visible focus states, timely error announcements, and live feedback across your interface.",
    },
    designTokens: {
      title: "Design Tokens Foundation",
      description:
        "A design isn't consistent because it looks good once — it's consistent because everything comes from the same source. Change one token and watch several components update at once.",
    },
  },
} as const;
---

<BaseLayout title="Skills — Javier Alzú">
  <I18nSync />
  <main class="page">
    <Section>
      <BackLink />

      <div class="skills-header">
        <h1 class="skills-header__title">{copy.en.title}</h1>
        <p class="skills-header__intro sans-italic-text">
          <span class="lang-es">{copy.es.subtitle}</span>
          <span class="lang-en">{copy.en.subtitle}</span>
        </p>
      </div>

      <CopyCommand
        command="npx skills add jaalzu/agent-skills"
        githubUrl="https://github.com/jaalzu/agent-skills"
      >
        <GithubIcon slot="github-icon" />
      </CopyCommand>
    </Section>

    <Section>
      <SkillSection
        id="typography"
        titleEs={copy.es.typography.title}
        titleEn={copy.en.typography.title}
        descriptionEs={copy.es.typography.description}
        descriptionEn={copy.en.typography.description}
      >
        <TypographyDemo />
      </SkillSection>

      <SkillSection
        id="accesibility"
        titleEs={copy.es.accessibility.title}
        titleEn={copy.en.accessibility.title}
        descriptionEs={copy.es.accessibility.description}
        descriptionEn={copy.en.accessibility.description}
      >
        <AccessibilityDemo />
      </SkillSection>

      <SkillSection
        id="design-tokens"
        titleEs={copy.es.designTokens.title}
        titleEn={copy.en.designTokens.title}
        descriptionEs={copy.es.designTokens.description}
        descriptionEn={copy.en.designTokens.description}
      >
        <TokenDemo />
      </SkillSection>

      <!-- Morphing icon — reemplaza placeholder vacío -->
      <div class="skill-block-frame">
        <div class="toggle-card">
          <div class="toggle-card__stage morph-card__stage">
            <MorphingDemo />
          </div>
          <div
            class="toggle-card__toolbar morph-toolbar-spacer"
            aria-hidden="true"
          ></div>
        </div>
      </div>
    </Section>
  </main>
</BaseLayout>

<style>
  .page {
    position: relative;
    max-width: var(--content-max-width);
    margin-inline: auto;
    overflow: visible;
  }

  .skills-header__title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-family-enfasis);
    font-style: italic;
    font-size: var(--text-xl);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-tight);
    letter-spacing: normal;
    color: var(--color-text-heading);

    text-wrap: balance;
  }

  .skills-header__intro {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--font-weight-light);

    color: var(--color-text);
    line-height: var(--leading-relaxed);
    text-wrap: pretty;
  }

  .skill-block--placeholder {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 72px;
  }
  .skill-block__icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    object-fit: contain;
    filter: invert(1) brightness(0.95);
  }
  .skill-block__placeholder-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Placeholder upcoming — replica estructura de ToggleCard + SkillSection */
  .skill-block-frame {
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-base);
    padding: var(--card-inset);
    margin-bottom: var(--space-24);
    overflow: hidden;
  }
  .toggle-card {
    position: relative;
    border-radius: var(--radius-base);
    overflow: hidden;
    margin: calc(var(--card-inset) * -1);
    width: calc(100% + var(--card-inset) * 2);
  }
  .toggle-card__stage {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
  }
  .toggle-card__toolbar {
    width: 100%;
    padding: var(--space-2);
    display: flex;
    align-items: center;
    justify-content: center;
    border-top: 1px solid var(--color-border-soft);
    background: var(--color-surface-2);
  }
  .upcoming-card__stage {
    min-height: 320px;
    align-items: center;
    text-align: center;
    padding: var(--space-12) var(--space-6);
    gap: var(--space-3);
  }
  .upcoming-card__title {
    margin: 0;
    padding-bottom: 3rem;
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-heading);
    line-height: var(--leading-tight);
  }
  .upcoming-card__hint {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: 36ch;
    text-wrap: pretty;
  }
  .upcoming-card__links {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }
  .upcoming-card__link {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, currentColor 35%, transparent);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition-fast);
  }
  .upcoming-card__link:hover,
  .upcoming-card__link:focus-visible {
    text-decoration-color: currentColor;
  }
  .upcoming-card__toolbar {
    min-height: 44px;
  }
  @media (max-width: 560px) {
    .upcoming-card__stage {
      min-height: 280px;
      padding: var(--space-8) var(--space-4);
    }
  }

  @media (max-width: 768px) {
    .page {
      padding-inline: calc(var(--space-4) + var(--space-1));
    }

    .skills-header__title {
      margin-bottom: var(--space-2);
    }
  }
  /* Compensa el BackLink fijo (fuera del flujo) en desktop */
  @media (min-width: 1101px) {
    .page {
      padding-top: 6rem;
    }
  }
</style>
