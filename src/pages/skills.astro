---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import BackLink from "../components/ui/BackLink.astro";
import GithubIcon from "../components/icons/GithubIcon.astro";
import CopyCommand from "../components/skills/CopyCommand.astro";
import SkillSection from "../components/skills/SkillSection.astro";
import TypographyDemo from "../components/skills/TypographyDemo.astro";
import I18nSync from "../components/I18nSync.astro";
import { translations } from "../data/translations";

const t = translations.es;
---

<BaseLayout title="Skills — Javier Alzú">
  <I18nSync />
 <main class="page">
    <Section>
      <BackLink />

      <div class="skills-header">
        <h1 class="skills-header__title">Skills</h1>
        <p class="skills-header__intro" data-i18n="skillsPage.subtitle">
          {t.skillsPage.subtitle}
        </p>
      </div>

      <CopyCommand
        command="npx skills add jaalzu/agent-skills"
        githubUrl="https://github.com/jaalzu/agent-skills"
      >
        <GithubIcon slot="github-icon" />
      </CopyCommand>
    </Section>

    <Section>
      <SkillSection
        id="typography"
        title={t.skillsPage.typography.title}
        description={t.skillsPage.typography.description}
        titleKey="skillsPage.typography.title"
        descKey="skillsPage.typography.description"
      >
        <TypographyDemo />
      </SkillSection>

      <SkillSection
        id="accesibility"
        title="Accessibility"
        description="Contraste ≥ 4.5:1, foco visible, semántica y ARIA solo cuando aporta. Validado con teclado y lector de pantalla — próximamente demo interactiva."
        mutedDesc
        mutedFrame
      >
        <div class="skill-block--placeholder">
          <img class="skill-block__icon" src="/skills/accesibility.svg" alt="" width="40" height="40" loading="lazy" />
          <span class="skill-block__placeholder-text">Demo próximamente</span>
        </div>
      </SkillSection>
    </Section>
  </main>
</BaseLayout>

<style>
  .page { max-width: var(--content-max-width); margin-inline: auto; padding-inline: var(--space-4); }

  .skills-header__title {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
         color: var(--color-text-heading);

    text-wrap: balance;
  }


  .skills-header__intro {
    margin: 0;
    max-width: 65ch;
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    text-wrap: pretty;
  }

  .skill-block--placeholder {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 72px;
  }
  .skill-block__icon { width: 40px; height: 40px; flex-shrink: 0; object-fit: contain; filter: invert(1) brightness(0.95); }
  .skill-block__placeholder-text { font-size: var(--text-sm); color: var(--color-text-muted); }

  @media (max-width: 768px) {
    .page {
      padding-inline: calc(var(--space-4) + var(--space-1));
    }

    .skills-header__title { margin-bottom: var(--space-2); }
  }
</style>